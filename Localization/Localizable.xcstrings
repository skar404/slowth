        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 延伸功能設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 扩展设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 延伸功能設定"
          }
        }
      }
    },
    "Screen frames are analyzed entirely on your device and never uploaded. By default nothing is saved; confirmed frames are saved only after explicitly enabling hidden debug capture.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحلّل إطارات الشاشة بالكامل على جهازك ولا تُرفع أبدًا. لا يُحفظ شيء افتراضيًا؛ ولا تُحفظ الإطارات المؤكدة إلا بعد تفعيل التقاط تصحيح الأخطاء المخفي صراحةً."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "صور الشاشة بتتحلل بالكامل على جهازك ومش بتترفع أبدًا. في الوضع الافتراضي مفيش حاجة بتتحفظ؛ الصور المؤكدة بتتحفظ بس لما تشغّل بنفسك خاصية التقاط تصحيح الأخطاء المخفية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры экрана аналізуюцца толькі на вашай прыладзе і нікуды не адпраўляюцца. Прадвызначана нічога не захоўваецца; пацверджаныя кадры захоўваюцца толькі пасля яўнага ўключэння схаванага адладачнага запісу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনের ছবি পুরোপুরি আপনার ডিভাইসেই বিশ্লেষণ করা হয় এবং কখনও আপলোড করা হয় না। সাধারণত কিছু সংরক্ষিত হয় না; লুকানো ডিবাগ ক্যাপচার স্পষ্টভাবে চালু করলেই নিশ্চিত শনাক্তকরণের ছবি সংরক্ষিত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky obrazovky se analyzují výhradně na zařízení a nikdy se neodesílají. Ve výchozím stavu se nic neukládá; potvrzené snímky se uloží jen po výslovném zapnutí skrytého ladicího záznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmbilleder analyseres udelukkende på din enhed og uploades aldrig. Som standard gemmes intet; bekræftede billeder gemmes kun, når skjult fejlfindingsoptagelse udtrykkeligt er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmbilder werden ausschließlich auf deinem Gerät analysiert und nie hochgeladen. Standardmäßig wird nichts gespeichert. Bestätigte Bilder werden nur gespeichert, wenn die versteckte Debug-Aufnahme ausdrücklich aktiviert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen frames are analyzed entirely on your device and never uploaded. By default nothing is saved; confirmed frames are saved only after explicitly enabling hidden debug capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de la pantalla se analizan íntegramente en tu dispositivo y nunca se suben a un servidor. No se guarda nada por defecto; solo se guardan imágenes confirmadas si activas expresamente la captura de depuración oculta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga larawan ng screen ay sinusuri lamang sa iyong device at hindi ina-upload. Walang sine-save bilang default; sine-save lang ang mga kumpirmadong larawan kapag tahasang in-on ang nakatagong debug capture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images de l’écran sont analysées uniquement sur votre appareil et ne sont jamais envoyées. Par défaut, rien n’est enregistré ; les images confirmées ne sont sauvegardées qu’après activation explicite de la capture de débogage masquée."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nazarin hotunan allo a na'urarka kawai, kuma ba a taɓa loda su ba. A asali ba a adana komai; ana adana hotunan da aka tabbatar kawai bayan an kunna ɓoyayyen ɗaukar hotunan gyaran kurakurai da gangan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות המסך מנותחות רק במכשיר שלך ולעולם אינן מועלות. כברירת מחדל דבר אינו נשמר; תמונות שאושרו נשמרות רק לאחר הפעלה מפורשת של הלכידה הנסתרת לאיתור תקלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन की छवियों का विश्लेषण पूरी तरह आपके डिवाइस पर होता है और वे कभी अपलोड नहीं होतीं। डिफ़ॉल्ट रूप से कुछ सहेजा नहीं जाता; पुष्टि की गई छवियाँ केवल छिपा हुआ डीबग कैप्चर जानबूझकर चालू करने पर सहेजी जाती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képkockák elemzése teljes egészében az eszközön történik, és soha nem kerülnek feltöltésre. Alapértelmezés szerint semmi sem mentődik; a megerősített képkockák csak a rejtett hibakeresési rögzítés kifejezett bekapcsolása után mentődnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Էկրանի կադրերն ամբողջությամբ վերլուծվում են ձեր սարքում և երբեք չեն վերբեռնվում։ Լռելյայն ոչինչ չի պահպանվում. հաստատված կադրերը պահվում են միայն թաքնված վրիպազերծման գրանցումը բացահայտ միացնելուց հետո։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bingkai layar dianalisis sepenuhnya di perangkat Anda dan tidak pernah diunggah. Secara default tidak ada yang disimpan; bingkai terkonfirmasi hanya disimpan setelah pengambilan debug tersembunyi diaktifkan secara eksplisit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I fotogrammi vengono analizzati interamente sul dispositivo e mai caricati online. Per impostazione predefinita non viene salvato nulla; i fotogrammi confermati vengono salvati solo attivando esplicitamente l'acquisizione di debug nascosta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の画像は端末内だけで解析され、アップロードされません。通常は何も保存されません。非表示のデバッグキャプチャを明示的に有効にした場合のみ、検出が確定した画像が保存されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეკრანის კადრები მხოლოდ თქვენს მოწყობილობაზე მუშავდება და არასდროს იტვირთება სერვერზე. ჩვეულებრივ არაფერი ინახება; დადასტურებული კადრები მხოლოდ გამართვის ფარული ჩაწერის აშკარად ჩართვის შემდეგ ინახება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран кадрлары тек құрылғыңызда талданады және ешқайда жіберілмейді. Әдепкіде ештеңе сақталмайды; расталған кадрлар жасырын жөндеу жазуын арнайы қосқаннан кейін ғана сақталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 이미지는 기기 안에서만 분석되며 업로드되지 않습니다. 기본적으로 아무것도 저장하지 않습니다. 숨겨진 디버그 캡처를 명시적으로 켠 경우에만 감지가 확정된 이미지를 저장합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран кадрлары түзмөгүңүздө гана талданат жана эч жакка жүктөлбөйт. Демейкиде эч нерсе сакталбайт; ырасталган кадрлар жашырылган мүчүлүштүктөрдү оңдоо жазуусун атайын күйгүзгөндөн кийин гана сакталат."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrano kadrai analizuojami tik jūsų įrenginyje ir niekada nesiunčiami. Pagal numatytąsias nuostatas niekas neišsaugoma; patvirtinti kadrai išsaugomi tik aiškiai įjungus paslėptą derinimo įrašymą."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनच्या प्रतिमांचे विश्लेषण पूर्णपणे तुमच्या डिव्हाइसवर होते; त्या कधीही अपलोड होत नाहीत. पूर्वनियोजितपणे काहीही जतन होत नाही. लपवलेले डीबग कॅप्चर स्पष्टपणे सुरू केल्यावरच पुष्टी झालेल्या प्रतिमा जतन होतात."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रिनका फ्रेमहरू पूरै तपाईंको उपकरणमै विश्लेषण गरिन्छन् र कहिल्यै अपलोड हुँदैनन्। पूर्वनिर्धारित रूपमा केही सुरक्षित हुँदैन; लुकेको डिबग क्याप्चर स्पष्ट रूपमा सक्रिय गरेपछि मात्र पुष्टि भएका फ्रेमहरू सुरक्षित हुन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermbeelden worden volledig op je apparaat geanalyseerd en nooit geüpload. Standaard wordt niets opgeslagen; bevestigde beelden worden alleen bewaard als je de verborgen debugopname expliciet inschakelt."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "سکرین دے فریم پورے دے پورے تہاڈے آلے تے پرکھے جاندے نیں تے کدے اپ لوڈ نئیں ہُندے۔ عام طور تے کجھ محفوظ نئیں ہُندا؛ تصدیق شدہ فریم صرف لُکی ہوئی ڈیبگ کیپچر سہولت جان بوجھ کے چالو کرن توں بعد محفوظ ہُندے نیں۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen frames dey get analysed only for your device; dem no dey upload am. Normally, nothing dey saved. Na only when you deliberately turn on hidden debug capture, confirmed frames go save."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klatki ekranu są analizowane wyłącznie na urządzeniu i nigdy nie są wysyłane. Domyślnie nic nie jest zapisywane; potwierdzone klatki są zapisywane tylko po świadomym włączeniu ukrytego zapisu diagnostycznego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens da tela são analisadas inteiramente no seu dispositivo e nunca são enviadas a um servidor. Nada é salvo por padrão; imagens confirmadas só são salvas após ativar explicitamente a captura de depuração oculta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens do ecrã são analisadas inteiramente no seu dispositivo e nunca são enviadas para um servidor. Por predefinição, nada é guardado; as imagens confirmadas só são guardadas após ativar explicitamente a captura de depuração oculta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrele ecranului sunt analizate integral pe dispozitiv și nu sunt încărcate niciodată. Implicit nu se salvează nimic; cadrele confirmate se salvează doar după activarea explicită a capturii ascunse de depanare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадры экрана анализируются только на вашем устройстве и никуда не отправляются. По умолчанию ничего не сохраняется; подтверждённые кадры сохраняются только после явного включения скрытого режима отладочной записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmbilder analyseras helt på din enhet och laddas aldrig upp. Som standard sparas ingenting; bekräftade bilder sparas bara när dold felsökningsinspelning uttryckligen aktiveras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremu za skrini huchanganuliwa kwenye kifaa chako pekee na hazipakii kamwe. Kwa kawaida hakuna kinachohifadhiwa; fremu zilizothibitishwa huhifadhiwa tu baada ya kuwasha waziwazi unasaji uliofichwa wa utatuzi wa hitilafu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரைப் படங்கள் உங்கள் சாதனத்திலேயே முழுமையாக ஆய்வு செய்யப்படும்; ஒருபோதும் பதிவேற்றப்படாது. இயல்பாக எதுவும் சேமிக்கப்படாது. மறைந்துள்ள பிழைத்திருத்தப் பதிவை நீங்கள் வெளிப்படையாக இயக்கினால் மட்டுமே உறுதிசெய்யப்பட்ட படங்கள் சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్ చిత్రాలు పూర్తిగా మీ పరికరంలోనే విశ్లేషించబడతాయి, ఎప్పుడూ అప్‌లోడ్ కావు. సాధారణంగా ఏదీ సేవ్ కాదు. దాచిన డీబగ్ క్యాప్చర్‌ను మీరు స్పష్టంగా ఆన్ చేసినప్పుడు మాత్రమే నిర్ధారించిన చిత్రాలు సేవ్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพหน้าจอจะถูกวิเคราะห์บนอุปกรณ์ของคุณเท่านั้นและไม่อัปโหลด ตามค่าเริ่มต้นจะไม่บันทึกอะไร ภาพที่ยืนยันแล้วจะถูกบันทึกเมื่อเปิดการจับภาพดีบักที่ซ่อนอยู่โดยเจตนาเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kareleri tamamen cihazınızda analiz edilir ve asla yüklenmez. Varsayılan olarak hiçbir şey kaydedilmez; doğrulanan kareler yalnızca gizli hata ayıklama kaydı açıkça etkinleştirildiğinde kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадри екрана аналізуються лише на вашому пристрої й нікуди не надсилаються. Типово нічого не зберігається; підтверджені кадри зберігаються лише після явного ввімкнення прихованого запису для налагодження."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین کے فریم مکمل طور پر آپ کے آلے پر تجزیہ کیے جاتے ہیں اور کبھی اپ لوڈ نہیں ہوتے۔ پہلے سے کچھ محفوظ نہیں ہوتا؛ تصدیق شدہ فریم صرف چھپی ہوئی ڈیبگ کیپچر خصوصیت واضح طور پر فعال کرنے کے بعد محفوظ ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh màn hình được phân tích hoàn toàn trên thiết bị và không bao giờ được tải lên. Mặc định không lưu gì; ảnh đã xác nhận chỉ được lưu khi bạn chủ động bật tính năng ghi gỡ lỗi ẩn."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面影格完全喺你部裝置分析，絕對唔會上傳。預設唔會儲存任何資料；只有明確開啟隱藏嘅偵錯擷取功能之後，先會儲存確認咗嘅影格。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕画面完全在你的设备上分析，绝不上传。默认不保存任何内容；只有明确启用隐藏的调试截取功能后，才会保存确认检测到目标内容的画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面影格完全在你的裝置上分析，絕不會上傳。預設不會儲存任何資料；只有明確啟用隱藏的偵錯擷取功能後，才會儲存已確認的影格。"
          }
        }
      }
    },
    "Screen recording is active": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الشاشة نشط"
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الشاشة شغّال"
          }
        },
        "be": {
          "stringUnit": {
