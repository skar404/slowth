    "Soft mode works well for audio podcasts. Picture in Picture may still be blocked when screen recording is off.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يناسب الوضع المرن البودكاست الصوتي. قد تظل ميزة صورة داخل صورة محظورة عند إيقاف تسجيل الشاشة."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "الوضع المرن مناسب للبودكاست الصوتي. صورة داخل صورة ممكن تفضل محظورة لما تسجيل الشاشة يكون مقفول."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мяккі рэжым падыходзіць для аўдыяпадкастаў. «Малюнак у малюнку» можа блакіравацца, калі запіс экрана выключаны."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমনীয় মোড অডিও পডকাস্টের জন্য উপযোগী। স্ক্রিন রেকর্ডিং বন্ধ থাকলে পিকচার ইন পিকচার তবুও ব্লক হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mírný režim se hodí pro zvukové podcasty. Obraz v obraze může být blokovaný i při vypnutém nahrávání obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blød tilstand er god til lydpodcasts. Billede i billede kan stadig være blokeret, når skærmoptagelse er slået fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sanfte Modus eignet sich gut für Audio-Podcasts. Bild-in-Bild kann weiterhin blockiert werden, wenn die Bildschirmaufnahme ausgeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft mode works well for audio podcasts. Picture in Picture may still be blocked when screen recording is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo suave funciona bien con podcasts de audio. Imagen dentro de imagen puede seguir bloqueado cuando la grabación de pantalla está desactivada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang banayad na mode ay angkop sa mga audio podcast. Maaaring ma-block pa rin ang Picture in Picture kapag naka-off ang pag-record ng screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode souple convient aux podcasts audio. L’image dans l’image peut rester bloquée lorsque l’enregistrement de l’écran est désactivé."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanayi mai sauƙi ya dace da podcast na odiyo. Hoto cikin Hoto na iya kasancewa a toshe idan an kashe rikodin allo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב גמיש מתאים לפודקאסטים קוליים. תמונה בתוך תמונה עשויה להישאר חסומה כשהקלטת המסך כבויה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम मोड ऑडियो पॉडकास्ट के लिए अच्छा है। स्क्रीन रिकॉर्डिंग बंद होने पर पिक्चर इन पिक्चर फिर भी ब्लॉक हो सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az enyhe mód jól használható hangos podcastokhoz. A Kép a képben mód kikapcsolt képernyőfelvételnél továbbra is blokkolva lehet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեղմ ռեժիմը հարմար է ձայնային փոդքաստների համար։ «Պատկեր պատկերի մեջ» գործառույթը կարող է արգելափակված մնալ, երբ էկրանի ձայնագրումն անջատված է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode fleksibel cocok untuk podcast audio. Gambar dalam Gambar mungkin tetap diblokir saat perekaman layar mati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità flessibile è adatta ai podcast audio. Picture in Picture potrebbe restare bloccato quando la registrazione dello schermo è disattivata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトモードは音声ポッドキャストに適しています。画面収録がオフのときは、ピクチャ・イン・ピクチャがブロックされることがあります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რბილი რეჟიმი აუდიოპოდკასტებისთვის გამოდგება. გამორთული ეკრანის ჩაწერისას „სურათი სურათში“ შეიძლება კვლავ დაიბლოკოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмсақ режим аудиоподкасттарға қолайлы. Экран жазуы өшірулі кезде «Сурет ішіндегі сурет» бұғатталуы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완화 모드는 오디오 팟캐스트에 적합합니다. 화면 기록이 꺼져 있으면 화면 속 화면이 계속 차단될 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жумшак режим аудиоподкасттарга ылайыктуу. Экран жазуусу өчүк болгондо «Сүрөт ичиндеги сүрөт» бөгөттөлүшү мүмкүн."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Švelnusis režimas tinka garso tinklalaidėms. Vaizdas vaizde gali likti blokuojamas, kai ekrano įrašymas išjungtas."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सौम्य मोड ऑडिओ पॉडकास्टसाठी उपयुक्त आहे. स्क्रीन रेकॉर्डिंग बंद असताना पिक्चर इन पिक्चर तरीही ब्लॉक होऊ शकते."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम मोड अडियो पोडकास्टका लागि उपयुक्त छ। स्क्रिन रेकर्डिङ बन्द हुँदा पिक्चर इन पिक्चर अझै रोकिन सक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De soepele modus is geschikt voor audiopodcasts. Beeld in beeld kan geblokkeerd blijven als schermopname uitstaat."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم موڈ آڈیو پوڈکاسٹاں لئی چنگا اے۔ سکرین ریکارڈنگ بند ہووے تے تصویر وچ تصویر فیر وی بلاک ہو سکدی اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft mode dey good for audio podcasts. Picture in Picture fit still dey blocked when screen recording dey off."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łagodny tryb sprawdza się przy podcastach audio. Obraz w obrazie może nadal być blokowany, gdy nagrywanie ekranu jest wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo suave funciona bem para podcasts de áudio. Imagem dentro de Imagem ainda pode ser bloqueado quando a gravação de tela está desativada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo suave funciona bem para podcasts de áudio. Imagem dentro de Imagem ainda pode ser bloqueado quando a gravação de ecrã está desativada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul flexibil este potrivit pentru podcasturi audio. Imagine în imagine poate rămâne blocat când înregistrarea ecranului este oprită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкий режим подходит для аудиоподкастов. «Картинка в картинке» может блокироваться, когда запись экрана выключена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjukt läge passar bra för ljudpoddar. Bild i bild kan fortfarande blockeras när skärminspelningen är avstängd."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali nyepesi inafaa kwa podikasti za sauti. Picha ndani ya Picha inaweza kubaki imezuiwa wakati kurekodi skrini kumezimwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மென்மையான பயன்முறை ஒலி பாட்காஸ்ட்களுக்கு ஏற்றது. திரைப் பதிவு அணைந்திருக்கும்போது படத்தினுள் படம் தொடர்ந்து தடுக்கப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సున్నిత మోడ్ ఆడియో పాడ్‌కాస్ట్‌లకు అనుకూలం. స్క్రీన్ రికార్డింగ్ ఆఫ్‌లో ఉన్నప్పుడు పిక్చర్ ఇన్ పిక్చర్ ఇంకా బ్లాక్ కావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดผ่อนปรนเหมาะกับพอดแคสต์เสียง ภาพซ้อนภาพอาจยังถูกบล็อกเมื่อปิดการบันทึกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esnek mod sesli podcast'ler için uygundur. Ekran kaydı kapalıyken Resim İçinde Resim engellenmeye devam edebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "М’який режим підходить для аудіоподкастів. «Картинка в картинці» може блокуватися, коли запис екрана вимкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم موڈ آڈیو پوڈکاسٹس کے لیے موزوں ہے۔ اسکرین ریکارڈنگ بند ہونے پر تصویر در تصویر پھر بھی بلاک ہو سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ nhẹ phù hợp với podcast âm thanh. Hình trong hình vẫn có thể bị chặn khi tắt ghi màn hình."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "寬鬆模式適合聽聲音 Podcast。熄咗螢幕錄製之後，子母畫面仍然可能被封鎖。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽松模式适合收听音频播客。关闭屏幕录制后，画中画仍可能被屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬鬆模式適合收聽音訊 Podcast。關閉螢幕錄製時，子母畫面仍可能被封鎖。"
          }
        }
      }
    },
    "Something broke. Even for a sloth, this is slow.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خلل. هذا بطيء حتى بالنسبة إلى حيوان الكسلان."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "حاجة باظت. ده بطيء حتى على حيوان الكسلان."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нешта зламалася. Нават для гультая гэта павольна."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু একটা বিগড়েছে। স্লথের জন্যও এটি বেশ ধীর।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Něco se pokazilo. I na lenochoda je to pomalé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt. Selv for et dovendyr er det langsomt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Selbst für ein Faultier ist das langsam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something broke. Even for a sloth, this is slow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo falló. Hasta para un perezoso, esto va lento."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May pumalya. Kahit para sa isang sloth, mabagal ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu. Même pour un paresseux, c’est lent."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wani abu ya lalace. Ko ga dabbar sloth, wannan ya yi jinkiri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש. אפילו בשביל עצלן, זה איטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गड़बड़ हुई। एक स्लॉथ के हिसाब से भी यह धीमा है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami elromlott. Ez még egy lajhárnak is lassú."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչ-որ բան խափանվեց։ Նույնիսկ ծույլ կենդանու համար սա դանդաղ է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang rusak. Bahkan untuk kungkang, ini lambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa si è rotto. È lento perfino per un bradipo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。ナマケモノにしても遅すぎますね。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რაღაც გაფუჭდა. ზარმაცასთვისაც კი ეს ნელია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірдеңе бұзылды. Жалқауаңның өзі мұнша баяу емес."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 생겼습니다. 나무늘보에게도 이건 너무 느리네요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир нерсе бузулду. Жалкоо жаныбар үчүн да бул өтө жай."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kažkas sugedo. Net tinginiui tai lėta."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीतरी बिघडले. स्लॉथच्या मानानेही हे संथ आहे."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "केही बिग्रियो। स्लथका लागि पनि यो ढिलो भयो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Zelfs voor een luiaard is dit traag."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "کجھ خراب ہو گیا۔ سلاتھ لئی وی ایہہ ہولی اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Something don spoil. Even for sloth, this one slow."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś się zepsuło. Nawet jak na leniwca to powoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Até para uma preguiça, isso está lento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo correu mal. Até para uma preguiça, isto está lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva s-a stricat. Chiar și pentru un leneș, e lent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то сломалось. Даже для ленивца это медленно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick sönder. Till och med för en sengångare är det här långsamt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitu kimeharibika. Hii ni polepole hata kwa mnyama sloth."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏதோ தவறாகிவிட்டது. ஒரு சோம்பல் கரடிக்குக்கூட இது மெதுவாகத்தான் இருக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదో తప్పు జరిగింది. స్లాత్‌కు కూడా ఇది చాలా నెమ్మదిగా ఉంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีบางอย่างผิดพลาด แม้แต่สลอธก็ยังว่าช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey bozuldu. Bir tembel hayvan için bile yavaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось зламалося. Навіть для лінивця це повільно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ خراب ہو گیا۔ سلاتھ کے لیے بھی یہ سست ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi xảy ra. Ngay cả với một chú lười, thế này vẫn quá chậm."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "出咗啲問題。就算係樹懶，都嫌太慢。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了一点问题。就连树懒也觉得这太慢了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了點問題。就算是樹懶，這也太慢了。"
          }
        }
      }
    },
