    "A Safari extension that quietly hides infinite‑scroll feeds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ⁦Safari⁩ تخفي موجزات التمرير اللانهائي بهدوء."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ⁦Safari⁩ بتخفي بهدوء الصفحات اللي بتفضل تتمرّر من غير نهاية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пашырэнне Safari, якое непрыкметна хавае бясконцыя стужкі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari এক্সটেনশন যা অবিরাম স্ক্রল করা ফিড নিঃশব্দে লুকিয়ে রাখে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozšíření Safari, které nenápadně skrývá nekonečné kanály příspěvků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Safari-udvidelse, der diskret skjuler endeløse feeds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Safari-Erweiterung, die endlose Feeds unauffällig ausblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Safari extension that quietly hides infinite‑scroll feeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una extensión de Safari que oculta discretamente los feeds de desplazamiento infinito."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang Safari extension na tahimik na nagtatago ng walang katapusang feed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une extension Safari qui masque discrètement les fils à défilement infini."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙarin Safari da ke ɓoye jerin wallafe-wallafe marasa ƙarewa a hankali."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרחבת ⁦Safari⁩ שמסתירה בשקט פידים אינסופיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari एक्सटेंशन जो अंतहीन स्क्रॉल वाले फ़ीड चुपचाप छिपाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-bővítmény, amely csendben elrejti a végtelen hírfolyamokat."
          }
