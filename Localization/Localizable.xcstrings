        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కింది బటన్‌ను తాకితే iOS సెట్టింగ్‌లు తెరుచుకుంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มด้านล่างเพื่อเปิดการตั้งค่า iOS"
