    "Tap the button below — it opens iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر أدناه لفتح إعدادات ⁦iOS⁩."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الزر اللي تحت — هيفتح إعدادات ⁦iOS⁩."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце кнопку ніжэй — адкрыюцца налады iOS."
