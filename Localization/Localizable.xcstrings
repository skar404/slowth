    "We'll fix it soon — come back later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنصلح ذلك قريبًا — عُد لاحقًا."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "هنصلّحه قريب — ارجع بعدين."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Хутка выправім — завітайце пазней."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শীঘ্রই ঠিক করব — পরে আবার আসুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Brzy to opravíme — vraťte se později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi retter det snart — kom tilbage senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir kümmern uns darum. Schau später wieder vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll fix it soon — come back later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo arreglaremos pronto. Vuelve más tarde."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aayusin namin ito sa lalong madaling panahon — bumalik mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons corriger cela. Revenez plus tard."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mu gyara nan ba da jimawa ba — dawo daga baya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתקן את זה בקרוב — כדאי לחזור מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम जल्द ठीक करेंगे — बाद में फिर आएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamarosan javítjuk — nézz vissza később."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շուտով կշտկենք. վերադարձեք ավելի ուշ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segera kami perbaiki — kembali lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolveremo presto: torna più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まもなく修正します。後でもう一度お越しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მალე გამოვასწორებთ — მოგვიანებით დაბრუნდით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жақында түзетеміз — кейінірек оралыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 고치겠습니다. 나중에 다시 찾아 주세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жакында оңдойбуз — кийинчерээк кайрылыңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Netrukus pataisysime — grįžkite vėliau."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही लवकरच दुरुस्त करू — नंतर पुन्हा या."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हामी छिट्टै सच्याउँछौँ — पछि फेरि आउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We lossen het snel op. Kom later terug."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "چھیتی ٹھیک کراں گے — بعد وچ واپس آؤ۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "We go fix am soon — come back later."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wkrótce to naprawimy — wróć później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos corrigir em breve. Volte mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos corrigir em breve. Volte mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom remedia curând — revino mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро исправим — загляните позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fixar det snart — kom tillbaka senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarekebisha hivi karibuni — rudi baadaye."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விரைவில் சரிசெய்வோம் — பிறகு மீண்டும் வரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "త్వరలో సరిచేస్తాం — తర్వాత మళ్లీ రండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะรีบแก้ไข โปรดกลับมาใหม่ภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakında düzelteceğiz; daha sonra tekrar gelin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скоро виправимо — завітайте пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جلد ٹھیک کر دیں گے — بعد میں واپس آئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ sớm sửa lỗi — hãy quay lại sau."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "我哋會盡快修好，遲啲再返嚟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会尽快修复，请稍后再来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會盡快修復，請稍後再回來。"
          }
        }
      }
    },
