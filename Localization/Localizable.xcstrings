    "Toggle Slowth on. iOS may ask for permissions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل ⁦Slowth⁩. قد يطلب ⁦iOS⁩ أذونات."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل ⁦Slowth⁩. ⁦iOS⁩ ممكن يطلب أذونات."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце Slowth. iOS можа запытаць дазволы."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth চালু করুন। iOS অনুমতি চাইতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Slowth. iOS může požádat o oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Slowth til. iOS kan bede om tilladelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Slowth ein. iOS fragt möglicherweise nach Berechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle Slowth on. iOS may ask for permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Slowth. iOS puede pedir permisos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang Slowth. Maaaring humingi ng pahintulot ang iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Slowth. iOS peut demander des autorisations."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna Slowth. iOS na iya neman izini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את ⁦Slowth⁩. ⁦iOS⁩ עשויה לבקש הרשאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth चालू करें। iOS अनुमति माँग सकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be a Slowthot. Az iOS engedélyeket kérhet."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միացրեք Slowth-ը։ iOS-ը կարող է թույլտվություններ խնդրել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Slowth. iOS mungkin meminta izin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Slowth. iOS potrebbe chiedere delle autorizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowthをオンにしてください。iOSからアクセス許可を求められる場合があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ Slowth. iOS-მა შეიძლება ნებართვები მოითხოვოს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth қосыңыз. iOS рұқсат сұрауы мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth를 켜세요. iOS가 권한을 요청할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth күйгүзүңүз. iOS уруксат сурашы мүмкүн."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunkite „Slowth“. „iOS“ gali paprašyti leidimų."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth सुरू करा. iOS परवानग्या मागू शकते."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth सक्रिय गर्नुहोस्। iOS ले अनुमति माग्न सक्छ।"
          }
        },
        "nl": {
