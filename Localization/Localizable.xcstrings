        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge butonul de mai jos pentru a deschide Configurările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ниже — откроются настройки iOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
