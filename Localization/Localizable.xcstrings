    "iOS shows a red recording indicator while monitoring is active. This is required by the system.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض ⁦iOS⁩ مؤشر تسجيل أحمر أثناء المراقبة. هذا مطلب من النظام."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦iOS⁩ بيظهر علامة تسجيل حمرا وقت المراقبة. دي حاجة النظام بيطلبها."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падчас назірання iOS паказвае чырвоны індыкатар запісу. Гэта патрабаванне сістэмы."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নজরদারি চলার সময় iOS লাল রেকর্ডিং চিহ্ন দেখায়। এটি সিস্টেমের বাধ্যতামূলক নিয়ম।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během sledování zobrazuje iOS červený indikátor nahrávání. Systém to vyžaduje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS viser en rød optageindikator under overvågning. Det kræves af systemet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS zeigt während der Überwachung eine rote Aufnahmeanzeige. Das ist vom System vorgeschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows a red recording indicator while monitoring is active. This is required by the system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS muestra un indicador rojo de grabación mientras la supervisión está activa. Es un requisito del sistema."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpapakita ang iOS ng pulang indicator ng pag-record habang aktibo ang pagsubaybay. Kailangan ito ng system."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS affiche un indicateur d’enregistrement rouge pendant la surveillance. Le système l’exige."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS yana nuna jan alamar rikodi yayin sa ido. Tsarin na buƙatar haka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦iOS⁩ מציגה מחוון הקלטה אדום בזמן הניטור. זו דרישת מערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी चालू होने पर iOS लाल रिकॉर्डिंग संकेत दिखाता है। यह सिस्टम की आवश्यकता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS piros felvételjelzőt mutat a figyelés alatt. Ezt a rendszer megköveteli."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դիտարկման ընթացքում iOS-ը ցուցադրում է ձայնագրման կարմիր ցուցիչ։ Սա համակարգի պահանջն է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menampilkan indikator rekaman merah saat pemantauan aktif. Ini diwajibkan oleh sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS mostra un indicatore rosso di registrazione durante il monitoraggio. È richiesto dal sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視中はiOSに赤い収録インジケータが表示されます。これはシステム上必要な表示です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მონიტორინგისას iOS ჩაწერის წითელ ინდიკატორს აჩვენებს. ეს სისტემის მოთხოვნაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бақылау кезінде iOS қызыл жазу индикаторын көрсетеді. Бұл — жүйе талабы."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터링 중에는 iOS에 빨간색 기록 표시가 나타납니다. 이는 시스템에서 요구하는 표시입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Көзөмөл учурунда iOS кызыл жазуу индикаторун көрсөтөт. Бул — системанын талабы."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stebėjimo metu „iOS“ rodo raudoną įrašymo indikatorių. To reikalauja sistema."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "देखरेख सुरू असताना iOS लाल रेकॉर्डिंग चिन्ह दाखवते. प्रणालीसाठी हे आवश्यक आहे."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निगरानी सक्रिय हुँदा iOS ले रातो रेकर्डिङ सूचक देखाउँछ। यो प्रणालीको आवश्यकता हो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS toont een rode opname-indicator tijdens het monitoren. Dit is verplicht vanuit het systeem."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "نگرانی چلن ویلے ⁦iOS⁩ ریکارڈنگ دا لال نشان وکھاندا اے۔ ایہہ سسٹم دی لوڑ اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dey show red recording sign when monitoring dey on. Na wetin the system require."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas monitorowania iOS pokazuje czerwony wskaźnik nagrywania. Jest on wymagany przez system."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mostra um indicador vermelho de gravação enquanto o monitoramento está ativo. Isso é exigido pelo sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS mostra um indicador vermelho de gravação enquanto o monitorização está ativo. Isso é exigido pelo sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS afișează un indicator roșu de înregistrare în timpul monitorizării. Este o cerință a sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время наблюдения iOS показывает красный индикатор записи. Это требование системы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS visar en röd inspelningsindikator när övervakningen är aktiv. Det krävs av systemet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS huonyesha kiashirio chekundu cha kurekodi wakati wa ufuatiliaji. Hili ni hitaji la mfumo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்காணிப்பு இயங்கும்போது iOS சிவப்பு பதிவுக் குறியீட்டைக் காட்டும். இது அமைப்பின் கட்டாயத் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పర్యవేక్షణ నడుస్తున్నప్పుడు iOS ఎరుపు రికార్డింగ్ సూచికను చూపుతుంది. ఇది సిస్టమ్‌కు అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS แสดงสัญลักษณ์บันทึกสีแดงขณะเฝ้าดูเนื้อหา ซึ่งเป็นข้อกำหนดของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme etkinken iOS kırmızı bir kayıt göstergesi gösterir. Bu, sistemin gereğidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час відстеження iOS показує червоний індикатор запису. Це вимога системи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نگرانی کے دوران ⁦iOS⁩ ریکارڈنگ کا سرخ اشارہ دکھاتا ہے۔ یہ نظام کی ضرورت ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hiển thị chỉ báo ghi màu đỏ khi đang giám sát. Đây là yêu cầu của hệ thống."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "監察期間，iOS 會顯示紅色錄製指示燈。呢個係系統要求。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监测期间，iOS 会显示红色录制指示标志。这是系统的要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監控期間，iOS 會顯示紅色錄製指示燈。這是系統的必要要求。"
          }
        }
      }
    }
  },
  "version": "1.0"
