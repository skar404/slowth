    "Apple doesn't allow apps to deep-link directly into the Safari extensions list. Follow the steps below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسمح ⁦Apple⁩ للتطبيقات بفتح قائمة إضافات ⁦Safari⁩ مباشرةً. اتبع الخطوات أدناه."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Apple⁩ مش بتسمح للتطبيقات تفتح قايمة إضافات ⁦Safari⁩ مباشرة. اتبع الخطوات اللي تحت."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не дазваляе праграмам адкрываць спіс пашырэнняў Safari наўпрост. Выканайце крокі ніжэй."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple অ্যাপ থেকে সরাসরি Safari এক্সটেনশনের তালিকা খুলতে দেয় না। নিচের ধাপগুলি অনুসরণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple aplikacím neumožňuje otevřít přímo seznam rozšíření Safari. Postupujte podle kroků níže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tillader ikke, at apps åbner listen over Safari-udvidelser direkte. Følg trinnene nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple erlaubt Apps nicht, die Liste der Safari-Erweiterungen direkt zu öffnen. Folge den Schritten unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple doesn't allow apps to deep-link directly into the Safari extensions list. Follow the steps below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no permite abrir directamente la lista de extensiones de Safari desde una app. Sigue los pasos de abajo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pinapayagan ng Apple ang mga app na direktang buksan ang listahan ng Safari extensions. Sundin ang mga hakbang sa ibaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ne permet pas aux apps d’ouvrir directement la liste des extensions Safari. Suivez les étapes ci-dessous."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ba ya barin manhajoji su buɗe jerin ƙarin Safari kai tsaye. Bi matakan da ke ƙasa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Apple⁩ אינה מאפשרת ליישומים לפתוח ישירות את רשימת הרחבות ⁦Safari⁩. יש לפעול לפי השלבים הבאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ऐप्स को सीधे Safari एक्सटेंशन सूची खोलने की अनुमति नहीं देता। नीचे दिए चरणों का पालन करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple nem engedi, hogy az appok közvetlenül megnyissák a Safari-bővítmények listáját. Kövesd az alábbi lépéseket."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ը հավելվածներին չի թույլատրում անմիջապես բացել Safari-ի ընդլայնումների ցանկը։ Հետևեք ստորև նշված քայլերին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak mengizinkan aplikasi membuka daftar ekstensi Safari secara langsung. Ikuti langkah di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non permette alle app di aprire direttamente l'elenco delle estensioni Safari. Segui i passaggi qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleはアプリからSafariの拡張機能一覧を直接開くことを許可していません。以下の手順に従ってください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple აპებს Safari-ის გაფართოებების სიის პირდაპირ გახსნის უფლებას არ აძლევს. მიჰყევით ქვემოთ მოცემულ ნაბიჯებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple қолданбаларға Safari кеңейтімдерінің тізімін тікелей ашуға рұқсат бермейді. Төмендегі қадамдарды орындаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 앱에서 Safari 확장 프로그램 목록을 바로 여는 것을 허용하지 않습니다. 아래 단계를 따라 주세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple колдонмолорго Safari кеңейтүүлөрүнүн тизмесин түз ачууга уруксат бербейт. Төмөнкү кадамдарды аткарыңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Apple“ neleidžia programoms tiesiogiai atverti „Safari“ plėtinių sąrašo. Atlikite toliau nurodytus veiksmus."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ॲपना थेट Safari एक्सटेंशनची यादी उघडू देत नाही. खालील पायऱ्या वापरा."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ले एपहरूलाई Safari एक्स्टेन्सनको सूची सिधै खोल्न दिँदैन। तलका चरणहरू पालना गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple staat apps niet toe de lijst met Safari-extensies rechtstreeks te openen. Volg de onderstaande stappen."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Apple⁩ ایپاں نوں ⁦Safari⁩ دیاں توسیعاں دی لسٹ سدھی کھولن نئیں دیندا۔ تھلے دِتے قدم چکو۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no allow apps open Safari extensions list directly. Follow the steps below."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nie pozwala aplikacjom otwierać bezpośrednio listy rozszerzeń Safari. Wykonaj poniższe kroki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não permite que apps abram diretamente a lista de extensões do Safari. Siga as etapas abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não permite que apps abram diretamente a lista de extensões do Safari. Siga as etapas abaixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nu permite aplicațiilor să deschidă direct lista extensiilor Safari. Urmează pașii de mai jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не разрешает приложениям открывать список расширений Safari напрямую. Следуйте инструкциям ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tillåter inte att appar öppnar listan över Safari-tillägg direkt. Följ stegen nedan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hairuhusu programu kufungua orodha ya viendelezi vya Safari moja kwa moja. Fuata hatua zilizo hapa chini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari நீட்டிப்புப் பட்டியலை நேரடியாகத் திறக்க Apple செயலிகளை அனுமதிப்பதில்லை. கீழே உள்ள படிகளைப் பின்பற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari ఎక్స్‌టెన్షన్‌ల జాబితాను నేరుగా తెరవడానికి Apple యాప్‌లను అనుమతించదు. కింది దశలను అనుసరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ไม่อนุญาตให้แอปเปิดรายการส่วนขยาย Safari โดยตรง โปรดทำตามขั้นตอนด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple, uygulamaların Safari uzantı listesini doğrudan açmasına izin vermez. Aşağıdaki adımları izleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не дозволяє програмам відкривати список розширень Safari безпосередньо. Виконайте наведені нижче кроки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Apple⁩ ایپس کو ⁦Safari⁩ کی توسیعات کی فہرست براہِ راست کھولنے نہیں دیتا۔ نیچے دیے گئے مراحل پر عمل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không cho phép ứng dụng mở trực tiếp danh sách tiện ích Safari. Hãy làm theo các bước bên dưới."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 唔容許 App 直接開啟 Safari 延伸功能清單。請跟住下面嘅步驟做。"
          }
        },
        "zh-Hans": {
