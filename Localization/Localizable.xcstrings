          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩، ⁦YouTube Shorts⁩، ⁦Instagram⁩ اور ⁦Facebook Reels⁩، اور ⁦X⁩ پر دریافت اور رجحانات بلاک کرتا ہے، جبکہ ہر سائٹ کا باقی حصہ دستیاب رہتا ہے۔"
