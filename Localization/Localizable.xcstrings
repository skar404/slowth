    "Slowth is open source. You can inspect the app and its on-device detection pipeline on GitHub.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩ مفتوح المصدر. يمكنك فحص التطبيق وآلية اكتشاف المحتوى على الجهاز عبر ⁦GitHub⁩."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩ مفتوح المصدر. تقدر تراجع التطبيق وطريقة اكتشاف المحتوى على الجهاز من ⁦GitHub⁩."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth мае адкрыты зыходны код. Код праграмы і працэс выяўлення на прыладзе можна вывучыць на GitHub."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ওপেন সোর্স। GitHub-এ অ্যাপ এবং ডিভাইসে চলা শনাক্তকরণ প্রক্রিয়া দেখতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth má otevřený zdrojový kód. Aplikaci i její detekční proces na zařízení si můžete prohlédnout na GitHubu."
          }
        },
        "da": {
          "stringUnit": {
