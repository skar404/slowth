    "TikTok is replaced with a friendly blocked page. You can opt any site into full block too.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستبدل ⁦TikTok⁩ بصفحة حظر ودودة. يمكنك أيضًا حظر أي موقع آخر بالكامل."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦TikTok⁩ بيتبدل بصفحة حظر لطيفة. تقدر تحظر أي موقع تاني بالكامل كمان."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Замест TikTok з’яўляецца прыязная старонка блакіроўкі. Любы іншы сайт таксама можна заблакіраваць цалкам."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok-এর বদলে একটি সহজ ব্লক পৃষ্ঠা দেখা যায়। অন্য যেকোনো সমর্থিত সাইটও পুরোপুরি ব্লক করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok nahradí přívětivá stránka blokování. Můžete také zcela zablokovat kterýkoli jiný web."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok erstattes af en venlig blokeringsside. Du kan også blokere ethvert andet websted helt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok wird durch eine freundliche Sperrseite ersetzt. Du kannst auch jede andere unterstützte Website vollständig blockieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok is replaced with a friendly blocked page. You can opt any site into full block too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok se sustituye por una página de bloqueo amable. También puedes bloquear por completo cualquiera de los otros sitios."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang magiliw na pahina ng pag-block ang ipinapakita sa halip na TikTok. Puwede mo ring i-block nang buo ang ibang site."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page de blocage accueillante remplace TikTok. Vous pouvez aussi bloquer entièrement les autres sites."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana maye gurbin TikTok da shafin toshewa mai sauƙin fahimta. Za ka iya toshe kowane shafi gaba ɗaya ma."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦TikTok⁩ מוחלף בדף חסימה ידידותי. אפשר גם לחסום כל אתר אחר במלואו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok की जगह एक सरल ब्लॉक पेज दिखता है। आप किसी भी समर्थित साइट को पूरी तरह ब्लॉक कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A TikTok helyett barátságos blokkolóoldal jelenik meg. Bármely más webhelyet is teljesen blokkolhatsz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok-ը փոխարինվում է բարեհամբույր արգելափակման էջով։ Ցանկացած այլ կայք նույնպես կարող եք ամբողջությամբ արգելափակել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok diganti dengan halaman pemblokiran yang ramah. Situs lain juga dapat diblokir sepenuhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok viene sostituito da una pagina di blocco amichevole. Puoi bloccare completamente anche qualsiasi altro sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTokの代わりに穏やかなブロックページを表示します。ほかのサイトも全体をブロックできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok-ს მეგობრული დაბლოკვის გვერდი ანაცვლებს. ასევე შეგიძლიათ ნებისმიერი სხვა საიტი სრულად დაბლოკოთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok орнына бұғаттау беті көрсетіледі. Кез келген басқа сайтты да толық бұғаттауға болады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok 대신 편안한 차단 페이지가 표시됩니다. 다른 지원 사이트도 전체 차단할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok ордуна бөгөттөө барагы көрсөтүлөт. Башка каалаган сайтты да толугу менен бөгөттөөгө болот."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„TikTok“ pakeičiamas draugišku blokavimo puslapiu. Taip pat galite visiškai blokuoti bet kurią kitą svetainę."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok ऐवजी एक साधे ब्लॉक पान दिसते. इतर समर्थित साइटही पूर्णपणे ब्लॉक करता येतात."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok को सट्टा मैत्रीपूर्ण रोकिएको पृष्ठ देखिन्छ। अरू जुनसुकै वेबसाइट पनि पूरै रोक्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok wordt vervangen door een vriendelijke blokkeerpagina. Je kunt ook elke andere website volledig blokkeren."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦TikTok⁩ دی جگہ دوستانہ بلاک صفحہ آ جاندا اے۔ تسی ہور کوئی وی سائٹ پوری بلاک کر سکدے او۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Friendly blocked page go replace TikTok. You fit block any other website completely too."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiast TikToka pojawia się przyjazna strona blokady. Możesz też całkowicie zablokować dowolną inną witrynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TikTok é substituído por uma página de bloqueio amigável. Você também pode bloquear completamente qualquer outro site compatível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O TikTok é substituído por uma página de bloqueio amigável. Também pode bloquear completamente qualquer outro site compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok este înlocuit cu o pagină prietenoasă de blocare. Poți bloca integral și orice alt site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо TikTok показывается страница блокировки. Любой другой сайт тоже можно заблокировать полностью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok ersätts av en vänlig blockeringssida. Du kan även blockera andra webbplatser helt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok hubadilishwa na ukurasa rafiki wa kuzuia. Unaweza kuzuia tovuti nyingine yoyote kabisa pia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok-க்குப் பதிலாக ஒரு எளிய தடுப்புப் பக்கம் காட்டப்படும். மற்ற ஆதரிக்கப்படும் தளங்களையும் முழுமையாகத் தடுக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok బదులుగా ఒక సరళమైన బ్లాక్ పేజీ కనిపిస్తుంది. ఇతర మద్దతు ఉన్న సైట్‌లను కూడా పూర్తిగా బ్లాక్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok จะถูกแทนที่ด้วยหน้าบล็อกที่เป็นมิตร คุณเลือกบล็อกทั้งเว็บไซต์สำหรับเว็บไซต์อื่นได้เช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok yerine dostça bir engelleme sayfası gösterilir. Diğer siteleri de tamamen engelleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замість TikTok з’являється дружня сторінка блокування. Будь-який інший сайт теж можна заблокувати повністю."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦TikTok⁩ کی جگہ دوستانہ بلاک شدہ صفحہ دکھایا جاتا ہے۔ آپ کسی بھی دوسری سائٹ کو بھی مکمل بلاک کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok được thay bằng một trang chặn thân thiện. Bạn cũng có thể chặn hoàn toàn các trang khác."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok 會換成友善嘅封鎖頁面。你亦可以完全封鎖其他網站。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok 会被替换为友好的屏蔽页面。你也可以选择完整屏蔽其他支持的网站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok 會替換成友善的封鎖頁面。你也可以將任何網站設為完全封鎖。"
          }
        }
      }
    },
