{
  "sourceLanguage": "en",
  "strings": {
    "\n\n(Helps me debug — delete if you'd rather not share.)\n%@\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(يساعدني في تصحيح الأخطاء — احذف هذه المعلومات إن كنت لا ترغب في مشاركتها.)\n⁨%@⁩\n⁨%@⁩"
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(بيساعدني أصلّح الأخطاء — امسحه لو مش عايز تشاركه.)\n⁨%@⁩\n⁨%@⁩"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Дапамагае мне з адладкай — выдаліце, калі не хочаце дзяліцца.)\n%@\n%@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(সমস্যা খুঁজতে সাহায্য করে — শেয়ার করতে না চাইলে মুছে দিন।)\n%1$@\n%2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Pomáhá mi s laděním — smažte, pokud nechcete sdílet.)\n%@\n%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Hjælper mig med fejlfinding — slet, hvis du helst ikke vil dele.)\n%@\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Hilft bei der Fehlersuche. Lösche diese Angaben, wenn du sie nicht teilen möchtest.)\n%1$@\n%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Helps me debug — delete if you'd rather not share.)\n%@\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Me ayuda a encontrar errores. Bórralo si prefieres no compartirlo.)\n%1$@\n%2$@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Nakakatulong sa pag-debug — burahin kung ayaw mong ibahagi.)\n%1$@\n%2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Ces informations aident au diagnostic. Supprimez-les si vous préférez ne pas les partager.)\n%1$@\n%2$@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Yana taimaka mini gyara kurakurai — share idan ba ka son rabawa.)\n%@\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(עוזר לי לאתר תקלות — אפשר למחוק אם לא רוצים לשתף.)\n⁨%@⁩\n⁨%@⁩"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(समस्या ढूँढ़ने में मदद करता है — साझा नहीं करना हो तो हटा दें।)\n%1$@\n%2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Segít a hibakeresésben — töröld, ha nem szeretnéd megosztani.)\n%@\n%@"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Օգնում է ինձ վրիպազերծել. ջնջեք, եթե չեք ցանկանում կիսվել։)\n%@\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Membantu saya menelusuri kesalahan — hapus jika tidak ingin membagikan.)\n%@\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Mi aiuta nel debug: elimina se preferisci non condividere.)\n%@\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n（問題の調査に役立ちます。共有したくない場合は削除してください。）\n%1$@\n%2$@"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(მეხმარება გამართვაში — წაშალეთ, თუ გაზიარება არ გსურთ.)\n%@\n%@"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Қателерді түзетуге көмектеседі — бөліскіңіз келмесе, өшіріңіз.)\n%@\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(문제를 찾는 데 도움이 됩니다. 공유하고 싶지 않으면 지워 주세요.)\n%1$@\n%2$@"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Мүчүлүштүктөрдү оңдоого жардам берет — бөлүшкүңүз келбесе, өчүрүңүз.)\n%@\n%@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Padeda man derinti — ištrinkite, jei nenorite dalytis.)\n%@\n%@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(समस्या शोधण्यास मदत होते — शेअर करायचे नसल्यास काढून टाका.)\n%1$@\n%2$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(मलाई त्रुटि सच्याउन मद्दत गर्छ — साझा गर्न नचाहे मेटाउनुहोस्।)\n%@\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Helpt me bij het opsporen van fouten. Verwijder dit als je het liever niet deelt.)\n%@\n%@"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(مینوں خرابی لبھن وچ مدد ملدی اے — سانجھا نئیں کرنا تے مٹا دیو۔)\n⁨%@⁩\n⁨%@⁩"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(E dey help me debug — delete am if you no wan share.)\n%@\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Pomaga mi w diagnostyce — usuń, jeśli wolisz nie udostępniać.)\n%@\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Ajuda a encontrar erros. Apague se preferir não compartilhar.)\n%1$@\n%2$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Ajuda a encontrar erros. Apague se preferir não partilhar.)\n%1$@\n%2$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Mă ajută la depanare — șterge dacă preferi să nu partajezi.)\n%@\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Помогает мне с отладкой — удалите, если не хотите делиться.)\n%@\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Hjälper mig att felsöka — ta bort om du helst inte vill dela.)\n%@\n%@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Hunisaidia kutatua hitilafu — futa ikiwa hutaki kushiriki.)\n%@\n%@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(பிழையைக் கண்டறிய உதவும் — பகிர விரும்பாவிட்டால் நீக்கவும்.)\n%1$@\n%2$@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(లోపాన్ని కనుగొనడానికి సహాయపడుతుంది — పంచుకోవద్దనుకుంటే తీసివేయండి.)\n%1$@\n%2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(ช่วยในการหาข้อผิดพลาด ลบได้หากไม่ต้องการแชร์)\n%1$@\n%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Hata ayıklamama yardımcı olur; paylaşmak istemiyorsanız silin.)\n%@\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Допомагає мені з налагодженням — видаліть, якщо не хочете ділитися.)\n%@\n%@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(مجھے خرابی دور کرنے میں مدد ملتی ہے — شیئر نہیں کرنا چاہتے تو حذف کر دیں۔)\n⁨%@⁩\n⁨%@⁩"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n(Giúp tôi tìm lỗi — hãy xóa nếu bạn không muốn chia sẻ.)\n%1$@\n%2$@"
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n（幫我搵問題用；唔想分享可以刪除。）\n%@\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n（这些信息有助于排查问题；如果不想分享，可以删除。）\n%1$@\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n（有助於我偵錯；如果不想分享，可以刪除。）\n%@\n%@"
          }
        }
      }
    },
