    "Pick a single app, not a whole category or \"All Apps\" — that would block everything.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تطبيقًا واحدًا، وليس فئة كاملة أو «كل التطبيقات» — فهذا سيحظر كل شيء."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "اختار تطبيق واحد، مش فئة كاملة أو «كل التطبيقات» — ده هيحظر كل حاجة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце адну праграму, а не катэгорыю ці «Усе праграмы» — інакш заблакіруецца ўсё."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি অ্যাপ বেছে নিন, পুরো বিভাগ বা “সব অ্যাপ” নয় — তাহলে সবকিছু ব্লক হয়ে যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jednu aplikaci, ne celou kategorii ani „Všechny aplikace“ — tím byste zablokovali vše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg én app, ikke en hel kategori eller »Alle apps« — det ville blokere alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine einzelne App, keine ganze Kategorie und nicht „Alle Apps“ – sonst wird alles blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a single app, not a whole category or \"All Apps\" — that would block everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una sola app, no una categoría completa ni «Todas las apps», ya que eso lo bloquearía todo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng isang app, hindi ng buong kategorya o “Lahat ng App” — maba-block ang lahat kapag iyon ang pinili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une seule app, pas une catégorie entière ni « Toutes les apps », car cela bloquerait tout."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi manhaja guda ɗaya, ba cikakken rukuni ko “Duk Manhajoji” ba — hakan zai toshe komai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור יישום בודד, לא קטגוריה שלמה או ״כל היישומים״ — אחרת הכול ייחסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐप चुनें, पूरी श्रेणी या “सभी ऐप्स” नहीं — वरना सब कुछ ब्लॉक हो जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen appot válassz, ne egész kategóriát vagy az „Összes app” lehetőséget — az mindent blokkolna."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք մեկ հավելված, ոչ թե ամբողջ կատեգորիան կամ «Բոլոր հավելվածները», այլապես ամեն ինչ կարգելափակվի։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu aplikasi, bukan seluruh kategori atau “Semua Aplikasi” — itu akan memblokir semuanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una sola app, non un'intera categoria o «Tutte le app»: bloccheresti tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリ全体や「すべてのアプリ」ではなく、アプリを1つ選んでください。そうしないとすべてがブロックされます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ ერთი აპი და არა მთელი კატეგორია ან „ყველა აპი“ — ეს ყველაფერს დაბლოკავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір қолданбаны таңдаңыз, санатты немесе «Барлық қолданбалар» тармағын емес — әйтпесе бәрі бұғатталады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카테고리 전체나 ‘모든 앱’ 대신 앱 하나를 선택하세요. 그렇지 않으면 모든 앱이 차단됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бир колдонмону тандаңыз, бүт категорияны же «Бардык колдонмолорду» эмес — болбосо баары бөгөттөлөт."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinkitės vieną programą, o ne visą kategoriją ar „Visos programos“ — taip užblokuotumėte viską."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ॲप निवडा, संपूर्ण श्रेणी किंवा “सर्व ॲप” नाही — अन्यथा सर्वकाही ब्लॉक होईल."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एउटा मात्र एप छान्नुहोस्, पूरै वर्ग वा “सबै एपहरू” होइन — त्यसले सबै कुरा रोक्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies één app, geen hele categorie of 'Alle apps': daarmee blokkeer je alles."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "اک ایپ چُنو، پورا زمرہ یا «ساریاں ایپاں» نئیں — اوہ سب کجھ بلاک کر دیوے گا۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose just one app, no be whole category or “All Apps” — that one go block everything."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedną aplikację, a nie całą kategorię ani „Wszystkie aplikacje” — to zablokowałoby wszystko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um único app, não uma categoria inteira nem “Todos os Apps”, pois isso bloquearia tudo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um único app, não uma categoria inteira nem “Todos os apps”, pois isso bloquearia tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o singură aplicație, nu o categorie întreagă sau „Toate aplicațiile” — asta ar bloca totul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одно приложение, а не категорию или «Все приложения» — иначе заблокируется всё."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en enda app, inte en hel kategori eller ”Alla appar” — det skulle blockera allt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua programu moja, si kundi zima au “Programu Zote” — kufanya hivyo kungezuia kila kitu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே ஒரு செயலியைத் தேர்ந்தெடுக்கவும்; முழு வகையையோ “எல்லாச் செயலிகள்” என்பதையோ வேண்டாம் — அது அனைத்தையும் தடுத்துவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకే యాప్‌ను ఎంచుకోండి; మొత్తం వర్గం లేదా “అన్ని యాప్‌లు” కాదు — అలా చేస్తే అన్నీ బ్లాక్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเพียงหนึ่งแอป ไม่ใช่ทั้งหมวดหมู่หรือ “แอปทั้งหมด” เพราะจะบล็อกทุกอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir uygulama seçin; tüm kategori veya “Tüm Uygulamalar” seçimi her şeyi engeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть одну програму, а не категорію чи «Усі програми» — інакше заблокується все."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ایپ منتخب کریں، پورا زمرہ یا «تمام ایپس» نہیں — اس سے سب کچھ بلاک ہو جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một ứng dụng, không chọn cả danh mục hay “Tất cả ứng dụng” — làm vậy sẽ chặn tất cả."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "請揀單一 App，唔好揀成個類別或者「所有 App」，否則會封鎖晒所有嘢。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只选择一个 App，不要选择整个类别或“所有 App”，否则会屏蔽所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇單一 App，不要選整個類別或「所有 App」，否則會封鎖全部內容。"
          }
        }
      }
    },
    "Pick the %@ app icon, not a website.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر رمز تطبيق ⁨%@⁩، وليس موقعًا إلكترونيًا."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "اختار أيقونة تطبيق ⁨%@⁩، مش موقع."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберыце значок праграмы %@, а не сайт."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ অ্যাপের আইকন বেছে নিন, ওয়েবসাইট নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte ikonu aplikace %@, ne web."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg appikonet for %@, ikke et websted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das App-Symbol von %@, keine Website."
          }
