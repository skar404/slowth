    "Strict mode cannot be turned off until it expires": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إيقاف الوضع الصارم قبل انتهاء مدته"
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "مينفعش تقفل الوضع الصارم قبل ما وقته يخلص"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгі рэжым нельга выключыць да заканчэння тэрміну"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেয়াদ শেষ হওয়ার আগে কঠোর মোড বন্ধ করা যায় না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přísný režim nelze vypnout před vypršením doby"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Streng tilstand kan ikke slås fra, før den udløber"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der strenge Modus kann erst nach Ablauf deaktiviert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict mode cannot be turned off until it expires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo estricto no se puede desactivar antes de que termine"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maaaring i-off ang mahigpit na mode hangga’t hindi ito natatapos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode strict ne peut pas être désactivé avant son expiration"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya kashe yanayi mai tsauri ba har lokacinsa ya ƙare"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לכבות מצב קפדני לפני שזמנו מסתיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सख्त मोड की अवधि खत्म होने से पहले उसे बंद नहीं किया जा सकता"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szigorú mód nem kapcsolható ki a lejárata előtt"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խիստ ռեժիմը հնարավոր չէ անջատել մինչև ժամկետի ավարտը"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode ketat tidak dapat dimatikan sebelum waktunya berakhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità rigorosa non può essere disattivata prima della scadenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格モードは期限が切れるまで解除できません"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მკაცრი რეჟიმის გამორთვა ვადის გასვლამდე შეუძლებელია"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қатаң режимді мерзімі аяқталғанша өшіру мүмкін емес"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄격 모드는 시간이 끝나기 전에는 끌 수 없습니다"
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Катуу режимди мөөнөтү бүтмөйүнчө өчүрүүгө болбойт"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Griežtojo režimo negalima išjungti, kol nesibaigė jo laikas"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मुदत संपण्यापूर्वी कडक मोड बंद करता येत नाही"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "समय नसकिएसम्म कडा मोड बन्द गर्न सकिँदैन"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De strikte modus kan niet worden uitgeschakeld voordat deze afloopt"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ویلا مُکّن توں پہلاں سخت موڈ بند نئیں ہو سکدا"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "You no fit turn off Strict mode until e expire"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trybu ścisłego nie można wyłączyć przed upływem czasu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo estrito não pode ser desativado antes de terminar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo estrito não pode ser desativado antes de terminar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul strict nu poate fi oprit înainte de expirare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строгий режим нельзя отключить до истечения срока"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strikt läge kan inte stängas av innan tiden löper ut"
