            "value": "购买失败，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買失敗，請再試一次。"
          }
        }
      }
    },
    "Purchase is pending approval (e.g. Ask to Buy).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية الشراء بانتظار الموافقة (مثل طلب الشراء)."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء مستني الموافقة (زي طلب الشراء)."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Купля чакае ўхвалення (напрыклад, праз «Папрасіць купіць»)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনাকাটা অনুমোদনের অপেক্ষায় আছে (যেমন কেনার অনুরোধ)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čeká na schválení (např. přes Schvalování nákupů)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet afventer godkendelse (f.eks. Spørg før køb)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung (z. B. über „Kaufanfrage“)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase is pending approval (e.g. Ask to Buy)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación (por ejemplo, Solicitar la compra)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghihintay ng pag-apruba ang pagbili (halimbawa, Ask to Buy)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat est en attente d’autorisation (par exemple via Demander l’autorisation d’achat)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayen yana jiran amincewa (misali, Neman Izinin Saya)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה ממתינה לאישור (למשל באמצעות בקשת אישור לרכישה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद मंज़ूरी का इंतज़ार कर रही है (जैसे खरीदने का अनुरोध)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás jóváhagyásra vár (például az Engedély a vásárláshoz funkcióval)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնումը սպասում է հաստատման (օրինակ՝ «Գնելու հարցում» գործառույթով)։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian menunggu persetujuan (misalnya Minta Izin Pembelian)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione (ad esempio con Chiedi di acquistare)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです（「承認と購入のリクエスト」など）。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეძენა დამტკიცებას ელოდება (მაგალითად, „შეძენის მოთხოვნის“ მეშვეობით)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алу мақұлдауды күтуде (мысалы, «Сатып алуға сұрау» арқылы)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 승인을 기다리고 있습니다(예: 구입 요청)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Сатып алуу жактырууну күтүп жатат (мисалы, «Сатып алууга суроо» аркылуу)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirkinys laukia patvirtinimo (pvz., per „Prašyti pirkti“)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खरेदी मंजुरीच्या प्रतीक्षेत आहे (उदा. खरेदीची विनंती)."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खरिद स्वीकृतिको प्रतीक्षामा छ (जस्तै, खरिद अनुमति माग्ने सुविधा)।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop wacht op goedkeuring (bijvoorbeeld via 'Vraag om te kopen')."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری منظوری اُڈیک رہی اے (مثلاً خریدن دی اجازت منگن راہیں)۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase dey wait for approval (like Ask to Buy)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup oczekuje na zatwierdzenie (np. przez funkcję Poproś o zakup)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação (por exemplo, Pedir para Comprar)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está a aguardar aprovação (por exemplo, Pedir para comprar)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția așteaptă aprobarea (de exemplu, prin Solicitare de cumpărare)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения (например, через «Попросить купить»)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet väntar på godkännande (t.ex. Be om köp)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ununuzi unasubiri idhini (kwa mfano, Omba Kununua)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாங்குதல் ஒப்புதலுக்காகக் காத்திருக்கிறது (எ.கா. வாங்க அனுமதி கேட்பது)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనుగోలు అనుమతి కోసం వేచి ఉంది (ఉదా. కొనుగోలుకు అనుమతి అడగడం)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซื้อกำลังรออนุมัติ (เช่น ขออนุญาตซื้อ)"
          }
        },
        "tr": {
          "stringUnit": {
