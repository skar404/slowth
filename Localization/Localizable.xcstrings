          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка очікує на схвалення (наприклад, через «Просити купити»)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریداری منظوری کی منتظر ہے (مثلاً خریداری کی اجازت مانگنے کے ذریعے)۔"
