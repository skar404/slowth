          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa kitufe hapa chini ili kufungua Mipangilio ya iOS."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீழே உள்ள பொத்தானைத் தொட்டால் iOS அமைப்புகள் திறக்கும்."
          }
