        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth → Уруксаттар → Бардык веб-сайттар → Уруксат берүү бөлүмдөрүн басыңыз. Ансыз кеңейтүү Shorts видеолорун жашыра албайт."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palieskite Slowth → Leidimai → Visos svetainės → Leisti. Be šio leidimo plėtinys negalės slėpti „Shorts“."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth → परवानग्या → सर्व वेबसाइट → परवानगी द्या येथे टॅप करा. याशिवाय एक्सटेंशन Shorts लपवू शकत नाही."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth → अनुमतिहरू → सबै वेबसाइटहरू → अनुमति दिनुहोस्मा ट्याप गर्नुहोस्। यसबिना एक्स्टेन्सनले Shorts लुकाउन सक्दैन।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Slowth → Toegang → Alle websites → Sta toe. Zonder deze toestemming kan de extensie Shorts niet verbergen."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩ ← اجازتاں ← ساریاں ویب سائٹاں ← اجازت دیو تے ٹیپ کرو۔ ایس توں بغیر توسیع ⁦Shorts⁩ نئیں لُکا سکدی۔"
          }
