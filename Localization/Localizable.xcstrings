        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk poniżej, aby otworzyć Ustawienia iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão abaixo para abrir os Ajustes do iOS."
          }
        },
        "pt-PT": {
