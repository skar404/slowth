    "Enable YouTube Shorts blocking before enabling soft blocking.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل حظر ⁦YouTube Shorts⁩ قبل تفعيل الحظر المرن."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل حظر ⁦YouTube Shorts⁩ قبل ما تشغّل الحظر المرن."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце блакіроўку YouTube Shorts перад уключэннем мяккай блакіроўкі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমনীয় ব্লকিং চালু করার আগে YouTube Shorts ব্লক করা চালু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zapnutím mírného blokování zapněte blokování YouTube Shorts."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå blokering af YouTube Shorts til, før du aktiverer blød blokering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst das Blockieren von YouTube Shorts, bevor du den sanften Modus einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable YouTube Shorts blocking before enabling soft blocking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el bloqueo de YouTube Shorts antes de activar el bloqueo suave."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on muna ang pag-block ng YouTube Shorts bago ang banayad na pag-block."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le blocage des Shorts YouTube avant le blocage souple."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna toshewar YouTube Shorts kafin kunna toshewa mai sauƙi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל חסימת ⁦YouTube Shorts⁩ לפני הפעלת חסימה גמישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नरम ब्लॉकिंग चालू करने से पहले YouTube Shorts ब्लॉकिंग चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az enyhe blokkolás előtt kapcsold be a YouTube Shorts blokkolását."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեղմ արգելափակումը միացնելուց առաջ միացրեք YouTube Shorts-ի արգելափակումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan pemblokiran YouTube Shorts sebelum mengaktifkan pemblokiran fleksibel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il blocco di YouTube Shorts prima di attivare il blocco flessibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトモードを有効にする前に、YouTube Shortsのブロックを有効にしてください。"
