    "If Slowth blocked the wrong screen, missed blocked content, or setup didn’t work, tell me what happened.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا حظر ⁦Slowth⁩ شاشة خاطئة أو فاته محتوى محظور أو لم ينجح الإعداد، فأخبرني بما حدث."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "لو ⁦Slowth⁩ حظر شاشة غلط، أو فوّت محتوى كان المفروض يتحظر، أو الإعداد مشتغلش، قولي إيه اللي حصل."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі Slowth заблакіраваў не той экран, прапусціў змесціва або наладжванне не ўдалося, раскажыце, што здарылася."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ভুল স্ক্রিন ব্লক করলে, কনটেন্ট ব্লক করতে না পারলে বা সেটআপ কাজ না করলে কী ঘটেছে জানান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud Slowth zablokoval nesprávnou obrazovku, přehlédl blokovaný obsah nebo se nastavení nezdařilo, napište mi, co se stalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis Slowth blokerede den forkerte skærm, overså indhold, eller opsætningen ikke virkede, så fortæl mig, hvad der skete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Slowth den falschen Bildschirm blockiert, Inhalte übersieht oder die Einrichtung nicht klappt, erzähl mir, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Slowth blocked the wrong screen, missed blocked content, or setup didn’t work, tell me what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Slowth bloqueó una pantalla equivocada, no detectó contenido bloqueado o la configuración falló, cuéntame qué pasó."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung maling screen ang na-block ng Slowth, may content na hindi nito na-block, o hindi gumana ang pag-setup, ikuwento kung ano ang nangyari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Slowth a bloqué le mauvais écran, manqué du contenu à bloquer ou si la configuration a échoué, dites-moi ce qui s’est passé."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Idan Slowth ya toshe allon da bai dace ba, ya bar abun cikin da ya kamata ya toshe, ko saitawa ba ta yi aiki ba, gaya mini abin da ya faru."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם ⁦Slowth⁩ חסם מסך שגוי, פספס תוכן לחסימה או שההגדרה לא עבדה, אפשר לספר לי מה קרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर Slowth ने गलत स्क्रीन ब्लॉक की, सामग्री छूट गई या सेटअप नहीं हुआ, तो बताएँ कि क्या हुआ था।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a Slowth rossz képernyőt blokkolt, nem vett észre blokkolandó tartalmat, vagy a beállítás nem működött, írd meg, mi történt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Եթե Slowth-ը սխալ էկրան է արգելափակել, բաց է թողել բովանդակություն կամ կարգավորումը չի աշխատել, պատմեք՝ ինչ է պատահել։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Slowth memblokir layar yang salah, melewatkan konten, atau pengaturan tidak berhasil, ceritakan apa yang terjadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Slowth ha bloccato la schermata sbagliata, non ha rilevato contenuti da bloccare o la configurazione non ha funzionato, raccontami cosa è successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違った画面がブロックされた、対象のコンテンツが見逃された、設定がうまくいかなかった場合は、何が起きたか教えてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თუ Slowth-მა არასწორი ეკრანი დაბლოკა, კონტენტი გამოტოვა ან დაყენება ვერ მოხერხდა, მომწერეთ, რა მოხდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth қате экранды бұғаттаса, мазмұнды өткізіп алса немесе баптау жұмыс істемесе, не болғанын айтыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth가 잘못된 화면을 차단했거나 차단 대상 콘텐츠를 놓쳤거나 설정이 잘되지 않았다면 어떤 일이 있었는지 알려 주세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth туура эмес экранды бөгөттөсө, мазмунду өткөрүп жиберсе же жөндөө иштебесе, эмне болгонун айтып бериңиз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei „Slowth“ užblokavo netinkamą ekraną, praleido blokuojamą turinį arba sąranka nepavyko, papasakokite, kas nutiko."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ने चुकीची स्क्रीन ब्लॉक केली, सामग्री ब्लॉक झाली नाही किंवा सेटअप चालला नाही, तर काय झाले ते कळवा."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ले गलत स्क्रिन रोक्यो, रोक्नुपर्ने सामग्री छुटायो वा सेटअपले काम गरेन भने के भयो मलाई बताउनुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft Slowth het verkeerde scherm geblokkeerd, inhoud gemist of werkte de configuratie niet? Vertel me wat er gebeurde."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "جے ⁦Slowth⁩ نے غلط سکرین بلاک کیتی، مواد چھڈ دِتا یا سیٹ اپ نے کم نئیں کیتا، مینوں دَسو کی ہویا۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "If Slowth block wrong screen, miss content wey e suppose block, or setup no work, tell me wetin happen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Slowth zablokował niewłaściwy ekran, przepuścił blokowane treści lub konfiguracja się nie udała, opisz, co się stało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Slowth bloqueou a tela errada, deixou passar conteúdo bloqueado ou a configuração não funcionou, conte o que aconteceu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Slowth bloqueou o ecrã errado, deixou passar conteúdo bloqueado ou a configuração não funcionou, conte o que aconteceu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă Slowth a blocat ecranul greșit, a omis conținut de blocat sau configurarea nu a funcționat, spune-mi ce s-a întâmplat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если Slowth заблокировал не тот экран, пропустил контент или настройка не удалась, расскажите, что произошло."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Slowth blockerade fel vy, missade innehåll eller inställningen inte fungerade, berätta vad som hände."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa Slowth ilizuia skrini isiyofaa, ilikosa maudhui ya kuzuia au usanidi haukufanya kazi, niambie kilichotokea."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth தவறான திரையைத் தடுத்தாலோ, உள்ளடக்கத்தைத் தவறவிட்டாலோ, அமைப்பு வேலை செய்யாவிட்டாலோ என்ன நடந்தது என்று தெரிவிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth తప్పు స్క్రీన్‌ను బ్లాక్ చేసినా, కంటెంట్‌ను గుర్తించకపోయినా లేదా సెటప్ పనిచేయకపోయినా ఏం జరిగిందో తెలియజేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาก Slowth บล็อกผิดหน้าจอ พลาดเนื้อหาที่ควรบล็อก หรือตั้งค่าไม่สำเร็จ โปรดบอกว่าเกิดอะไรขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth yanlış ekranı engellediyse, içeriği kaçırdıysa veya kurulum çalışmadıysa ne olduğunu bana anlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо Slowth заблокував не той екран, пропустив вміст або налаштування не вдалося, розкажіть, що сталося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر ⁦Slowth⁩ نے غلط اسکرین بلاک کی، مواد چھوڑ دیا یا سیٹ اپ کام نہیں کر سکا تو مجھے بتائیں کیا ہوا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu Slowth chặn nhầm màn hình, bỏ sót nội dung cần chặn hoặc thiết lập không thành công, hãy cho tôi biết điều gì đã xảy ra."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Slowth 封鎖錯畫面、漏咗應該封鎖嘅內容，或者設定唔成功，請話畀我知發生咗咩事。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Slowth 屏蔽了错误的界面、漏掉了应屏蔽的内容，或设置未成功，请告诉我发生了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Slowth 封鎖了錯誤畫面、漏掉應封鎖的內容，或設定無法完成，請告訴我發生了什麼事。"
          }
        }
      }
    },
    "Infinite Feed limits scrolling. On Instagram it also includes Explore and Stories.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحد من التمرير اللانهائي. في Instagram يشمل أيضًا الاستكشاف والقصص."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "بيحد من السكرول اللانهائي. على Instagram بيشمل كمان الاستكشاف والستوريز."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абмяжоўвае бясконцую пракрутку. У Instagram таксама ахоплівае Explore і Stories."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্তহীন ফিড স্ক্রল করা সীমিত করে। Instagram-এ Explore ও Stories-ও অন্তর্ভুক্ত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezuje nekonečné posouvání. Na Instagramu zahrnuje také Prozkoumat a Příběhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrænser uendelig rulning. På Instagram omfatter det også Udforsk og Stories."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt endloses Scrollen. Auf Instagram sind auch Explore und Stories enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Infinite Feed limits scrolling. On Instagram it also includes Explore and Stories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el desplazamiento infinito. En Instagram también incluye Explorar e Historias."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nililimitahan ang pag-scroll. Sa Instagram, kasama rin ang Explore at Stories."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite le défilement infini. Sur Instagram, cela inclut aussi Explorer et les stories."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana iyakance gungurawa marar ƙarewa. A Instagram ya haɗa da Explore da Stories."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגביל גלילה אינסופית. ב-Instagram כולל גם גילוי וסטוריז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनंत फ़ीड स्क्रॉलिंग सीमित करती है। Instagram पर इसमें Explore और Stories भी शामिल हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátozza a végtelen görgetést. Az Instagramon a Felfedezés és a Történetek is ide tartoznak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սահմանափակում է անվերջ ոլորումը։ Instagram-ում ներառում է նաև Explore-ը և Stories-ը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatasi gulir tanpa akhir. Di Instagram juga mencakup Jelajahi dan Cerita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita lo scorrimento infinito. Su Instagram include anche Esplora e le Storie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無限スクロールを制限します。Instagramでは発見とストーリーズも含まれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზღუდავს უსასრულო გადახვევას. Instagram-ზე ასევე მოიცავს Explore-სა და Stories-ს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шексіз айналдыруды шектейді. Instagram-да Explore және Stories де қамтылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무한 스크롤을 제한합니다. Instagram에서는 탐색과 스토리도 포함됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Чексиз сыдырууну чектейт. Instagram'да Explore жана Stories да камтылат."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Riboja begalinį slinkimą. Instagram taip pat apima Explore ir Stories."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अमर्याद फीड स्क्रोल करणे मर्यादित करते. Instagram वर Explore आणि Stories देखील समाविष्ट आहेत."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनन्त स्क्रोलिङ सीमित गर्छ। Instagram मा Explore र Stories पनि समावेश छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt eindeloos scrollen. Op Instagram vallen ook Ontdekken en Verhalen hieronder."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "بے انت سکرولنگ نوں محدود کردا اے۔ Instagram اُتے Explore تے Stories وی شامل نیں۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E dey limit scrolling. For Instagram, e include Explore and Stories too."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicza nieskończone przewijanie. Na Instagramie obejmuje także Eksploruj i Relacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita a rolagem infinita. No Instagram, também inclui Explorar e Stories."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita o deslocamento infinito. No Instagram, também inclui Explorar e Stories."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează derularea infinită. Pe Instagram include și Explorează și Povești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Infinite Feed ограничивает прокрутку. В Instagram также включает Explore и Stories."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsar oändlig rullning. På Instagram ingår även Utforska och Stories."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hupunguza kusogeza bila mwisho. Kwenye Instagram pia inajumuisha Explore na Stories."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊட்டத்தில் உருட்டுவதைக் கட்டுப்படுத்தும். Instagram இல் Explore மற்றும் Stories ஆகியவையும் அடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫీడ్ స్క్రోలింగ్‌ను పరిమితం చేస్తుంది. Instagramలో Explore మరియు Stories కూడా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำกัดการเลื่อนฟีดไม่รู้จบ ใน Instagram รวมถึง Explore และ Stories ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuz kaydırmayı sınırlar. Instagram'da Keşfet ve Hikâyeler de dahildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежує нескінченне прокручування. В Instagram також охоплює Explore та Stories."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لامحدود اسکرولنگ محدود کرتا ہے۔ Instagram پر Explore اور Stories بھی شامل ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn cuộn bảng tin. Trên Instagram, bao gồm cả Khám phá và Tin."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "限制無限捲動。喺 Instagram 仲包括探索同限時動態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制无限滚动。在 Instagram 上还包括探索和快拍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "限制無限捲動。在 Instagram 上也包含探索和限時動態。"
          }
        }
      }
    },
