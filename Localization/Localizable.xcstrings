          "stringUnit": {
            "state": "translated",
            "value": "Reels ब्लॉक करणे सुरू करण्यापूर्वी Instagram ॲप निवडा."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels रोक्ने सुविधा खोल्नुअघि Instagram एप छान्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de Instagram-app voordat je Reels blokkeert."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Reels⁩ دی بلاکنگ چالو کرن توں پہلاں ⁦Instagram⁩ ایپ چُنو۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Instagram app before you turn on Reels blocking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację Instagram, zanim włączysz blokowanie Reels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o app do Instagram antes de ativar o bloqueio de Reels."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o app do Instagram antes de ativar o bloqueio de Reels."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege aplicația Instagram înainte de a activa blocarea Reels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение Instagram, прежде чем включать блокировку Reels."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Instagram-appen innan du aktiverar blockering av Reels."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua programu ya Instagram kabla ya kuwasha uzuiaji wa Reels."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels தடுப்பை இயக்கும் முன் Instagram செயலியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels బ్లాకింగ్‌ను ఆన్ చేసే ముందు Instagram యాప్‌ను ఎంచుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแอป Instagram ก่อนเปิดการบล็อก Reels"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reels engellemesini açmadan önce Instagram uygulamasını seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть програму Instagram, перш ніж увімкнути блокування Reels."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Reels⁩ کی بلاکنگ فعال کرنے سے پہلے ⁦Instagram⁩ ایپ منتخب کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ứng dụng Instagram trước khi bật chặn Reels."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "請先揀 Instagram App，再開啟 Reels 封鎖。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择 Instagram App，再启用 Reels 屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇 Instagram App，再啟用 Reels 封鎖。"
          }
        }
      }
    },
