          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel eerst YouTube Shorts-blokkering in voordat je soepel blokkeren inschakelt."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "نرم بلاکنگ چالو کرن توں پہلاں ⁦YouTube Shorts⁩ دی بلاکنگ چالو کرو۔"
