        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth → Permissions → All Websites → Allow. Without this one, the extension no fit hide Shorts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Slowth → Uprawnienia → Wszystkie witryny → Pozwól. Bez tego rozszerzenie nie może ukrywać Shorts."
