    "Slowth blocks YouTube Shorts, Instagram and Facebook Reels, plus Explore and trends on X while leaving the rest of each site available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحظر ⁦Slowth⁩ مقاطع ⁦YouTube Shorts⁩ و⁦Instagram⁩ و⁦Facebook Reels⁩، إضافة إلى الاستكشاف والمواضيع الرائجة على ⁦X⁩، مع إبقاء بقية كل موقع متاحة."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩ بيحظر ⁦YouTube Shorts⁩ و⁦Instagram⁩ و⁦Facebook Reels⁩، وكمان الاستكشاف والتريندات على ⁦X⁩، وبيسيب باقي كل موقع متاح."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth блакіруе YouTube Shorts, Instagram і Facebook Reels, а таксама «Агляд» і трэнды ў X, захоўваючы доступ да астатніх частак сайтаў."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth YouTube Shorts, Instagram ও Facebook Reels এবং X-এর এক্সপ্লোর ও ট্রেন্ড ব্লক করে। প্রতিটি সাইটের বাকি অংশ ব্যবহার করা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blokuje YouTube Shorts, Instagram a Facebook Reels i Prozkoumat a trendy na X. Zbytek každého webu zůstává dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blokerer YouTube Shorts, Instagram og Facebook Reels samt Udforsk og trends på X, mens resten af hvert websted forbliver tilgængeligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blockiert YouTube Shorts, Instagram und Facebook Reels sowie Entdecken und Trends auf X. Der Rest jeder Website bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blocks YouTube Shorts, Instagram and Facebook Reels, plus Explore and trends on X while leaving the rest of each site available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth bloquea YouTube Shorts, Instagram y Facebook Reels, además de Explorar y tendencias en X, y deja disponible el resto de cada sitio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bina-block ng Slowth ang YouTube Shorts, Instagram at Facebook Reels, at Explore at mga trend sa X habang magagamit pa rin ang ibang bahagi ng bawat site."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth bloque les Shorts YouTube, les Reels Instagram et Facebook, ainsi qu’Explorer et les tendances sur X, tout en laissant le reste de chaque site accessible."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth yana toshe YouTube Shorts, Instagram da Facebook Reels, da Bincike da abubuwan da ke tashe a X, tare da barin sauran sassan kowane shafi a buɗe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩ חוסם ⁦YouTube Shorts⁩, ⁦Instagram⁩ ו־⁦Facebook Reels⁩, וגם גילוי וטרנדים ב־⁦X⁩, ומשאיר את שאר האתר זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth YouTube Shorts, Instagram और Facebook Reels तथा X पर एक्सप्लोर और ट्रेंड ब्लॉक करता है। हर साइट का बाकी हिस्सा उपलब्ध रहता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Slowth blokkolja a YouTube Shorts, az Instagram és Facebook Reels, valamint az X Felfedezés és trendek tartalmait, miközben a webhelyek többi része elérhető marad."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth-ն արգելափակում է YouTube Shorts-ը, Instagram և Facebook Reels-ը, ինչպես նաև X-ի Բացահայտումն ու թրենդները՝ հասանելի թողնելով կայքերի մնացած մասերը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth memblokir YouTube Shorts, Instagram dan Facebook Reels, serta Jelajahi dan tren di X, sambil membiarkan bagian situs lainnya tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blocca YouTube Shorts, Instagram e Facebook Reels, oltre a Esplora e tendenze su X, lasciando disponibile il resto di ogni sito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SlowthはYouTube Shorts、InstagramとFacebookのReels、Xの話題を検索とトレンドをブロックし、サイトのほかの部分はそのまま使えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ბლოკავს YouTube Shorts-ს, Instagram და Facebook Reels-ს, ასევე X-ის აღმოჩენასა და ტრენდებს, ხოლო საიტების დანარჩენი ნაწილი ხელმისაწვდომი რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth YouTube Shorts, Instagram мен Facebook Reels, сондай-ақ X ішіндегі Шолу мен трендтерді бұғаттап, сайттардың қалған бөлігін қолжетімді қалдырады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth는 YouTube Shorts, Instagram과 Facebook의 Reels, X의 탐색과 트렌드를 차단하고 각 사이트의 나머지 부분은 그대로 사용할 수 있게 합니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth YouTube Shorts, Instagram жана Facebook Reels, ошондой эле X ичиндеги Изилдөө жана тренддерди бөгөттөп, сайттардын калган бөлүгүн жеткиликтүү калтырат."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Slowth“ blokuoja „YouTube Shorts“, „Instagram“ ir „Facebook Reels“, taip pat „X“ naršymo skiltį ir tendencijas, palikdama likusią svetainių dalį pasiekiamą."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth YouTube Shorts, Instagram व Facebook Reels आणि X वरील एक्सप्लोर व ट्रेंड ब्लॉक करते. प्रत्येक साइटचा उर्वरित भाग वापरता येतो."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ले YouTube Shorts, Instagram र Facebook Reels, साथै X को अन्वेषण र ट्रेन्डहरू रोक्छ, तर हरेक वेबसाइटको बाँकी भाग खुला राख्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth blokkeert YouTube Shorts, Instagram- en Facebook-Reels en Verkennen en trends op X. De rest van elke website blijft beschikbaar."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Slowth⁩، ⁦YouTube Shorts⁩، ⁦Instagram⁩ تے ⁦Facebook Reels⁩، نالے ⁦X⁩ تے کھوج تے رجحان بلاک کردا اے، جدکہ ہر سائٹ دا باقی حصہ کھلا رہندا اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth dey block YouTube Shorts, Instagram and Facebook Reels, plus Explore and trends for X, while the rest of each website still dey available."
          }
