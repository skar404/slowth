        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o bloqueio de YouTube Shorts antes de ativar o bloqueio suave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
