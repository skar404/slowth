    "Scroll the apps list, tap Safari, then Extensions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر قائمة التطبيقات، واضغط على ⁦Safari⁩ ثم الإضافات."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر قايمة التطبيقات، واضغط على ⁦Safari⁩ وبعدين الإضافات."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прагартайце спіс праграм, націсніце Safari, потым «Пашырэнні»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের তালিকা স্ক্রল করে Safari-তে, তারপর এক্সটেনশনে ট্যাপ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte seznam aplikací, klepněte na Safari a poté na Rozšíření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rul gennem applisten, tryk på Safari og derefter på Udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle durch die App-Liste, tippe auf Safari und dann auf Erweiterungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll the apps list, tap Safari, then Extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate por la lista de apps, toca Safari y luego Extensiones."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-scroll sa listahan ng mga app, i-tap ang Safari, at pagkatapos ang Extensions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la liste des apps, touchez Safari, puis Extensions."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gungura jerin manhajoji, taɓa Safari, sannan Ƙari."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לגלול ברשימת היישומים, להקיש על ⁦Safari⁩ ואז על הרחבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सूची में स्क्रॉल करें, Safari पर टैप करें, फिर एक्सटेंशन पर।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Görgess az appok listájában, koppints a Safarira, majd a Bővítményekre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոլորեք հավելվածների ցանկը, հպեք Safari-ին, ապա՝ Ընդլայնումներին։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir daftar aplikasi, ketuk Safari, lalu Ekstensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri l'elenco delle app, tocca Safari, poi Estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ一覧をスクロールしてSafariをタップし、拡張機能を開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაახვიეთ აპების სიას, შეეხეთ Safari-ს, შემდეგ — გაფართოებებს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбалар тізімін айналдырып, Safari, одан кейін Кеңейтімдер тармағын басыңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 목록을 스크롤하여 Safari를 누른 다음 확장 프로그램을 누르세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмолор тизмесин жылдырып, Safari, анан Кеңейтүүлөр бөлүмүн басыңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
