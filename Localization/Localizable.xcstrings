    "Doesn't unlock anything. Just a way to say thanks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يفتح أي ميزات. إنه مجرد وسيلة للتعبير عن الشكر."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "مش بيفتح أي مميزات. مجرد طريقة تقول بيها شكرًا."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не разблакіроўвае. Проста спосаб падзякаваць."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো সুবিধা আনলক হয় না। এটি শুধু ধন্যবাদ জানানোর একটি উপায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic neodemyká. Jen způsob, jak poděkovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser ikke noget op. Bare en måde at sige tak på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet nichts frei. Einfach eine Möglichkeit, Danke zu sagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't unlock anything. Just a way to say thanks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No desbloquea ninguna función. Es solo una forma de dar las gracias."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang feature na maa-unlock. Paraan lang ito ng pasasalamat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne débloque aucune fonctionnalité. Juste une façon de dire merci."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba ya buɗe wata fasali. Hanya ce kawai ta nuna godiya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא פותח שום דבר. רק דרך לומר תודה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे कोई सुविधा अनलॉक नहीं होती। यह केवल धन्यवाद कहने का तरीका है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem old fel semmit. Csak egy módja a köszönetnek."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ոչինչ չի ապակողպում։ Պարզապես շնորհակալություն հայտնելու ձև է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak membuka fitur apa pun. Hanya cara untuk mengucapkan terima kasih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sblocca nulla. È solo un modo per dire grazie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能の追加はありません。感謝を伝えるためのものです。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "არაფერს ხსნის. ეს უბრალოდ მადლობის თქმის გზაა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ешбір мүмкіндікті ашпайды. Тек алғыс білдірудің жолы."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 기능이 열리지는 않습니다. 감사의 마음을 전하는 방법일 뿐입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Эч кандай мүмкүнчүлүктү ачпайт. Жөн гана ыраазычылык билдирүү жолу."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieko neatrakina. Tiesiog būdas padėkoti."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे कोणतीही सुविधा अनलॉक होत नाही. आभार मानण्याचा हा एक मार्ग आहे."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै सुविधा खोल्दैन। धन्यवाद भन्ने एउटा तरिका मात्र हो।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendelt niets. Gewoon een manier om bedankt te zeggen."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی سہولت نئیں کھولدا۔ بس شکریہ آکھن دا اک طریقہ اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "E no dey unlock anything. Na just way to say thank you."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niczego nie odblokowuje. To tylko sposób na podziękowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não desbloqueia nenhuma função. É apenas uma forma de agradecer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não desbloqueia nenhuma função. É apenas uma forma de agradecer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu deblochează nimic. Doar un mod de a spune mulțumesc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не разблокирует. Просто способ сказать спасибо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låser inte upp något. Bara ett sätt att säga tack."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haifungui kipengele chochote. Ni njia tu ya kusema asante."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த அம்சமும் திறக்கப்படாது. நன்றி சொல்லும் ஒரு வழி மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీనితో ఏ ఫీచర్ అన్‌లాక్ కాదు. కృతజ్ఞత చెప్పడానికి ఒక మార్గం మాత్రమే."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ปลดล็อกฟีเจอร์ใด ๆ เป็นเพียงวิธีแสดงความขอบคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir özelliğin kilidini açmaz. Sadece teşekkür etmenin bir yolu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не розблоковує. Просто спосіб подякувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی خصوصیت نہیں کھولتا۔ بس شکریہ ادا کرنے کا ایک طریقہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở khóa tính năng nào. Chỉ là một cách nói lời cảm ơn."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "唔會解鎖任何功能，只係表達謝意嘅方法。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会解锁任何功能，只是表达感谢的一种方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會解鎖任何功能，只是表達感謝的方式。"
          }
