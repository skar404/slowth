    "Tell me what happened:\n\n\nApp and device details (you can delete these if you'd rather not share):\n%@\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني بما حدث:\n\n\nتفاصيل التطبيق والجهاز (يمكنك حذفها إن كنت لا ترغب في مشاركتها):\n⁨%@⁩\n⁨%@⁩\n"
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "قولي إيه اللي حصل:\n\n\nتفاصيل التطبيق والجهاز (تقدر تمسحها لو مش عايز تشاركها):\n⁨%@⁩\n⁨%@⁩\n"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскажыце, што здарылася:\n\n\nЗвесткі пра праграму і прыладу (можна выдаліць, калі не хочаце дзяліцца):\n%@\n%@\n"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ঘটেছে জানান:\n\n\nঅ্যাপ ও ডিভাইসের বিবরণ (শেয়ার করতে না চাইলে মুছে দিতে পারেন):\n%1$@\n%2$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište mi, co se stalo:\n\n\nPodrobnosti o aplikaci a zařízení (můžete je smazat, pokud je nechcete sdílet):\n%@\n%@\n"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl mig, hvad der skete:\n\n\nApp- og enhedsoplysninger (du kan slette dem, hvis du helst ikke vil dele):\n%@\n%@\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzähl mir, was passiert ist:\n\n\nApp- und Geräteinformationen (du kannst sie löschen, wenn du sie nicht teilen möchtest):\n%1$@\n%2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me what happened:\n\n\nApp and device details (you can delete these if you'd rather not share):\n%@\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntame qué pasó:\n\n\nDatos de la app y del dispositivo (puedes borrarlos si prefieres no compartirlos):\n%1$@\n%2$@"
