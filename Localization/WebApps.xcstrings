        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ਵਿੱਚ ਐਕਸਟੈਂਸ਼ਨ Safari ਵਾਲੀਆਂ ਹੀ ਬਲੌਕਿੰਗ ਸੈਟਿੰਗਾਂ ਵਰਤਦੀ ਹੈ। ਸਕ੍ਰੀਨ ਰਿਕਾਰਡ ਕਰਨ ਦੀ ਲੋੜ ਨਹੀਂ ਹੈ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth دے اندر ایکسٹینشن اوہو بلاکنگ سیٹنگاں ورتدی اے جو Safari وچ نیں۔ سکرین ریکارڈ کرن دی لوڑ نہیں۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "For Slowth, di extension dey use di same blocking settings wey dey for Safari. You no need to record your screen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Slowth rozszerzenie korzysta z tych samych ustawień blokowania co w Safari. Nie wymaga nagrywania ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Slowth, a extensão usa os mesmos ajustes de bloqueio do Safari. Não é preciso gravar a tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No Slowth, a extensão usa as mesmas definições de bloqueio que no Safari. Não é necessário gravar o ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Slowth, extensia folosește aceleași configurări de blocare ca în Safari. Nu este necesară înregistrarea ecranului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внутри Slowth расширение использует те же настройки блокировки, что и в Safari. Запускать запись экрана не нужно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikácii Slowth používa rozšírenie rovnaké nastavenia blokovania ako v Safari. Nahrávanie obrazovky nie je potrebné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaciji Slowth razširitev uporablja enake nastavitve blokiranja kot v Safariju. Snemanje zaslona ni potrebno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Slowth använder tillägget samma blockeringsinställningar som i Safari. Ingen skärminspelning behövs."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndani ya Slowth, kiendelezi hutumia mipangilio ileile ya kuzuia maudhui kama katika Safari. Huhitaji kurekodi skrini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth இல் நீட்டிப்பு Safari இல் உள்ள அதே தடுப்பு அமைப்புகளைப் பயன்படுத்துகிறது. திரையைப் பதிவு செய்ய வேண்டியதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowthలో పొడిగింపు Safariలో ఉన్న అవే బ్లాకింగ్ సెట్టింగ్‌లను ఉపయోగిస్తుంది. స్క్రీన్‌ను రికార్డ్ చేయాల్సిన అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Slowth ส่วนขยายใช้การตั้งค่าการบล็อกชุดเดียวกับใน Safari โดยไม่ต้องบันทึกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genişletme, Slowth’ta da Safari’deki engelleme ayarlarını kullanır. Ekran kaydı gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Slowth розширення використовує ті самі налаштування блокування, що й у Safari. Записувати екран не потрібно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth میں ایکسٹینشن وہی بلاکنگ ترتیبات استعمال کرتی ہے جو Safari میں ہیں۔ اسکرین ریکارڈ کرنے کی ضرورت نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Slowth, tiện ích mở rộng dùng cùng cài đặt chặn như trong Safari. Bạn không cần ghi màn hình."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "延伸功能喺 Slowth 入面會用同 Safari 一樣嘅封鎖設定，唔需要錄製螢幕。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Slowth 中，扩展使用的屏蔽设置与 Safari 相同，无需录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Slowth 中，延伸功能使用與 Safari 相同的封鎖設定，不需要錄製螢幕。"
          }
        }
      }
    },
