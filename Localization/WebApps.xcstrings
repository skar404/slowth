          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți site-uri web în aplicația Slowth folosind setările actuale de blocare. Adăugați o comandă rapidă la ecranul de pornire pentru acces rapid."
          }
