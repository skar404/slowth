        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బ్రౌజర్ Passkeyకి ప్రాప్యతను ఆమోదించడానికి Apple కోసం వేచి ఉంది. వెబ్ యాప్‌లు ఇప్పటికీ బీటాలో ఉన్నాయి."
          }
        },
        "th": {
