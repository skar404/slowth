            "value": "ہوم اسکرین میں شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vào màn hình chính"
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "加入主畫面"
