        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց ջնջել կայքի բոլոր տվյալները: Խնդրում ենք կրկին փորձել:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus semua data situs web. Silakan coba lagi."
