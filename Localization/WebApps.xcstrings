        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете из аккаунтов этого профиля, а его страницы закроются. Настройки блокировки сохранятся."
          }
        }
      }
    },
    "Blocking could not be verified. Restore protection to continue.": {
