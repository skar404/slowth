        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bővítmény a Slowth-ban ugyanazokat a blokkolási beállításokat használja, mint a Safariban. Nincs szükség képernyőfelvételre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth-ում ընդլայնումն օգտագործում է արգելափակման նույն կարգավորումները, ինչ Safari-ում։ Էկրանի ձայնագրման կարիք չկա։"
          }
        },
        "id": {
          "stringUnit": {
