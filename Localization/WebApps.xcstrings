    "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى خروجك من Instagram وFacebook وإغلاق صفحاتهما. تظل إعدادات الحظر كما هي."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى خروجك من Instagram وFacebook وإغلاق صفحاتهما. تظل إعدادات الحظر كما هي."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдзеце з Instagram і Facebook і закрыеце іх старонкі. Налады блакіроўкі застаюцца ранейшымі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনাকে Instagram এবং Facebook থেকে সাইন আউট করে এবং তাদের পৃষ্ঠাগুলি বন্ধ করে দেয়। ব্লকিং সেটিংস একই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això us tanca de Instagram i Facebook i tanca les seves pàgines. La configuració de bloqueig es manté igual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odhlásíte ze služeb Instagram a Facebook a jejich stránky se zavřou. Nastavení blokování zůstává stejné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette melder dig ud af Instagram og Facebook og lukker deres sider. Blokeringsindstillinger forbliver de samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Sie von Instagram und Facebook abgemeldet und deren Seiten geschlossen. Die Blockierungseinstellungen bleiben gleich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό σας αποκλείει από τα Instagram και Facebook και κλείνει τις σελίδες τους. Οι ρυθμίσεις αποκλεισμού παραμένουν οι ίδιες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cierra sesión en Instagram y Facebook y cierra sus páginas. La configuración de bloqueo sigue siendo la misma."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cierra sesión en Instagram y Facebook y cierra sus páginas. La configuración de bloqueo sigue siendo la misma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa sinut ulos Instagram- ja Facebook-palveluista ja sulkee niiden sivut. Estoasetukset pysyvät samoina."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina-sign out ka nito sa Instagram at Facebook at isinasara ang kanilang mga page. Ang mga setting ng pag-block ay nananatiling pareho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnecte de Instagram et Facebook et ferme leurs pages. Les paramètres de blocage restent les mêmes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnecte de Instagram et Facebook et ferme leurs pages. Les paramètres de blocage restent les mêmes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમને Instagram અને Facebookમાંથી સાઇન આઉટ કરે છે અને તેમના પૃષ્ઠો બંધ કરે છે. અવરોધિત સેટિંગ્સ સમાન રહે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana fitar da ku daga Instagram da Facebook kuma yana rufe shafukansu. Saitunan toshewa suna zama iri ɗaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מוציא אותך מ-Instagram וFacebook וסוגר את הדפים שלהם. הגדרות החסימה נשארות זהות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपको Instagram और Facebook से बाहर कर देता है और उनके पेज बंद कर देता है। ब्लॉकिंग सेटिंग वही रहती हैं."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se odjavljujete s Instagram i Facebook i zatvarate njihove stranice. Postavke blokiranja ostaju iste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel kijelentkeztet a Instagram és a Facebook szolgáltatásból, és bezárja az oldalakat. A blokkolási beállítások változatlanok maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ձեզ դուրս է հանում Instagram-ից և Facebook-ից և փակում նրանց էջերը: Արգելափակման կարգավորումները մնում են նույնը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengeluarkan Anda dari Instagram dan Facebook dan menutup halaman mereka. Pengaturan pemblokiran tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo modo esci da Instagram e Facebook e chiudi le loro pagine. Le impostazioni di blocco rimangono le stesse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、Instagram と Facebook からサインアウトされ、ページが閉じられます。ブロック設定は変わりません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს გამოგიყვანთ Instagram-დან და Facebook-დან და იხურება მათი გვერდები. დაბლოკვის პარამეტრები იგივე რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сізді Instagram және Facebook жүйесінен шығарады және олардың беттерін жабады. Блоктау параметрлері өзгеріссіз қалады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ನಿಮ್ಮನ್ನು Instagram ಮತ್ತು Facebook ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ಅವರ ಪುಟಗಳನ್ನು ಮುಚ್ಚುತ್ತದೆ. ನಿರ್ಬಂಧಿಸುವ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಒಂದೇ ಆಗಿರುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 Instagram 및 Facebook에서 로그아웃되고 해당 페이지가 닫힙니다. 차단 설정은 동일하게 유지됩니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сизди Instagram жана Facebook кызматтарынан чыгарып, алардын барактарын жабат. Бөгөттөө жөндөөлөрү ошол бойдон калат."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Taip atsijungsite nuo Instagram ir Facebook ir uždarysite jų puslapius. Blokavimo nustatymai išlieka tokie patys."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളെ Instagram, Facebook എന്നിവയിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുകയും അവരുടെ പേജുകൾ അടയ്ക്കുകയും ചെയ്യുന്നു. തടയൽ ക്രമീകരണങ്ങൾ അതേപടി നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे तुम्हाला Instagram आणि Facebook मधून साइन आउट करते आणि त्यांची पृष्ठे बंद करते. ब्लॉकिंग सेटिंग्ज समान राहतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengeluarkan anda daripada Instagram dan Facebook dan menutup halaman mereka. Tetapan menyekat kekal sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut av Instagram og Facebook og lukker sidene deres. Blokkeringsinnstillingene forblir de samme."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले तपाइँलाई Instagram र Facebook बाट साइन आउट गर्छ र तिनीहरूका पृष्ठहरू बन्द गर्दछ। अवरुद्ध सेटिङहरू उस्तै रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt u afgemeld bij Instagram en Facebook en worden hun pagina's gesloten. De blokkeerinstellingen blijven hetzelfde."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆପଣଙ୍କୁ Instagram ଏବଂ Facebook ରୁ ଚିହ୍ନିତ କରେ ଏବଂ ସେମାନଙ୍କର ପୃଷ୍ଠାଗୁଡ଼ିକୁ ବନ୍ଦ କରେ | ସେଟିଂକୁ ଅବରୋଧ କରିବା ସମାନ ରହିଥାଏ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਤੁਹਾਨੂੰ Instagram ਅਤੇ Facebook ਤੋਂ ਸਾਈਨ ਆਊਟ ਕਰਦਾ ਹੈ ਅਤੇ ਉਹਨਾਂ ਦੇ ਪੰਨਿਆਂ ਨੂੰ ਬੰਦ ਕਰਦਾ ਹੈ। ਬਲਾਕਿੰਗ ਸੈਟਿੰਗਾਂ ਇੱਕੋ ਜਿਹੀਆਂ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ایہ تہانوں Instagram تے Facebook توں باہر کڈ دیندا اے تے اوہناں دے صفحے بند کردا اے۔ روکن دی ترتیبات اوہی رہندیاں نیں۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This go sign you out of Instagram and Facebook and close their pages. Blocking settings go remain the same."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wylogowanie z Instagram i Facebook i zamknięcie ich stron. Ustawienia blokowania pozostają takie same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desconecta você de Instagram e Facebook e fecha suas páginas. As configurações de bloqueio permanecem as mesmas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto desliga-o de Instagram e Facebook e fecha as suas páginas. As definições de bloqueio permanecem as mesmas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru vă deconectează de la Instagram și Facebook și le închide paginile. Setările de blocare rămân aceleași."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете из Instagram и Facebook, а их страницы закроются. Настройки блокировки сохранятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa odhlásite zo služieb Instagram a Facebook a ich stránky sa zatvoria. Nastavenia blokovania zostávajú rovnaké."
          }
        },
        "sl": {
