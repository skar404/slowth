        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვებ აპებს სჭირდება iOS 18.4 ან უფრო ახალი. თქვენ კვლავ შეგიძლიათ გამოიყენოთ Slowth გაფართოება Safari-ში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб қолданбалар iOS 18.4 немесе одан кейінгі нұсқасын қажет етеді. Safari ішінде Slowth кеңейтімін әлі де пайдалана аласыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೆಬ್ ಅಪ್ಲಿಕೇಶನ್‌ಗಳಿಗೆ iOS 18.4 ಅಥವಾ ನಂತರದ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗಲೂ Safari ನಲ್ಲಿ Slowth ವಿಸ್ತರಣೆಯನ್ನು ಬಳಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 앱에는 iOS 18.4 이상이 필요합니다. Safari에서는 Slowth 확장자를 계속 사용할 수 있습니다."
          }
        },
        "ky": {
          "stringUnit": {
