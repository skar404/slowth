    "This signs you out of all websites in Slowth and deletes their cookies, cache and temporary downloads. Blocking settings, Safari data and files saved to Files stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى تسجيل خروجك من جميع مواقع الويب في Slowth وحذف ملفات تعريف الارتباط وذاكرة التخزين المؤقت والتنزيلات المؤقتة. تظل إعدادات الحظر وبيانات Safari والملفات المحفوظة في الملفات دون تغيير."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى تسجيل خروجك من جميع مواقع الويب في Slowth وحذف ملفات تعريف الارتباط وذاكرة التخزين المؤقت والتنزيلات المؤقتة. تظل إعدادات الحظر وبيانات Safari والملفات المحفوظة في الملفات دون تغيير."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта выводзіць вас з усіх вэб-сайтаў у Slowth і выдаляе файлы cookie, кэш і часовыя спампоўкі. Налады блакіроўкі, даныя Safari і файлы, захаваныя ў Files, застаюцца нязменнымі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনাকে Slowth এর সমস্ত ওয়েবসাইট থেকে সাইন আউট করে এবং তাদের কুকি, ক্যাশে এবং অস্থায়ী ডাউনলোডগুলি মুছে দেয়৷ ব্লকিং সেটিংস, Safari ডেটা এবং ফাইলগুলিতে সংরক্ষিত ফাইলগুলি অপরিবর্তিত থাকে৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això us tanca la sessió de tots els llocs web de Slowth i se n'elimina les galetes, la memòria cau i les baixades temporals. La configuració de bloqueig, les dades Safari i els fitxers desats a Files es mantenen sense canvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odhlásíte ze všech webových stránek ve službě Slowth a smažete jejich soubory cookie, mezipaměť a dočasná stahování. Nastavení blokování, data Safari a soubory uložené do složky Soubory zůstanou nezměněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger dig ud af alle websteder i Slowth og sletter deres cookies, cache og midlertidige downloads. Blokeringsindstillinger, Safari-data og filer gemt i Filer forbliver uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Sie von allen Websites in Slowth abgemeldet und deren Cookies, Cache und temporäre Downloads gelöscht. Blockierungseinstellungen, Safari-Daten und in Dateien gespeicherte Dateien bleiben unverändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό σας αποσυνδέει από όλους τους ιστότοπους στο Slowth και διαγράφει τα cookie, την προσωρινή μνήμη και τις προσωρινές λήψεις τους. Οι ρυθμίσεις αποκλεισμού, τα δεδομένα Safari και τα αρχεία που είναι αποθηκευμένα στα Αρχεία παραμένουν αμετάβλητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of all websites in Slowth and deletes their cookies, cache and temporary downloads. Blocking settings, Safari data and files saved to Files stay unchanged."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of all websites in Slowth and deletes their cookies, cache and temporary downloads. Blocking settings, Safari data and files saved to Files stay unchanged."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of all websites in Slowth and deletes their cookies, cache and temporary downloads. Blocking settings, Safari data and files saved to Files stay unchanged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of all websites in Slowth and deletes their cookies, cache and temporary downloads. Blocking settings, Safari data and files saved to Files stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cierra tu sesión en todos los sitios web en Slowth y elimina sus cookies, caché y descargas temporales. La configuración de bloqueo, los datos Safari y los archivos guardados en Archivos permanecen sin cambios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cierra tu sesión en todos los sitios web en Slowth y elimina sus cookies, caché y descargas temporales. La configuración de bloqueo, los datos Safari y los archivos guardados en Archivos permanecen sin cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa sinut ulos kaikista Slowth-sivustoista ja poistaa niiden evästeet, välimuistin ja väliaikaiset lataukset. Estoasetukset, Safari-tiedot ja Tiedostoihin tallennetut tiedostot pysyvät ennallaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina-sign out ka nito sa lahat ng website sa Slowth at tinatanggal ang kanilang cookies, cache at pansamantalang pag-download. Ang mga setting ng pag-block, Safari data at mga file na naka-save sa Files ay mananatiling hindi nagbabago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnecte de tous les sites Web de Slowth et supprime leurs cookies, leur cache et leurs téléchargements temporaires. Les paramètres de blocage, les données Safari et les fichiers enregistrés dans Fichiers restent inchangés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous déconnecte de tous les sites Web de Slowth et supprime leurs cookies, leur cache et leurs téléchargements temporaires. Les paramètres de blocage, les données Safari et les fichiers enregistrés dans Fichiers restent inchangés."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમને Slowth ની બધી વેબસાઇટ્સમાંથી સાઇન આઉટ કરે છે અને તેમની કૂકીઝ, કેશ અને કામચલાઉ ડાઉનલોડ્સ કાઢી નાખે છે. બ્લોકીંગ સેટિંગ્સ, Safari ડેટા અને ફાઇલોમાં સાચવેલ ફાઇલો યથાવત રહે છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan yana fitar da ku daga duk rukunin yanar gizon da ke cikin Slowth kuma yana share kukis ɗin su, cache da zazzagewar ɗan lokaci. Saitunan toshewa, bayanai Safari da fayilolin da aka ajiye zuwa Fayiloli suna zama ba su canzawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מוציא אותך מכל האתרים ב-Slowth ומוחק את קובצי העוגיות, המטמון וההורדות הזמניות שלהם. הגדרות חסימה, נתוני Safari וקבצים שנשמרו בקבצים נשארים ללא שינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपको Slowth की सभी वेबसाइटों से साइन आउट कर देता है और उनकी कुकीज़, कैशे और अस्थायी डाउनलोड हटा देता है। ब्लॉकिंग सेटिंग्स, Safari डेटा और फ़ाइलों में सहेजी गई फ़ाइलें अपरिवर्तित रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo vas odjavljuje sa svih web stranica u Slowth i briše njihove kolačiće, predmemoriju i privremena preuzimanja. Postavke blokiranja, podaci Safari i datoteke spremljene u Datoteke ostaju nepromijenjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez kijelentkezteti a Slowth összes webhelyéről, és törli a cookie-kat, a gyorsítótárat és az ideiglenes letöltéseket. A blokkolási beállítások, a Safari adatok és a Fájlokba mentett fájlok változatlanok maradnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ձեզ դուրս կբերի Slowth-ի բոլոր կայքերից և կջնջի դրանց քուքիները, քեշը և ժամանակավոր ներբեռնումները: Արգելափակման կարգավորումները, Safari տվյալները և Ֆայլերում պահված ֆայլերը մնում են անփոփոխ:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengeluarkan Anda dari semua situs web di Slowth dan menghapus cookie, cache, dan unduhan sementara. Pengaturan pemblokiran, data Safari dan file yang disimpan ke File tetap tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo modo esci da tutti i siti web in Slowth ed elimini i relativi cookie, cache e download temporanei. Le impostazioni di blocco, i dati di Safari e i file salvati in File rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、Slowth のすべての Web サイトからサインアウトされ、Cookie、キャッシュ、一時ダウンロードが削除されます。ブロック設定、Safari データ、ファイルに保存されたファイルは変更されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს გამოგიყვანთ ყველა ვებსაიტიდან Slowth-ში და წაშლის მათ ქუქი-ფაილებს, ქეშს და დროებით ჩამოტვირთვებს. დაბლოკვის პარამეტრები, Safari მონაცემები და ფაილებში შენახული ფაილები უცვლელი რჩება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл сізді Slowth жүйесіндегі барлық веб-сайттардан шығарады және олардың cookie файлдарын, кэшін және уақытша жүктеп алуларын жояды. Блоктау параметрлері, Safari деректері және Files ішіне сақталған файлдар өзгеріссіз қалады."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ನಿಮ್ಮನ್ನು Slowth ನಲ್ಲಿನ ಎಲ್ಲಾ ವೆಬ್‌ಸೈಟ್‌ಗಳಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡುತ್ತದೆ ಮತ್ತು ಅವರ ಕುಕೀಗಳು, ಸಂಗ್ರಹ ಮತ್ತು ತಾತ್ಕಾಲಿಕ ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಅಳಿಸುತ್ತದೆ. ನಿರ್ಬಂಧಿಸುವ ಸೆಟ್ಟಿಂಗ್‌ಗಳು, Safari ಡೇಟಾ ಮತ್ತು ಫೈಲ್‌ಗಳಲ್ಲಿ ಉಳಿಸಲಾದ ಫೈಲ್‌ಗಳು ಬದಲಾಗದೆ ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 Slowth의 모든 웹사이트에서 로그아웃되고 쿠키, 캐시 및 임시 다운로드가 삭제됩니다. 차단 설정, Safari 데이터 및 파일에 저장된 파일은 변경되지 않습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул сизди Slowth ичиндеги бардык вебсайттардан чыгарып, алардын кукилерин, кэштерин жана убактылуу жүктөп алууларын жок кылат. Бөгөттөө жөндөөлөрү, Safari дайындары жана Файлдарга сакталган файлдар өзгөрүүсүз калат."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai atjungs jus nuo visų Slowth svetainių ir ištrins jų slapukus, talpyklą ir laikinus atsisiuntimus. Blokavimo nustatymai, Safari duomenys ir failai, išsaugoti Failuose, lieka nepakitę."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് നിങ്ങളെ Slowth എന്നതിലെ എല്ലാ വെബ്‌സൈറ്റുകളിൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യുകയും അവയുടെ കുക്കികൾ, കാഷെ, താൽക്കാലിക ഡൗൺലോഡുകൾ എന്നിവ ഇല്ലാതാക്കുകയും ചെയ്യുന്നു. തടയൽ ക്രമീകരണങ്ങൾ, Safari ഡാറ്റ, ഫയലുകളിൽ സംരക്ഷിച്ച ഫയലുകൾ എന്നിവ മാറ്റമില്ലാതെ തുടരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे तुम्हाला Slowth मधील सर्व वेबसाइटमधून साइन आउट करते आणि त्यांच्या कुकीज, कॅशे आणि तात्पुरते डाउनलोड हटवते. ब्लॉकिंग सेटिंग्ज, Safari डेटा आणि फाइल्समध्ये सेव्ह केलेल्या फाइल अपरिवर्तित राहतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengelog anda keluar daripada semua tapak web dalam Slowth dan memadamkan kuki, cache dan muat turun sementara mereka. Tetapan menyekat, data Safari dan fail yang disimpan ke Fail kekal tidak berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette logger deg ut av alle nettsteder i Slowth og sletter informasjonskapslene, hurtigbufferen og midlertidige nedlastinger. Blokkeringsinnstillinger, Safari-data og filer lagret i Filer forblir uendret."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले तपाईंलाई Slowth मा सबै वेबसाइटहरूबाट साइन आउट गर्छ र तिनीहरूका कुकीहरू, क्यास र अस्थायी डाउनलोडहरू मेटाउँछ। ब्लकिङ सेटिङहरू, Safari डाटा र फाइलहरूमा बचत गरिएका फाइलहरू अपरिवर्तित रहन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt u afgemeld bij alle websites in Slowth en worden hun cookies, cache en tijdelijke downloads verwijderd. Blokkeerinstellingen, Safari-gegevens en bestanden die zijn opgeslagen in Bestanden blijven ongewijzigd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ଆପଣଙ୍କୁ Slowth ର ସମସ୍ତ ୱେବସାଇଟ୍ ରୁ ସାଇନ୍ କରେ ଏବଂ ସେମାନଙ୍କର କୁକିଜ୍, କ୍ୟାଚ୍ ଏବଂ ଅସ୍ଥାୟୀ ଡାଉନଲୋଡ୍ ଡିଲିଟ୍ କରେ | ସେଟିଂସମୂହକୁ ଅବରୋଧ କରିବା, Safari ତଥ୍ୟ ଏବଂ ଫାଇଲଗୁଡ଼ିକରେ ସଞ୍ଚୟ ହୋଇଥିବା ଫାଇଲଗୁଡ଼ିକ ଅପରିବର୍ତ୍ତିତ ରହନ୍ତି |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਤੁਹਾਨੂੰ Slowth ਵਿੱਚ ਸਾਰੀਆਂ ਵੈਬਸਾਈਟਾਂ ਤੋਂ ਸਾਈਨ ਆਊਟ ਕਰ ਦਿੰਦਾ ਹੈ ਅਤੇ ਉਹਨਾਂ ਦੀਆਂ ਕੂਕੀਜ਼, ਕੈਸ਼ ਅਤੇ ਅਸਥਾਈ ਡਾਉਨਲੋਡਸ ਨੂੰ ਮਿਟਾ ਦਿੰਦਾ ਹੈ। ਬਲਾਕਿੰਗ ਸੈਟਿੰਗਾਂ, Safari ਡਾਟਾ ਅਤੇ ਫ਼ਾਈਲਾਂ ਵਿੱਚ ਰੱਖਿਅਤ ਕੀਤੀਆਂ ਫ਼ਾਈਲਾਂ ਬਦਲੀਆਂ ਨਹੀਂ ਰਹਿੰਦੀਆਂ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ایہ تہانوں Slowth چ ساریاں ویب سائٹاں توں سائن آؤٹ کردا اے تے اوہناں دیاں کوکیز، کیشے تے عارضی ڈاؤن لوڈز نو مٹا دیندا اے۔ روکن آلی ترتیبات، Safari ڈیٹا تے فائلاں چ محفوظ کیتیاں گئیاں فائلاں کوئی تبدیلی نئیں کردیاں۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "This go sign you out of all websites for Slowth and delete their cookies, cache and temporary downloads. Blocking settings, Safari data and files wey you save for Files go remain."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wylogowanie ze wszystkich stron internetowych Slowth i usunięcie ich plików cookie, pamięci podręcznej i tymczasowych pobrań. Ustawienia blokowania, dane Safari i pliki zapisane w Plikach pozostają niezmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso desconecta você de todos os sites em Slowth e exclui seus cookies, cache e downloads temporários. As configurações de bloqueio, os dados de Safari e os arquivos salvos em Arquivos permanecem inalterados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto desconecta-o de todos os sites em Slowth e elimina os seus cookies, cache e downloads temporários. As definições de bloqueio, os dados de Safari e os ficheiros guardados em Ficheiros permanecem inalterados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru vă deconectează de la toate site-urile web din Slowth și le șterge cookie-urile, memoria cache și descărcările temporare. Setările de blocare, datele Safari și fișierele salvate în Fișiere rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете из аккаунтов всех сайтов в Slowth. Их cookies, кэш и временные загрузки будут удалены. Настройки блокировки, данные Safari и файлы, сохранённые в «Файлы», останутся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa odhlásite zo všetkých webových stránok v Slowth a odstránia sa ich súbory cookie, vyrovnávacia pamäť a dočasné stiahnuté súbory. Nastavenia blokovania, údaje Safari a súbory uložené v aplikácii Súbory zostanú nezmenené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem se odjavite z vseh spletnih mest v Slowth in izbrišete njihove piškotke, predpomnilnik in začasne prenose. Nastavitve blokiranja, podatki Safari in datoteke, shranjene v Datoteke, ostanejo nespremenjene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta loggar dig ut från alla webbplatser i Slowth och raderar deras cookies, cache och tillfälliga nedladdningar. Blockeringsinställningar, Safari-data och filer som sparats i Filer förblir oförändrade."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inakuondoa kwenye tovuti zote katika Slowth na kufuta vidakuzi vyake, akiba na vipakuliwa vyao vya muda. Mipangilio ya kuzuia, Safari data na faili zilizohifadhiwa kwenye Faili hazibadiliki."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்களை Slowth இல் உள்ள அனைத்து இணையதளங்களிலிருந்தும் வெளியேற்றி, அவற்றின் குக்கீகள், கேச் மற்றும் தற்காலிகப் பதிவிறக்கங்களை நீக்குகிறது. தடுப்பு அமைப்புகள், Safari தரவு மற்றும் கோப்புகளில் சேமிக்கப்பட்ட கோப்புகள் மாறாமல் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మిమ్మల్ని Slowthలోని అన్ని వెబ్‌సైట్‌ల నుండి సైన్ అవుట్ చేస్తుంది మరియు వాటి కుక్కీలు, కాష్ మరియు తాత్కాలిక డౌన్‌లోడ్‌లను తొలగిస్తుంది. బ్లాక్ చేసే సెట్టింగ్‌లు, Safari డేటా మరియు ఫైల్‌లలో సేవ్ చేయబడిన ఫైల్‌లు మారవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะนำคุณออกจากเว็บไซต์ทั้งหมดใน Slowth และลบคุกกี้ แคช และการดาวน์โหลดชั่วคราวของเว็บไซต์เหล่านั้น การตั้งค่าการบล็อก ข้อมูล Safari และไฟล์ที่บันทึกไว้ใน Files จะไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Slowth içindeki tüm web sitelerindeki oturumunuzu kapatır ve çerezleri, önbellekleri ve geçici indirmeleri siler. Engelleme ayarları, Safari verileri ve Dosyalar'a kaydedilen dosyalar değişmeden kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це призведе до виходу з усіх веб-сайтів у Slowth та видалення їхніх файлів cookie, кешу та тимчасових завантажень. Налаштування блокування, дані Safari та файли, збережені у Files, залишаються незмінними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کو Slowth میں موجود تمام ویب سائٹس سے سائن آؤٹ کر دیتا ہے اور ان کی کوکیز، کیشے اور عارضی ڈاؤن لوڈز کو حذف کر دیتا ہے۔ مسدود کرنے کی ترتیبات، Safari ڈیٹا اور فائلز میں محفوظ کردہ فائلیں غیر تبدیل شدہ رہیں گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ đăng xuất bạn khỏi tất cả các trang web trong Slowth và xóa cookie, bộ nhớ đệm cũng như các nội dung tải xuống tạm thời của chúng. Cài đặt chặn, dữ liệu Safari và các tệp được lưu vào Tệp không thay đổi."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個操作會將你排除喺 Slowth 入面嘅所有網站，同埋刪除佢哋嘅 Cookie 、快取同埋臨時下載。封鎖設定、 Safari 數據同埋儲存到檔案嘅檔案保持不變。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将使您退出 Slowth 中的所有网站，并删除其 cookie、缓存和临时下载。阻止设置、保存到文件的 Safari 数据和文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將使您退出 Slowth 中的所有網站，並刪除其 cookie、快取和臨時下載。阻止設定、儲存到檔案的 Safari 資料和檔案保持不變。"
          }
        }
      }
    },
