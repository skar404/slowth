          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کو Instagram اور Facebook سے سائن آؤٹ کر دیتا ہے اور ان کے صفحات بند کر دیتا ہے۔ مسدود کرنے کی ترتیبات وہی رہیں۔"
