          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เบราว์เซอร์ในแอป Slowth หรือใช้ Safari กับส่วนขยาย Slowth แทนการบันทึกหน้าจอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranınızı kaydetmek yerine Slowth uygulamasındaki tarayıcıyı kullanın veya Slowth uzantısıyla Safari kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте браузер у програмі Slowth або використовуйте Safari з розширенням Slowth замість запису екрана."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی اسکرین کو ریکارڈ کرنے کے بجائے Slowth ایپ میں براؤزر استعمال کریں یا Slowth ایکسٹینشن کے ساتھ Safari استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng trình duyệt trong ứng dụng Slowth hoặc sử dụng Safari với tiện ích mở rộng Slowth thay vì ghi lại màn hình của bạn."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Slowth 應用程式入面嘅瀏覽器，或者用 Safari 同 Slowth 擴充程式，而唔係錄影你嘅螢幕。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需启动屏幕录制，即可使用Slowth内置浏览器，或启用了Slowth扩展的Safari。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不必啟動畫面錄製，即可使用Slowth內建瀏覽器，或啟用了Slowth延伸功能的Safari。"
          }
        }
      },
      "comment": "Browser-based alternative to screen-recording monitoring. Safari requires the Slowth extension."
    },
