        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Slowth, l’estensione usa le stesse impostazioni di blocco di Safari. Non serve registrare lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth 内でも機能拡張は Safari と同じブロック設定を使用します。画面収録は必要ありません。"
