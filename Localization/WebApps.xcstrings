        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முகப்புத் திரையில் சேர்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హోమ్ స్క్రీన్‌కి జోడించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มไปที่หน้าจอหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekrana Ekle"
          }
        },
        "uk": {
          "stringUnit": {
