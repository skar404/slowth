        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ വെബ്‌സൈറ്റ് ഡാറ്റയും മായ്‌ക്കാനായില്ല. ദയവായി വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व वेबसाइट डेटा साफ करू शकलो नाही. कृपया पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengosongkan semua data tapak web. Sila cuba lagi."
