        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી વર્તમાન બ્લોકીંગ સેટિંગ્સનો ઉપયોગ કરીને Slowth એપ્લિકેશનમાં વેબસાઇટ્સ ખોલો. ઝડપી ઍક્સેસ માટે તમારી હોમ સ્ક્રીન પર શોર્ટકટ ઉમેરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude gidajen yanar gizo a cikin Slowth app ta amfani da saitunan toshewar ku na yanzu. Ƙara gajerar hanya zuwa Fuskar allo don shiga cikin sauri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח אתרים באפליקציית Slowth באמצעות הגדרות החסימה הנוכחיות שלך. הוסף קיצור דרך למסך הבית שלך לגישה מהירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी वर्तमान ब्लॉकिंग सेटिंग्स का उपयोग करके Slowth ऐप में वेबसाइटें खोलें। त्वरित पहुंच के लिए अपनी होम स्क्रीन पर एक शॉर्टकट जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvarajte web stranice u aplikaciji Slowth koristeći svoje trenutne postavke blokiranja. Dodajte prečac na početni zaslon za brzi pristup."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisson meg webhelyeket a Slowth alkalmazásban a jelenlegi letiltási beállításaival. Adjon hozzá egy parancsikont a kezdőképernyőhöz a gyors eléréshez."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացեք կայքերը Slowth հավելվածում՝ օգտագործելով ձեր ընթացիկ արգելափակման կարգավորումները: Արագ մուտքի համար դյուրանցում ավելացրեք ձեր Հիմնական էկրանին:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka situs web di aplikasi Slowth menggunakan pengaturan pemblokiran Anda saat ini. Tambahkan pintasan ke Layar Beranda Anda untuk akses cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri i siti web nell'app Slowth utilizzando le impostazioni di blocco attuali. Aggiungi un collegamento alla schermata iniziale per un accesso rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のブロック設定を使用して、Slowth アプリで Web サイトを開きます。すばやくアクセスできるように、ホーム画面にショートカットを追加します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გახსენით ვებსაიტები Slowth აპში თქვენი მიმდინარე დაბლოკვის პარამეტრების გამოყენებით. დაამატეთ მალსახმობი თქვენს მთავარ ეკრანზე სწრაფი წვდომისთვის."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ағымдағы бөгеу параметрлерін пайдаланып Slowth қолданбасында веб-сайттарды ашыңыз. Жылдам қол жеткізу үшін негізгі экранға төте жол қосыңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪ್ರಸ್ತುತ ನಿರ್ಬಂಧಿಸುವ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು Slowth ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ವೆಬ್‌ಸೈಟ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ. ತ್ವರಿತ ಪ್ರವೇಶಕ್ಕಾಗಿ ನಿಮ್ಮ ಹೋಮ್ ಸ್ಕ್ರೀನ್‌ಗೆ ಶಾರ್ಟ್‌ಕಟ್ ಸೇರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 차단 설정을 사용하여 Slowth 앱에서 웹사이트를 엽니다. 빠른 액세스를 위해 홈 화면에 바로가기를 추가하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Учурдагы бөгөттөө жөндөөлөрүңүздү колдонуп, Slowth колдонмосунда вебсайттарды ачыңыз. Тез жетүү үчүн Башкы экраныңызга жарлык кошуңуз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarykite svetaines programoje Slowth naudodami dabartinius blokavimo nustatymus. Pridėkite nuorodą į pagrindinį ekraną, kad galėtumėte greitai pasiekti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നിലവിലെ തടയൽ ക്രമീകരണങ്ങൾ ഉപയോഗിച്ച് Slowth ആപ്പിൽ വെബ്‌സൈറ്റുകൾ തുറക്കുക. പെട്ടെന്നുള്ള ആക്‌സസിനായി നിങ്ങളുടെ ഹോം സ്‌ക്രീനിലേക്ക് ഒരു കുറുക്കുവഴി ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची वर्तमान ब्लॉकिंग सेटिंग्ज वापरून Slowth ॲपमध्ये वेबसाइट उघडा. द्रुत प्रवेशासाठी तुमच्या होम स्क्रीनवर शॉर्टकट जोडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka tapak web dalam apl Slowth menggunakan tetapan penyekatan semasa anda. Tambahkan pintasan pada Skrin Utama anda untuk akses pantas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne nettsteder i Slowth-appen ved å bruke dine nåværende blokkeringsinnstillinger. Legg til en snarvei til startskjermen for rask tilgang."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाइँको हालको ब्लकिङ सेटिङहरू प्रयोग गरेर Slowth एपमा वेबसाइटहरू खोल्नुहोस्। द्रुत पहुँचको लागि आफ्नो गृह स्क्रिनमा सर्टकट थप्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open websites in de Slowth-app met uw huidige blokkeerinstellingen. Voeg een snelkoppeling toe aan uw startscherm voor snelle toegang."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ସାମ୍ପ୍ରତିକ ଅବରୋଧ ସେଟିଂ ବ୍ୟବହାର କରି Slowth ଆପରେ ୱେବସାଇଟ୍ ଖୋଲନ୍ତୁ | ଶୀଘ୍ର ପ୍ରବେଶ ପାଇଁ ଆପଣଙ୍କ ହୋମ ସ୍କ୍ରିନରେ ଏକ ସର୍ଟକଟ୍ ଯୋଡନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀਆਂ ਮੌਜੂਦਾ ਬਲਾਕਿੰਗ ਸੈਟਿੰਗਾਂ ਦੀ ਵਰਤੋਂ ਕਰਕੇ Slowth ਐਪ ਵਿੱਚ ਵੈੱਬਸਾਈਟਾਂ ਖੋਲ੍ਹੋ। ਤੁਰੰਤ ਪਹੁੰਚ ਲਈ ਆਪਣੀ ਹੋਮ ਸਕ੍ਰੀਨ 'ਤੇ ਇੱਕ ਸ਼ਾਰਟਕੱਟ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی موجودہ بلاکنگ ترتیبات دا استعمال کردے ہوئے Slowth ایپ وچ ویب سائٹاں کھولو۔ فوری رسائی دے لیی اپنڑی ہوم اسکرین تے اک شارٹ کٹ شامل کرو۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Open websites inside Slowth with the blocking settings wey you already set. Add shortcut to your Home Screen so you fit open them quick."
