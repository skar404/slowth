    "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of Instagram and Facebook and closes their pages. Blocking settings stay the same."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выйдете из Instagram и Facebook, а их страницы закроются. Настройки блокировки сохранятся."
          }
        }
      }
    },
    "This signs you out of this profile and closes its pages. Blocking settings stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This signs you out of this profile and closes its pages. Blocking settings stay the same."
