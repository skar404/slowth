{
  "sourceLanguage": "en",
  "strings": {
    "Web apps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-приложения"
          }
        }
      }
    },
    "Your sites, with room to breathe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sites, with room to breathe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши сайты. Больше спокойствия."
          }
        }
      }
    },
    "Open websites inside Slowth with your existing blocking settings. Add a shortcut to keep them where your thumb remembers.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open websites inside Slowth with your existing blocking settings. Add a shortcut to keep them where your thumb remembers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте сайты внутри Slowth с вашими настройками блокировки. Добавьте ярлык на привычное место на экране «Домой»."
          }
        }
      }
    },
    "Open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть"
          }
        }
      }
    },
    "Add to Home Screen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to Home Screen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экран «Домой»"
          }
        }
      }
    },
    "Sign in once inside Slowth. Safari sign-ins are separate. Shortcuts open Slowth; deleting a shortcut leaves your account and settings intact.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in once inside Slowth. Safari sign-ins are separate. Shortcuts open Slowth; deleting a shortcut leaves your account and settings intact."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в аккаунт внутри Slowth. Вход в Safari хранится отдельно. Ярлыки открывают Slowth; удаление ярлыка не удаляет аккаунт и настройки."
          }
        }
      }
    },
    "Web apps require iOS 18.4 or later. You can still use the Slowth extension in Safari.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps require iOS 18.4 or later. You can still use the Slowth extension in Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-приложения доступны начиная с iOS 18.4. На вашей версии можно пользоваться расширением Slowth в Safari."
          }
        }
      }
    },
    "Blocking settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки блокировки"
          }
        }
      }
    },
    "Open the setup page in Safari, tap Share, then Add to Home Screen. Keep Open as Web App enabled if that option appears, then tap Add.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the setup page in Safari, tap Share, then Add to Home Screen. Keep Open as Web App enabled if that option appears, then tap Add."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу настройки в Safari, нажмите «Поделиться», затем «На экран Домой». Если есть переключатель «Открывать как веб-приложение», оставьте его включённым и нажмите «Добавить»."
          }
        }
      }
    },
    "The shortcut opens this website inside Slowth. iOS may ask you to confirm opening Slowth.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut opens this website inside Slowth. iOS may ask you to confirm opening Slowth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ярлык откроет этот сайт внутри Slowth. iOS может попросить подтвердить открытие Slowth."
          }
        }
      }
    },
