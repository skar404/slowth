        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब ऐप्स के लिए iOS 18.4 या बाद के संस्करण की आवश्यकता होती है। आप अभी भी Safari में Slowth एक्सटेंशन का उपयोग कर सकते हैं।"
