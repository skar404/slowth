    },
    "Web apps now use separate profiles. Please sign in again once. Instagram and Facebook share Meta; your old sign-ins have not been deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم تطبيقات الويب الآن ملفات تعريف منفصلة. الرجاء تسجيل الدخول مرة أخرى. Instagram وFacebook يستخدمان نفس ملف التعريف Meta. لم يتم حذف تسجيلات الدخول القديمة."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم تطبيقات الويب الآن ملفات تعريف منفصلة. الرجاء تسجيل الدخول مرة أخرى. Instagram وFacebook يستخدمان نفس ملف التعريف Meta. لم يتم حذف تسجيلات الدخول القديمة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вэб-праграмы цяпер выкарыстоўваюць асобныя профілі. Увайдзіце яшчэ раз. Instagram і Facebook выкарыстоўваюць адзін і той жа профіль Meta. Вашы старыя ўваходы не былі выдалены."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়েব অ্যাপস এখন আলাদা প্রোফাইল ব্যবহার করে। আবার সাইন ইন করুন. Instagram এবং Facebook একই Meta প্রোফাইল ব্যবহার করে। আপনার পুরানো সাইন-ইন মুছে ফেলা হয়নি."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aplicacions web ara utilitzen perfils separats. Si us plau, torneu a iniciar la sessió. Instagram i Facebook utilitzen el mateix perfil Meta. Els vostres inicis de sessió antics no s'han suprimit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Webové aplikace nyní používají samostatné profily. Přihlaste se prosím znovu. Instagram a Facebook používají stejný profil Meta. Vaše stará přihlášení nebyla smazána."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Webapps bruger nu separate profiler. Log venligst ind igen. Instagram og Facebook bruger den samme Meta profil. Dine gamle logins er ikke blevet slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Web-Apps verwenden jetzt separate Profile. Bitte melden Sie sich erneut an. Instagram und Facebook verwenden dasselbe Meta-Profil. Ihre alten Anmeldungen wurden nicht gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές Ιστού χρησιμοποιούν πλέον ξεχωριστά προφίλ. Παρακαλούμε συνδεθείτε ξανά. Οι Instagram και Facebook χρησιμοποιούν το ίδιο προφίλ Meta. Οι παλιές συνδέσεις σας δεν έχουν διαγραφεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps now use separate profiles. Please sign in again once. Instagram and Facebook share Meta; your old sign-ins have not been deleted."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps now use separate profiles. Please sign in again once. Instagram and Facebook share Meta; your old sign-ins have not been deleted."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps now use separate profiles. Please sign in again once. Instagram and Facebook share Meta; your old sign-ins have not been deleted."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps now use separate profiles. Please sign in again once. Instagram and Facebook share Meta; your old sign-ins have not been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps web ahora usan perfiles separados. Vuelve a iniciar sesión. Instagram y Facebook comparten el perfil Meta; no se han eliminado tus sesiones anteriores."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps web ahora usan perfiles separados. Vuelve a iniciar sesión. Instagram y Facebook comparten el perfil Meta; no se han eliminado tus sesiones anteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkosovellukset käyttävät nyt erillisiä profiileja. Kirjaudu uudelleen sisään. Instagram ja Facebook käyttävät samaa Meta -profiilia. Vanhoja kirjautumistietojasi ei ole poistettu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit na ngayon ang mga web app ng magkakahiwalay na profile. Mangyaring mag-sign in muli. Instagram at Facebook ay gumagamit ng parehong Meta na profile. Ang iyong lumang pag-sign-in ay hindi natanggal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps web utilisent désormais des profils distincts. Veuillez vous reconnecter. Instagram et Facebook partagent le profil Meta ; vos anciennes connexions n’ont pas été supprimées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps web utilisent désormais des profils distincts. Veuillez vous reconnecter. Instagram et Facebook partagent le profil Meta ; vos anciennes connexions n’ont pas été supprimées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વેબ એપ્લિકેશન્સ હવે અલગ પ્રોફાઇલનો ઉપયોગ કરે છે. કૃપા કરીને ફરીથી સાઇન ઇન કરો. Instagram અને Facebook સમાન Meta પ્રોફાઇલનો ઉપયોગ કરે છે. તમારા જૂના સાઇન-ઇન્સ કાઢી નાખવામાં આવ્યા નથી."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka'idodin yanar gizo yanzu suna amfani da bayanan martaba daban. Da fatan za a sake shiga Instagram da Facebook suna amfani da bayanin martaba guda Meta. Ba a share tsoffin shigar ku ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציות אינטרנט משתמשות כעת בפרופילים נפרדים. נא להיכנס שוב. Instagram ו-Facebook משתמשים באותו פרופיל Meta. הכניסות הישנות שלך לא נמחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब ऐप्स अब अलग प्रोफ़ाइल का उपयोग करते हैं। कृपया पुनः साइन इन करें. Instagram और Facebook समान Meta प्रोफ़ाइल का उपयोग करते हैं। आपके पुराने साइन-इन हटाए नहीं गए हैं."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web aplikacije sada koriste zasebne profile. Prijavite se ponovo. Instagram i Facebook koriste isti Meta profil. Vaše stare prijave nisu izbrisane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A webalkalmazások mostantól külön profilokat használnak. Kérjük, jelentkezzen be újra. Instagram és Facebook ugyanazt a Meta profilt használják. A régi bejelentkezési adatait nem törölték."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վեբ հավելվածներն այժմ օգտագործում են առանձին պրոֆիլներ: Խնդրում ենք նորից մուտք գործել: Instagram և Facebook-ն օգտագործում են նույն Meta պրոֆիլը: Ձեր հին մուտքերը չեն ջնջվել:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi web sekarang menggunakan profil terpisah. Silakan masuk lagi. Instagram dan Facebook menggunakan profil Meta yang sama. Proses masuk lama Anda belum dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app Web ora utilizzano profili separati. Per favore accedi di nuovo. Instagram e Facebook utilizzano lo stesso profilo Meta. I tuoi vecchi accessi non sono stati eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web アプリは現在、個別のプロファイルを使用しています。再度サインインしてください。 Instagram と Facebook は同じ Meta プロファイルを使用します。古いサインインは削除されていません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვებ აპები ახლა ცალკე პროფილებს იყენებენ. გთხოვთ შეხვიდეთ ხელახლა. Instagram და Facebook იყენებენ იგივე Meta პროფილს. თქვენი ძველი შესვლები არ წაიშალა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб қолданбалары енді бөлек профильдерді пайдаланады. Жүйеге қайта кіріңіз. Instagram және Facebook бірдей Meta профилін пайдаланады. Ескі жүйеге кірулер жойылған жоқ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೆಬ್ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ಈಗ ಪ್ರತ್ಯೇಕ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬಳಸುತ್ತವೆ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. Instagram ಮತ್ತು Facebook ಅದೇ Meta ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸುತ್ತವೆ. ನಿಮ್ಮ ಹಳೆಯ ಸೈನ್-ಇನ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 웹 앱은 별도의 프로필을 사용합니다. 다시 로그인해 주세요. Instagram 및 Facebook은(는) 동일한 Meta 프로필을 사용합니다. 이전 로그인은 삭제되지 않았습니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб колдонмолор азыр өзүнчө профилдерди колдонушат. Сураныч, кайра кириңиз. Instagram жана Facebook бирдей Meta профилин колдонушат. Сиздин эски кирүүңүз жок кылынган жок."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabar žiniatinklio programos naudoja atskirus profilius. Prisijunkite dar kartą. Instagram ir Facebook naudoja tą patį Meta profilį. Jūsų seni prisijungimai nebuvo ištrinti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വെബ് ആപ്പുകൾ ഇപ്പോൾ പ്രത്യേക പ്രൊഫൈലുകൾ ഉപയോഗിക്കുന്നു. ദയവായി വീണ്ടും സൈൻ ഇൻ ചെയ്യുക. Instagram ഉം Facebook ഉം ഒരേ Meta പ്രൊഫൈൽ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പഴയ സൈൻ-ഇന്നുകൾ ഇല്ലാതാക്കിയിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब ॲप्स आता स्वतंत्र प्रोफाइल वापरतात. कृपया पुन्हा साइन इन करा. Instagram आणि Facebook समान Meta प्रोफाइल वापरतात. तुमचे जुने साइन-इन हटवले गेले नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl web kini menggunakan profil berasingan. Sila log masuk semula. Instagram dan Facebook menggunakan profil Meta yang sama. Log masuk lama anda belum dipadamkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettapper bruker nå separate profiler. Logg på igjen. Instagram og Facebook bruker samme Meta profil. De gamle påloggingene dine er ikke slettet."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब एपहरूले अब छुट्टै प्रोफाइलहरू प्रयोग गर्छन्। कृपया फेरि साइन इन गर्नुहोस्। Instagram र Facebook एउटै Meta प्रोफाइल प्रयोग गर्नुहोस्। तपाईंको पुरानो साइन-इनहरू मेटिएका छैनन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Webapps gebruiken nu aparte profielen. Meld u opnieuw aan. Instagram en Facebook gebruiken hetzelfde Meta profiel. Uw oude aanmeldingen zijn niet verwijderd."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ୱେବ୍ ଆପ୍ ବର୍ତ୍ତମାନ ପୃଥକ ପ୍ରୋଫାଇଲ୍ ବ୍ୟବହାର କରେ | ଦୟାକରି ପୁନର୍ବାର ସାଇନ୍ ଇନ୍ କରନ୍ତୁ | Instagram ଏବଂ Facebook ସମାନ Meta ପ୍ରୋଫାଇଲ୍ ବ୍ୟବହାର କରନ୍ତୁ | ତୁମର ପୁରୁଣା ସାଇନ୍-ଇନ୍ ଡିଲିଟ୍ ହୋଇନାହିଁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੈੱਬ ਐਪਸ ਹੁਣ ਵੱਖਰੇ ਪ੍ਰੋਫਾਈਲਾਂ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹਨ। ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਸਾਈਨ ਇਨ ਕਰੋ। Instagram ਅਤੇ Facebook ਇੱਕੋ Meta ਪ੍ਰੋਫਾਈਲ ਦੀ ਵਰਤੋਂ ਕਰਦੇ ਹਨ। ਤੁਹਾਡੇ ਪੁਰਾਣੇ ਸਾਈਨ-ਇਨ ਨੂੰ ਮਿਟਾਇਆ ਨਹੀਂ ਗਿਆ ਹੈ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ویب ایپس ہن وکھرے پروفائلز ورتدیاں نیں۔ مہربانی کر کے دوبارہ سائن ان کرو۔ Instagram تے Facebook اکو Meta پروفائل ورتدے ہن۔ ۔\""
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Web apps dey use separate profiles now. Abeg sign in again. Instagram and Facebook dey use the same Meta profile; your old sign-ins never delete."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje internetowe korzystają teraz z oddzielnych profili. Zaloguj się ponownie. Instagram i Facebook używają tego samego profilu Meta. Twoje stare dane logowania nie zostały usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os aplicativos da Web agora usam perfis separados. Faça login novamente. Instagram e Facebook usam o mesmo perfil Meta. Seus logins antigos não foram excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As aplicações Web utilizam agora perfis separados. Faça login novamente. Instagram e Facebook utilizam o mesmo perfil Meta. Os seus logins antigos não foram excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile web folosesc acum profiluri separate. Vă rugăm să vă conectați din nou. Instagram și Facebook folosesc același profil Meta. Conectările dvs. vechi nu au fost șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-приложения теперь используют отдельные профили. Нужно один раз войти заново. Instagram и Facebook используют общий профиль Meta; прежние данные входа не удалены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Webové aplikácie teraz používajú samostatné profily. Prihláste sa znova. Instagram a Facebook používajú rovnaký profil Meta. Vaše staré prihlásenia neboli odstránené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spletne aplikacije zdaj uporabljajo ločene profile. Prosimo, prijavite se znova. Instagram in Facebook uporabljata isti profil Meta. Vaše stare prijave niso bile izbrisane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webbappar använder nu separata profiler. Logga in igen. Instagram och Facebook använder samma Meta profil. Dina gamla inloggningar har inte raderats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Programu za wavuti sasa zinatumia wasifu tofauti. Tafadhali ingia tena. Instagram na Facebook hutumia wasifu Meta sawa. Uingiaji wako wa zamani haujafutwa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலை பயன்பாடுகள் இப்போது தனி சுயவிவரங்களைப் பயன்படுத்துகின்றன. மீண்டும் உள்நுழையவும். Instagram மற்றும் Facebook அதே Meta சுயவிவரத்தைப் பயன்படுத்துகின்றன. உங்கள் பழைய உள்நுழைவுகள் நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెబ్ యాప్‌లు ఇప్పుడు ప్రత్యేక ప్రొఫైల్‌లను ఉపయోగిస్తున్నాయి. దయచేసి మళ్లీ సైన్ ఇన్ చేయండి. Instagram మరియు Facebook ఒకే Meta ప్రొఫైల్‌ను ఉపయోగిస్తాయి. మీ పాత సైన్-ఇన్‌లు తొలగించబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้เว็บแอปใช้โปรไฟล์แยกกัน กรุณาเข้าสู่ระบบอีกครั้ง Instagram และ Facebook ใช้โปรไฟล์ Meta เดียวกัน การลงชื่อเข้าใช้เก่าของคุณยังไม่ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web uygulamaları artık ayrı profiller kullanıyor. Lütfen tekrar oturum açın. Instagram ve Facebook aynı Meta profilini kullanıyor. Eski oturum açma bilgileriniz silinmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веб-програми тепер використовують окремі профілі. Увійдіть знову. Instagram та Facebook використовують той самий профіль Meta. Ваші старі входи не видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویب ایپس اب علیحدہ پروفائلز استعمال کرتی ہیں۔ براہ کرم دوبارہ سائن ان کریں۔ Instagram اور Facebook ایک ہی Meta پروفائل استعمال کرتے ہیں۔ آپ کے پرانے سائن ان حذف نہیں کیے گئے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng web hiện sử dụng cấu hình riêng biệt. Vui lòng đăng nhập lại. Instagram và Facebook sử dụng cùng một hồ sơ Meta. Thông tin đăng nhập cũ của bạn chưa bị xóa."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "網絡應用程式而家會用獨立嘅個人檔案。請再登入。 Instagram 同 Facebook 用同一個 Meta 個人檔案。你嘅舊登入仲未刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 应用程序现在使用单独的配置文件。请重新登录。 Instagram 和 Facebook 使用相同的 Meta 配置文件。您的旧登录信息尚未删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Web 應用程式現在使用單獨的設定檔。請重新登入。 Instagram 和 Facebook 使用相同的 Meta 設定檔。您的舊登入資訊尚未刪除。"
          }
        }
      }
    },
