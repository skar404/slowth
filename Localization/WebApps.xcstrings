    "Browser passkey access is awaiting Apple approval. Web apps remain Beta.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر وصول المتصفح إلى مفاتيح المرور موافقة Apple. لا تزال تطبيقات الويب في المرحلة التجريبية."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر وصول المتصفح إلى مفاتيح المرور موافقة Apple. لا تزال تطبيقات الويب في المرحلة التجريبية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Браўзер чакае, пакуль Apple зацвердзіць доступ да Passkey. Вэб-праграмы ўсё яшчэ знаходзяцца ў бэта-версіі."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজারটি Passkey-এ অ্যাক্সেস অনুমোদনের জন্য Apple এর জন্য অপেক্ষা করছে। ওয়েব অ্যাপ্লিকেশানগুলি এখনও বিটাতে রয়েছে৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El navegador està esperant que Apple aprovi l'accés a Passkey. Les aplicacions web encara estan en versió beta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlížeč čeká, až Apple schválí přístup k Passkey. Webové aplikace jsou stále ve verzi beta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Browseren venter på, at Apple godkender adgang til Passkey. Webapps er stadig i beta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff des Browsers auf Passkeys wartet auf die Genehmigung von Apple. Web-Apps bleiben in der Betaphase."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρόγραμμα περιήγησης περιμένει την Apple για να εγκρίνει την πρόσβαση στο Passkey. Οι εφαρμογές Ιστού είναι ακόμα σε έκδοση beta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser passkey access is awaiting Apple approval. Web apps remain Beta."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser passkey access is awaiting Apple approval. Web apps remain Beta."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser passkey access is awaiting Apple approval. Web apps remain Beta."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser passkey access is awaiting Apple approval. Web apps remain Beta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso del navegador a las llaves de acceso está pendiente de aprobación por parte de Apple. Las apps web siguen en fase beta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso del navegador a las llaves de acceso está pendiente de aprobación por parte de Apple. Las apps web siguen en fase beta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selain odottaa Apple-yhtiön hyväksyntää pääsyavainten käytölle. Verkkosovellukset ovat edelleen beetavaiheessa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang browser ay naghihintay para sa Apple upang aprubahan ang pag-access sa Passkey. Nasa beta pa rin ang mga web app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès du navigateur aux clés d’accès attend l’approbation d’Apple. Les apps web restent en version bêta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès du navigateur aux clés d’accès attend l’approbation d’Apple. Les apps web restent en version bêta."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બ્રાઉઝર Passkey ની ઍક્સેસ મંજૂર કરવા માટે Apple ની રાહ જોઈ રહ્યું છે. વેબ એપ્લિકેશન્સ હજુ પણ બીટામાં છે."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai binciken yana jiran Apple don amincewa da damar zuwa Passkey. Ka'idodin yanar gizo har yanzu suna cikin beta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדפדפן ממתין ל-Apple כדי לאשר גישה ל-Passkey. אפליקציות אינטרנט עדיין בגרסת בטא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र Passkey तक पहुंच स्वीकृत करने के लिए Apple की प्रतीक्षा कर रहा है। वेब ऐप्स अभी भी बीटा में हैं."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preglednik čeka da Apple odobri pristup Passkey. Web aplikacije još su u beta fazi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A böngésző arra vár, hogy Apple jóváhagyja a Passkey hozzáférését. A webalkalmazások még béta állapotban vannak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զննարկիչը սպասում է Apple-ին, որպեսզի հաստատի մուտքը Passkey: Վեբ հավելվածները դեռ բետա փուլում են:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser menunggu Apple untuk menyetujui akses ke Passkey. Aplikasi web masih dalam versi beta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso del browser alle passkey è in attesa dell’approvazione di Apple. Le app web rimangono in versione beta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザからのパスキーへのアクセスはAppleの承認待ちです。Webアプリは引き続きベータ版です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბრაუზერი ელოდება Apple-ს, რათა დაამტკიცოს წვდომა Passkey-ზე. ვებ აპები ჯერ კიდევ ბეტა რეჟიმშია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер Apple рұқсатын Passkey мақұлдауын күтуде. Веб қолданбалар әлі бета нұсқасында."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬ್ರೌಸರ್ Passkey ಗೆ ಪ್ರವೇಶವನ್ನು ಅನುಮೋದಿಸಲು Apple ಗಾಗಿ ಕಾಯುತ್ತಿದೆ. ವೆಬ್ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು ಇನ್ನೂ ಬೀಟಾದಲ್ಲಿವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저의 패스키 접근 권한은 Apple의 승인을 기다리고 있습니다. 웹 앱은 아직 베타 버전입니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер Apple Passkey кирүүсүнө уруксат беришин күтүп жатат. Веб колдонмолор дагы эле бета версиясында."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naršyklė laukia, kol Apple patvirtins prieigą prie Passkey. Žiniatinklio programos vis dar yra beta versijos."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്രൗസർ Passkey എന്നതിലേക്കുള്ള ആക്‌സസ്സ് അംഗീകരിക്കുന്നതിന് Apple കാത്തിരിക്കുന്നു. വെബ് ആപ്പുകൾ ഇപ്പോഴും ബീറ്റയിലാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउझर Passkey मध्ये प्रवेश मंजूर करण्यासाठी Apple ची वाट पाहत आहे. वेब ॲप्स अद्याप बीटामध्ये आहेत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyemak imbas sedang menunggu Apple untuk meluluskan akses kepada Passkey. Apl web masih dalam versi beta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettleseren venter på at Apple skal godkjenne tilgang til Passkey. Nettapper er fortsatt i beta."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउजरले Apple लाई Passkey मा पहुँच अनुमोदनको लागि पर्खिरहेको छ। वेब एपहरू अझै बिटामा छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De browser wacht tot Apple de toegang tot Passkey goedkeurt. Webapps bevinden zich nog in de bètafase."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey କୁ ପ୍ରବେଶ ଅନୁମୋଦନ କରିବାକୁ ବ୍ରାଉଜର Apple ଅପେକ୍ଷା କରିଛି | ୱେବ୍ ଆପ୍ ଗୁଡିକ ବିଟା ରେ ଅଛି |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬ੍ਰਾਊਜ਼ਰ Passkey ਤੱਕ ਪਹੁੰਚ ਨੂੰ ਮਨਜ਼ੂਰੀ ਦੇਣ ਲਈ Apple ਦੀ ਉਡੀਕ ਕਰ ਰਿਹਾ ਹੈ। ਵੈੱਬ ਐਪਸ ਅਜੇ ਵੀ ਬੀਟਾ ਵਿੱਚ ਹਨ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "براؤزر Apple دا انتظار کر رہیا اے تاکہ اوہ Passkey تک رسائی دی منظوری دے سکے۔ ویب ایپس ہلے وی بیٹا چ ہن۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
