    "Live Activity unavailable. The pause still follows its own timer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشاط المباشر غير متاح. لا يزال الإيقاف المؤقت يتبع مؤقته الخاص."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "النشاط المباشر غير متاح. لا يزال الإيقاف المؤقت يتبع مؤقته الخاص."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Жывая дзейнасць недаступная. Паўза па-ранейшаму ідзе па ўласным таймеры."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ কার্যকলাপ অনুপলব্ধ. বিরতি এখনও তার নিজস্ব টাইমার অনুসরণ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živá aktivita není k dispozici. Pauza stále následuje po vlastním časovači."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveaktivitet er ikke tilgængelig. Pausen følger stadig sin egen timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität nicht verfügbar. Der Timer der Pause läuft unabhängig weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity unavailable. The pause still follows its own timer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad en vivo no disponible. La pausa sigue su propio cronómetro."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang Live na Aktibidad. Sinusundan pa rin ng pause ang sarili nitong timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activité en direct indisponible. La pause suit toujours sa propre minuterie."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu Ayyukan Rayuwa. Dakatarwar har yanzu tana bin nata mai ƙidayar lokaci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעילות חיה לא זמינה. ההפסקה עדיין עוקבת אחר הטיימר שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव गतिविधि अनुपलब्ध. विराम अभी भी अपने स्वयं के टाइमर का अनुसरण करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő tevékenység nem érhető el. A szünet továbbra is a saját időzítőjét követi."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity-ն անհասանելի է: Դադարը դեռ հետևում է իր ժամանակաչափին:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitas Langsung tidak tersedia. Jeda tersebut masih mengikuti pengatur waktunya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attività dal vivo non disponibile. La pausa segue ancora il proprio timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティは利用できません。一時停止は依然として独自のタイマーに従います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პირდაპირი აქტივობა მიუწვდომელია. პაუზა მაინც მიჰყვება საკუთარ ტაიმერს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тікелей әрекет қолжетімсіз. Үзіліс әлі де өз таймеріне сәйкес келеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 활동을 사용할 수 없습니다. 일시 중지는 여전히 자체 타이머를 따릅니다."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жандуу аракет жеткиликсиз. Тыныгуу дагы эле өзүнүн таймерине ылайык келет."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiesioginė veikla nepasiekiama. Pauzė vis tiek seka savo laikmatį."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थेट क्रियाकलाप अनुपलब्ध. विराम अजूनही स्वतःचा टाइमर फॉलो करतो."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्यक्ष गतिविधि अनुपलब्ध। पजले अझै पनि आफ्नै टाइमर पछ्याउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live activiteit niet beschikbaar. De pauze volgt nog steeds zijn eigen timer."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "براہ راست سرگرمی دستیاب نئیں اے۔ وقفہ ہُن وی اپنے ٹائمر دی پیروی کردا اے۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity no dey available. Di pause still dey follow im own timer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywność na żywo jest niedostępna. Pauza nadal ma swój własny licznik czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividade ao vivo indisponível. A pausa ainda segue seu próprio cronômetro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividade ao vivo indisponível. A pausa ainda segue o seu próprio cronómetro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activitate live indisponibilă. Pauza urmează în continuare propriul cronometru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity недоступна. Пауза продолжает действовать по своему таймеру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveaktivitet är inte tillgänglig. Pausen följer fortfarande sin egen timer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shughuli ya Moja kwa Moja haipatikani. Usitishaji bado unafuata kipima muda chake chenyewe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரலை செயல்பாடு கிடைக்கவில்லை. இடைநிறுத்தம் அதன் சொந்த டைமரை இன்னும் பின்பற்றுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రత్యక్ష కార్యాచరణ అందుబాటులో లేదు. పాజ్ ఇప్పటికీ దాని స్వంత టైమర్‌ను అనుసరిస్తోంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมสดไม่พร้อมใช้งาน การหยุดชั่วคราวยังคงตามตัวจับเวลาของมันเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı Etkinlik kullanılamıyor. Duraklatma hâlâ kendi zamanlayıcısını takip ediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жива активність недоступна. Пауза все ще слідує за власним таймером."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لائیو سرگرمی دستیاب نہیں ہے۔ وقفہ اب بھی اپنے ٹائمر کی پیروی کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động trực tiếp không có sẵn. Việc tạm dừng vẫn theo bộ đếm thời gian của chính nó."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "即時活動唔可用。暫停仍然跟住佢自己嘅計時器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时活动不可用。暂停仍然遵循其自己的计时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時活動不可用。暫停仍然遵循自己的計時器。"
          }
        }
      },
      "extractionState": "manual"
    },
