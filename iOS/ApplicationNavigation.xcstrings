    "Recording was interrupted. Stop the old recording if it is still shown by iOS, then start recording again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع التسجيل. إذا كان iOS لا يزال يعرض التسجيل السابق، فأوقفه ثم ابدأ التسجيل مجددًا."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع التسجيل. إذا كان iOS لا يزال يعرض التسجيل السابق، فأوقفه ثم ابدأ التسجيل مجددًا."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запіс перапыніўся. Калі iOS яшчэ паказвае папярэдні запіс, спыніце яго, а потым пачніце запіс нанова."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং বাধাপ্রাপ্ত হয়েছে। iOS-এ আগের রেকর্ডিং এখনও দেখা গেলে সেটি বন্ধ করে আবার রেকর্ডিং শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La gravació s’ha interromput. Si iOS encara mostra la gravació anterior, atura-la i torna a iniciar la gravació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání bylo přerušeno. Pokud iOS stále zobrazuje předchozí nahrávání, zastavte ho a spusťte nahrávání znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen blev afbrudt. Hvis iOS stadig viser den gamle optagelse, skal du stoppe den og starte optagelsen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde unterbrochen. Falls iOS die alte Aufnahme noch anzeigt, beende sie und starte die Aufnahme erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή διακόπηκε. Αν το iOS εξακολουθεί να εμφανίζει την προηγούμενη εγγραφή, σταματήστε την και ξεκινήστε ξανά την εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. Stop the old recording if it is still shown by iOS, then start recording again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. Stop the old recording if it is still shown by iOS, then start recording again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. Stop the old recording if it is still shown by iOS, then start recording again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted. Stop the old recording if it is still shown by iOS, then start recording again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se interrumpió. Si iOS sigue mostrando la grabación anterior, detenla y vuelve a iniciar la grabación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se interrumpió. Si iOS sigue mostrando la grabación anterior, detenla y vuelve a iniciar la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus keskeytyi. Jos iOS näyttää vielä aiemman tallennuksen, lopeta se ja aloita tallennus uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naantala ang pag-record. Kung ipinapakita pa rin ng iOS ang dating pag-record, ihinto ito at magsimulang mag-record muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a été interrompu. Si iOS affiche encore l’ancien enregistrement, arrêtez-le, puis relancez l’enregistrement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a été interrompu. Si iOS affiche encore l’ancien enregistrement, arrêtez-le, puis relancez l’enregistrement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડિંગમાં વિક્ષેપ પડ્યો. જો iOS હજી પણ જૂનું રેકોર્ડિંગ બતાવતું હોય, તો તેને બંધ કરો અને ફરીથી રેકોર્ડિંગ શરૂ કરો."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An katse rikodi. Idan iOS har yanzu yana nuna tsohon rikodin, dakatar da shi sannan ka sake fara rikodi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה נקטעה. אם iOS עדיין מציג את ההקלטה הקודמת, יש לעצור אותה ולהתחיל להקליט מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग बाधित हो गई। अगर iOS अभी भी पुरानी रिकॉर्डिंग दिखा रहा है, तो उसे रोकें और फिर रिकॉर्डिंग शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimanje je prekinuto. Ako iOS i dalje prikazuje prethodno snimanje, zaustavite ga i ponovno pokrenite snimanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvétel megszakadt. Ha az iOS még mindig a korábbi felvételt jelzi, állítsd le, majd indítsd újra a felvételt."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսագրումն ընդհատվել է։ Եթե iOS-ը դեռ ցույց է տալիս նախորդ տեսագրումը, դադարեցրեք այն, ապա նորից սկսեք տեսագրումը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman terputus. Jika iOS masih menampilkan rekaman sebelumnya, hentikan lalu mulai merekam lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si è interrotta. Se iOS mostra ancora la registrazione precedente, interrompila e avvia di nuovo la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録画が中断されました。iOSに前の録画がまだ表示されている場合は停止してから、録画を開始し直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩაწერა შეწყდა. თუ iOS ჯერ კიდევ აჩვენებს წინა ჩაწერას, შეაჩერეთ ის და ხელახლა დაიწყეთ ჩაწერა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазу үзілді. iOS әлі де бұрынғы жазуды көрсетіп тұрса, оны тоқтатып, жазуды қайта бастаңыз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರೆಕಾರ್ಡಿಂಗ್‌ಗೆ ಅಡಚಣೆಯಾಯಿತು. iOS ಇನ್ನೂ ಹಿಂದಿನ ರೆಕಾರ್ಡಿಂಗ್ ತೋರಿಸುತ್ತಿದ್ದರೆ, ಅದನ್ನು ನಿಲ್ಲಿಸಿ ಮತ್ತೆ ರೆಕಾರ್ಡಿಂಗ್ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화가 중단되었습니다. iOS에 이전 녹화가 아직 표시되면 중지한 후 녹화를 다시 시작하세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаздыруу үзгүлтүккө учурады. Эгер iOS мурдагы жаздырууну дагы эле көрсөтүп жатса, аны токтотуп, жаздырууну кайра баштаңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrašymas nutrūko. Jei iOS vis dar rodo ankstesnį įrašymą, sustabdykite jį ir pradėkite įrašymą iš naujo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റെക്കോർഡിങ് തടസ്സപ്പെട്ടു. iOS ഇപ്പോഴും പഴയ റെക്കോർഡിങ് കാണിക്കുന്നുണ്ടെങ്കിൽ, അത് നിർത്തി വീണ്ടും റെക്കോർഡിങ് ആരംഭിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रेकॉर्डिंगमध्ये व्यत्यय आला. iOS अजूनही जुने रेकॉर्डिंग दाखवत असल्यास, ते थांबवा आणि पुन्हा रेकॉर्डिंग सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman terganggu. Jika iOS masih memaparkan rakaman lama, hentikannya kemudian mulakan rakaman semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptaket ble avbrutt. Hvis iOS fortsatt viser det gamle opptaket, stopper du det og starter opptaket på nytt."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रेकर्डिङ अवरुद्ध भयो। iOS ले अझै पुरानो रेकर्डिङ देखाइरहेको छ भने त्यसलाई रोकेर फेरि रेकर्डिङ सुरु गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is onderbroken. Als iOS de vorige opname nog weergeeft, stop deze dan en start de opname opnieuw."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରେକର୍ଡିଂ ବାଧାପ୍ରାପ୍ତ ହୋଇଛି। iOS ଯଦି ଏବେ ବି ପୁରୁଣା ରେକର୍ଡିଂ ଦେଖାଉଛି, ତାହାକୁ ବନ୍ଦ କରି ପୁଣି ରେକର୍ଡିଂ ଆରମ୍ଭ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਕਾਰਡਿੰਗ ਵਿੱਚ ਰੁਕਾਵਟ ਆਈ। ਜੇ iOS ਹਾਲੇ ਵੀ ਪੁਰਾਣੀ ਰਿਕਾਰਡਿੰਗ ਦਿਖਾ ਰਿਹਾ ਹੈ, ਤਾਂ ਉਸਨੂੰ ਰੋਕੋ ਅਤੇ ਰਿਕਾਰਡਿੰਗ ਮੁੜ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ رک گئی اے۔ جے iOS ہن وی پرانی ریکارڈنگ وکھا رہیا اے، اوہنوں روکو تے ریکارڈنگ فیر شروع کرو۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stop unexpectedly. If iOS still dey show the old recording, stop am, then start recording again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zostało przerwane. Jeśli iOS nadal pokazuje poprzednie nagrywanie, zatrzymaj je i rozpocznij nagrywanie ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida. Se o iOS ainda mostrar a gravação anterior, pare-a e inicie a gravação novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi interrompida. Se o iOS ainda mostrar a gravação anterior, pare-a e volte a iniciar a gravação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea a fost întreruptă. Dacă iOS încă afișează înregistrarea anterioară, oprește-o, apoi pornește înregistrarea din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись прервалась. Если iOS всё ещё показывает старую запись, остановите её, затем запустите запись заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávanie bolo prerušené. Ak iOS stále zobrazuje predchádzajúce nahrávanie, zastavte ho a spustite nahrávanie znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snemanje je bilo prekinjeno. Če iOS še vedno prikazuje prejšnje snemanje, ga ustavite in znova začnite snemati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen avbröts. Om iOS fortfarande visar den gamla inspelningen ska du stoppa den och starta inspelningen igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurekodi kumekatizwa. Ikiwa iOS bado inaonyesha rekodi ya awali, isimamishe kisha uanze kurekodi tena."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு தடைப்பட்டது. iOS இன்னும் பழைய பதிவைக் காட்டினால், அதை நிறுத்திவிட்டு மீண்டும் பதிவைத் தொடங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డింగ్‌కు అంతరాయం కలిగింది. iOS ఇంకా పాత రికార్డింగ్‌ను చూపిస్తే, దాన్ని ఆపి మళ్ళీ రికార్డింగ్ ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกถูกขัดจังหวะ หาก iOS ยังแสดงการบันทึกเดิมอยู่ ให้หยุดแล้วเริ่มบันทึกใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt kesildi. iOS hâlâ önceki kaydı gösteriyorsa durdurun ve kaydı yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис перервався. Якщо iOS досі показує попередній запис, зупиніть його, а потім почніть запис знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ریکارڈنگ میں خلل آ گیا۔ اگر iOS اب بھی پرانی ریکارڈنگ دکھا رہا ہے، تو اسے روک کر دوبارہ ریکارڈنگ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình ghi đã bị gián đoạn. Nếu iOS vẫn hiển thị phiên ghi cũ, hãy dừng phiên đó rồi bắt đầu ghi lại."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "錄影中斷咗。如果 iOS 仲顯示緊之前嘅錄影，請先停止，再重新開始錄影。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录屏已中断。如果 iOS 仍显示之前的录屏，请先停止，再重新开始录屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕錄製已中斷。如果 iOS 仍顯示先前的錄製，請先停止，再重新開始錄製。"
          }
        }
      }
    },
