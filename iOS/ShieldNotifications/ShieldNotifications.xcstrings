    "Tap Slowth, then open its notification. If no banner appears, check Notification Center or open Slowth manually.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على Slowth، ثم افتح إشعاره. إذا لم يظهر شعار، فتحقق من مركز الإشعارات أو افتح Slowth يدويًا."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على Slowth، وبعدين افتح إشعاره. لو مفيش بانر ظهر، شوف مركز الإشعارات أو افتح Slowth بنفسك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсні Slowth, затым адкрый яго апавяшчэнне. Калі банер не з’явіўся, правер Цэнтр апавяшчэнняў або адкрый Slowth уручную."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth-এ ট্যাপ করে তার বিজ্ঞপ্তি খুলুন। ব্যানার না দেখালে বিজ্ঞপ্তি কেন্দ্রে দেখুন বা নিজে Slowth খুলুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepni na Slowth a pak otevři jeho oznámení. Pokud se banner neobjeví, podívej se do Oznamovacího centra nebo otevři Slowth ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Slowth, og åbn derefter notifikationen. Hvis der ikke vises et banner, kan du se i Notifikationscenter eller åbne Slowth manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Slowth und öffne dann die Mitteilung. Erscheint kein Banner, sieh in der Mitteilungszentrale nach oder öffne Slowth manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth, then open its notification. If no banner appears, check Notification Center or open Slowth manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Slowth y luego abre su notificación. Si no aparece ningún aviso, revisa el Centro de notificaciones o abre Slowth manualmente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang Slowth, saka buksan ang notification nito. Kung walang banner, tingnan ang Notification Center o buksan ang Slowth nang manu-mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Slowth, puis ouvre sa notification. Si aucune bannière n’apparaît, consulte le Centre de notifications ou ouvre Slowth manuellement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Danna Slowth, sannan buɗe sanarwarsa. Idan sanarwar saman allo ba ta bayyana ba, duba Cibiyar Sanarwa ko buɗe Slowth da kanka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להקיש על Slowth ואז לפתוח את העדכון שלו. אם לא מופיע באנר, אפשר לבדוק במרכז העדכונים או לפתוח את Slowth ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth पर टैप करें, फिर उसकी सूचना खोलें। बैनर न दिखे तो सूचना केंद्र देखें या खुद Slowth खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a Slowth gombra, majd nyisd meg az értesítését. Ha nem jelenik meg szalagcím, nézd meg az Értesítési központot, vagy nyisd meg kézzel a Slowth appot."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սեղմիր Slowth, ապա բացիր դրա ծանուցումը։ Եթե պաստառ չի հայտնվում, ստուգիր Ծանուցումների կենտրոնը կամ բացիր Slowth-ը ձեռքով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Slowth, lalu buka pemberitahuannya. Jika banner tidak muncul, periksa Pusat Pemberitahuan atau buka Slowth secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Slowth, poi apri la sua notifica. Se non compare alcun banner, controlla il Centro Notifiche o apri Slowth manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Slowth」をタップしてから通知を開いてください。バナーが表示されない場合は、通知センターを確認するか、Slowthを手動で開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დააჭირე Slowth-ს, შემდეგ გახსენი მისი შეტყობინება. თუ ბანერი არ გამოჩნდა, შეამოწმე შეტყობინებების ცენტრი ან გახსენი Slowth ხელით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth түймесін басып, оның хабарландыруын аш. Баннер шықпаса, Хабарландырулар орталығын тексер немесе Slowth қолданбасын қолмен аш."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth를 탭한 다음 알림을 여세요. 배너가 표시되지 않으면 알림 센터를 확인하거나 Slowth를 직접 여세요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth баскычын басып, андан соң анын билдирмесин ач. Баннер көрүнбөсө, Билдирмелер борборун текшер же Slowth колдонмосун кол менен ач."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėk Slowth, tada atidaryk jos pranešimą. Jei reklamjuostė nepasirodo, patikrink Pranešimų centrą arba atidaryk Slowth rankiniu būdu."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth वर टॅप करा, मग त्याची सूचना उघडा. बॅनर दिसत नसल्यास सूचना केंद्र तपासा किंवा स्वतः Slowth उघडा."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth मा ट्याप गरेर त्यसको सूचना खोल्नुहोस्। ब्यानर नदेखिएमा सूचना केन्द्र हेर्नुहोस् वा आफैँ Slowth खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Slowth en open daarna de melding. Verschijnt er geen strook, kijk dan in het meldingencentrum of open Slowth handmatig."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth اُتے ٹیپ کرو، فیر اوہدی اطلاع کھولو۔ جے بینر نہ آوے، اطلاعواں دا مرکز ویکھو یا Slowth آپ کھولو۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth, then open the notification. If no banner show, check Notification Center or open Slowth by yourself."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Slowth, a następnie otwórz powiadomienie. Jeśli baner się nie pojawi, sprawdź Centrum powiadomień lub otwórz Slowth ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Slowth e depois abra a notificação. Se nenhum banner aparecer, confira a Central de Notificações ou abra o Slowth manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca em Slowth e depois abre a notificação. Se não aparecer uma faixa, consulta a Central de notificações ou abre o Slowth manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge Slowth, apoi deschide notificarea. Dacă nu apare un banner, verifică Centrul de notificări sau deschide Slowth manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми Slowth, затем открой уведомление. Если баннер не появился, проверь Центр уведомлений или открой Slowth вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Slowth och öppna sedan notisen. Om ingen banderoll visas, titta i Notiscenter eller öppna Slowth manuellt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa Slowth, kisha ufungue arifa yake. Bango lisipoonekana, angalia Kituo cha Arifa au ufungue Slowth mwenyewe."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth-ஐத் தட்டி, அதன் அறிவிப்பைத் திறக்கவும். பேனர் தோன்றாவிட்டால் அறிவிப்பு மையத்தைப் பார்க்கவும் அல்லது Slowth-ஐ நேரடியாகத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowthను ట్యాప్ చేసి దాని నోటిఫికేషన్ తెరవండి. బ్యానర్ కనిపించకపోతే నోటిఫికేషన్ సెంటర్‌లో చూడండి లేదా Slowthను నేరుగా తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ Slowth แล้วเปิดการแจ้งเตือน หากไม่มีแบนเนอร์ปรากฏ ให้ตรวจสอบศูนย์การแจ้งเตือนหรือเปิด Slowth เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth’a dokun, ardından bildirimi aç. Başlık görünmezse Bildirim Merkezi’ni kontrol et veya Slowth’u kendin aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни Slowth, а потім відкрий сповіщення. Якщо банер не з’явився, перевір Центр сповіщень або відкрий Slowth вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth پر ٹیپ کریں، پھر اس کی اطلاع کھولیں۔ بینر ظاہر نہ ہو تو مرکزِ اطلاعات دیکھیں یا Slowth خود کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào Slowth, rồi mở thông báo. Nếu không có biểu ngữ, hãy kiểm tra Trung tâm thông báo hoặc tự mở Slowth."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "撳 Slowth，再開啟佢嘅通知。如果冇橫額出現，可以睇吓通知中心，或者自己開啟 Slowth。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点 Slowth，然后打开它的通知。如果没有横幅，请查看通知中心或手动打开 Slowth。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下 Slowth，然後開啟其通知。如果沒有橫幅，請查看通知中心或手動開啟 Slowth。"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth, then open its notification. If no banner appears, check Notification Center or open Slowth manually."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth, then open its notification. If no banner appears, check Notification Center or open Slowth manually."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Slowth, then open its notification. If no banner appears, check Notification Center or open Slowth manually."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche Slowth, puis ouvre sa notification. Si aucune bannière n’apparaît, consulte le Centre de notifications ou ouvre Slowth manuellement."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Slowth y luego abre su notificación. Si no aparece ningún aviso, revisa el Centro de notificaciones o abre Slowth manualmente."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toqueu Slowth i, a continuació, obriu la seva notificació. Si no apareix cap bàner, comproveu el Centre de notificacions o obriu Slowth manualment."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Slowth και μετά ανοίξτε την ειδοποίησή του. Εάν δεν εμφανίζεται κανένα banner, ελέγξτε το Κέντρο ειδοποιήσεων ή ανοίξτε το Slowth χειροκίνητα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Slowth ja avaa sen ilmoitus. Jos banneria ei näy, tarkista Ilmoituskeskus tai avaa Slowth manuaalisesti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Slowth og åpne deretter varslingen. Hvis det ikke vises noe banner, sjekk Varslingssenter eller åpne Slowth manuelt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Slowth, kemudian buka pemberitahuannya. Jika tiada sepanduk muncul, semak Pusat Pemberitahuan atau buka Slowth secara manual."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite Slowth pa otvorite njegovu obavijest. Ako se baner ne pojavi, provjerite Centar za obavijesti ili ručno otvorite Slowth."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na Slowth a otvorte jeho hlásenie. Ak sa banner nezobrazí, skontrolujte Centrum hlásení alebo otvorte Slowth manuálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite Slowth in odprite njegovo obvestilo. Če se pasica ne prikaže, preverite Središče za obvestila ali odprite Slowth ročno."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ਉੱਤੇ ਟੈਪ ਕਰੋ, ਫਿਰ ਇਸ ਦੀ ਸੂਚਨਾ ਖੋਲ੍ਹੋ। ਜੇ ਬੈਨਰ ਨਾ ਆਵੇ, ਤਾਂ ਸੂਚਨਾ ਕੇਂਦਰ ਜਾਂਚੋ ਜਾਂ Slowth ਹੱਥੀਂ ਖੋਲ੍ਹੋ।"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth પર ટૅપ કરો, પછી તેની સૂચના ખોલો. બૅનર ન દેખાય તો સૂચના કેન્દ્ર તપાસો અથવા Slowth જાતે ખોલો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ಟ್ಯಾಪ್ ಮಾಡಿ, ನಂತರ ಅದರ ಅಧಿಸೂಚನೆ ತೆರೆಯಿರಿ. ಬ್ಯಾನರ್ ಕಾಣಿಸದಿದ್ದರೆ ಅಧಿಸೂಚನೆ ಕೇಂದ್ರ ಪರಿಶೀಲಿಸಿ ಅಥವಾ Slowth ಕೈಯಾರೆ ತೆರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ടാപ്പ് ചെയ്ത് അതിന്റെ അറിയിപ്പ് തുറക്കുക. ബാനർ കാണുന്നില്ലെങ്കിൽ അറിയിപ്പ് കേന്ദ്രം പരിശോധിക്കുക അല്ലെങ്കിൽ Slowth നേരിട്ട് തുറക്കുക."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth ଟ୍ୟାପ୍ କରି ଏହାର ସୂଚନା ଖୋଲନ୍ତୁ। ବ୍ୟାନର୍ ନ ଆସିଲେ ସୂଚନା କେନ୍ଦ୍ର ଯାଞ୍ଚ କରନ୍ତୁ କିମ୍ବା Slowth ନିଜେ ଖୋଲନ୍ତୁ।"
          }
        }
      }
    },
