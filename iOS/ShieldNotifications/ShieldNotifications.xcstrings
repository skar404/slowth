    "Allow banners in Settings. Focus may hide notifications; you can always open Slowth manually.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالشعارات في الإعدادات. قد يخفي التركيز الإشعارات؛ يمكنك دائمًا فتح Slowth يدويًا."
          }
        },
        "ar-EG": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالبانرات من الإعدادات. التركيز ممكن يخفي الإشعارات؛ تقدر دايمًا تفتح Slowth بنفسك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазволь банеры ў наладах. Факусаванне можа хаваць апавяшчэнні; Slowth заўсёды можна адкрыць уручную."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে ব্যানারের অনুমতি দিন। ফোকাস বিজ্ঞপ্তি লুকিয়ে রাখতে পারে; আপনি যেকোনো সময় নিজে Slowth খুলতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povol bannery v Nastavení. Soustředění může oznámení skrýt; Slowth můžeš vždy otevřít ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad bannere i Indstillinger. Fokus kan skjule notifikationer; du kan altid åbne Slowth manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Banner in den Einstellungen. Ein Fokus kann Mitteilungen ausblenden; du kannst Slowth jederzeit manuell öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow banners in Settings. Focus may hide notifications; you can always open Slowth manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las tiras en Ajustes. Un modo de concentración puede ocultar las notificaciones; siempre puedes abrir Slowth manualmente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang mga banner sa Settings. Maaaring itago ng Focus ang mga notification; puwede mong buksan ang Slowth nang manu-mano anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les bannières dans Réglages. Un mode de concentration peut masquer les notifications ; tu peux toujours ouvrir Slowth manuellement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba da izinin sanarwar saman allo a Saituna. Yanayin Mai da Hankali na iya ɓoye sanarwa; za ka iya buɗe Slowth da kanka a kowane lokaci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר באנרים בהגדרות. מצב ריכוז עשוי להסתיר עדכונים; תמיד אפשר לפתוח את Slowth ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ में बैनर की अनुमति दें। फ़ोकस सूचनाएँ छिपा सकता है; आप कभी भी खुद Slowth खोल सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a szalagcímeket a Beállításokban. A Fókusz elrejtheti az értesítéseket; a Slowth appot bármikor megnyithatod kézzel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարգավորումներում թույլատրիր պաստառները։ Կենտրոնացման ռեժիմը կարող է թաքցնել ծանուցումները․ Slowth-ը միշտ կարող ես բացել ձեռքով։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan banner di Pengaturan. Fokus dapat menyembunyikan pemberitahuan; kamu selalu bisa membuka Slowth secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti i banner in Impostazioni. Full immersion può nascondere le notifiche; puoi sempre aprire Slowth manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でバナーを許可してください。集中モードで通知が非表示になることがありますが、Slowthはいつでも手動で開けます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პარამეტრებში დაუშვი ბანერები. ფოკუსის რეჟიმმა შეიძლება შეტყობინებები დამალოს; Slowth-ის ხელით გახსნა ყოველთვის შეგიძლია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баптауларда баннерлерге рұқсат бер. Зейін режимі хабарландыруларды жасыруы мүмкін; Slowth қолданбасын әрқашан қолмен аша аласың."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 배너를 허용하세요. 집중 모드가 알림을 숨길 수 있지만, 언제든 Slowth를 직접 열 수 있어요."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жөндөөлөрдөн баннерлерге уруксат бер. Фокус режими билдирмелерди жашырышы мүмкүн; Slowth колдонмосун ар дайым кол менен ача аласың."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nustatymuose leisk reklamjuostes. Susikaupimo režimas gali slėpti pranešimus; Slowth visada gali atidaryti rankiniu būdu."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्जमध्ये बॅनरना परवानगी द्या. फोकस सूचना लपवू शकतो; तुम्ही कधीही स्वतः Slowth उघडू शकता."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिङहरूमा ब्यानरको अनुमति दिनुहोस्। फोकसले सूचनाहरू लुकाउन सक्छ; तपाईं जहिले पनि आफैँ Slowth खोल्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta stroken toe in Instellingen. Focus kan meldingen verbergen; je kunt Slowth altijd handmatig openen."
          }
        },
        "pa-Arab": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیباں وچ بینراں دی اجازت دیو۔ فوکس اطلاعواں لُکا سکدا اے؛ تسی Slowth ہمیشہ آپ کھول سکدے او۔"
          }
        },
        "pcm": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow banners for Settings. Focus fit hide notifications; you fit always open Slowth by yourself."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz banery w Ustawieniach. Tryb skupienia może ukrywać powiadomienia; zawsze możesz otworzyć Slowth ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita banners em Ajustes. O Foco pode ocultar notificações; você sempre pode abrir o Slowth manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite faixas nas Definições. A Concentração pode ocultar notificações; podes sempre abrir o Slowth manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite bannerele în Configurări. Modul Concentrare poate ascunde notificările; poți deschide oricând Slowth manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши баннеры в настройках. Фокусирование может скрывать уведомления; Slowth всегда можно открыть вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt banderoller i Inställningar. Fokus kan dölja notiser; du kan alltid öppna Slowth manuellt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu mabango katika Mipangilio. Hali ya Kuzingatia inaweza kuficha arifa; unaweza kufungua Slowth mwenyewe wakati wowote."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் பேனர்களை அனுமதிக்கவும். ஃபோகஸ் அறிவிப்புகளை மறைக்கலாம்; நீங்கள் எப்போதும் Slowth-ஐ நேரடியாகத் திறக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్‌లలో బ్యానర్‌లను అనుమతించండి. ఫోకస్ నోటిఫికేషన్‌లను దాచవచ్చు; మీరు ఎప్పుడైనా Slowthను నేరుగా తెరవవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตแบนเนอร์ในการตั้งค่า โฟกัสอาจซ่อนการแจ้งเตือน แต่คุณเปิด Slowth เองได้เสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’da başlıklara izin ver. Odak, bildirimleri gizleyebilir; Slowth’u her zaman kendin açabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволь банери в параметрах. Зосередження може приховувати сповіщення; Slowth завжди можна відкрити вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیبات میں بینرز کی اجازت دیں۔ فوکس اطلاعات چھپا سکتا ہے؛ آپ ہمیشہ Slowth خود کھول سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép biểu ngữ trong Cài đặt. Chế độ Tập trung có thể ẩn thông báo; bạn luôn có thể tự mở Slowth."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "喺「設定」允許橫額。「專注模式」可能會隱藏通知；你隨時都可以自己開啟 Slowth。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许横幅。专注模式可能会隐藏通知；你随时可以手动打开 Slowth。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許橫幅。專注模式可能會隱藏通知；你隨時可以手動開啟 Slowth。"
          }
        }
      }
    },
