        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To find short videos inside apps, start screen recording separately from di Apps tab. To allow Screen Time no go start recording."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wykryć krótkie filmy w aplikacjach, rozpocznij nagrywanie ekranu oddzielnie od karty Aplikacje. Zezwolenie na czas przed ekranem nie powoduje rozpoczęcia nagrywania."
