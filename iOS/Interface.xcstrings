    "Slowth analyzes your screen, including other apps, on this device. Audio is ignored." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم Slowth بتحليل شاشتك، بما في ذلك التطبيقات الأخرى، على هذا الجهاز. يتم تجاهل الصوت."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم Slowth بتحليل شاشتك، بما في ذلك التطبيقات الأخرى، على هذا الجهاز. يتم تجاهل الصوت."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slowth аналізуе ваш экран, у тым ліку іншыя праграмы, на гэтай прыладзе. Аўдыё ігнаруецца."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
