        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön választhatja ki az alkalmazásokat és a védelmi beállításokat. A képernyőrögzítés egy külön lépés, amelyet saját maga kezd el."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դուք ընտրում եք հավելվածները և պաշտպանության կարգավորումները: Էկրանի ձայնագրումը առանձին քայլ է, որը դուք սկսում եք ինքներդ:"
