        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऐप्स और सुरक्षा सेटिंग्स चुनें। स्क्रीन रिकॉर्डिंग एक अलग चरण है जिसे आप स्वयं शुरू करते हैं।"
