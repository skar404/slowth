    "Choose what distracts you. Slowth helps you take a break from short videos and stories." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يشتت انتباهك. يساعدك Slowth على أخذ استراحة من مقاطع الفيديو والقصص القصيرة."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يشتت انتباهك. يساعدك Slowth على أخذ استراحة من مقاطع الفيديو والقصص القصيرة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберыце тое, што вас адцягвае. Slowth дапаможа вам адпачыць ад кароткіх відэа і гісторый."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা আপনাকে বিভ্রান্ত করে তা বেছে নিন। Slowth আপনাকে ছোট ভিডিও এবং গল্প থেকে বিরতি নিতে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte si, co vás rozptyluje. Slowth vám pomůže odpočinout si od krátkých videí a příběhů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvad der distraherer dig. Slowth hjælper dig med at tage en pause fra korte videoer og historier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle aus, was dich ablenkt. Slowth hilft dir, eine Pause von Kurzvideos und Storys zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what distracts you. Slowth helps you take a break from short videos and stories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige lo que te distraiga. Slowth te ayuda a tomar un descanso de las historias y videos cortos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung ano ang nakakagambala sa iyo. Tinutulungan ka ng Slowth na magpahinga mula sa mga maiikling video at kwento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce qui vous distrait. Slowth vous aide à faire une pause dans les courtes vidéos et histoires."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabi abin da ke dauke hankalin ku. Slowth yana taimaka muku ku huta daga gajerun bidiyoyi da labarai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר מה מסיח את דעתך. Slowth עוזר לך לקחת הפסקה מסרטונים וסיפורים קצרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह चुनें जो आपका ध्यान भटकाता हो। Slowth आपको लघु वीडियो और कहानियों से ब्रेक लेने में मदद करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki azt, ami elvonja a figyelmét. A Slowth segít pihenni a rövid videók és történetek előtt."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրեք այն, ինչը ձեզ շեղում է։ Slowth-ն օգնում է ձեզ ընդմիջել կարճ տեսանյութերից և պատմություններից:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang mengalihkan perhatian Anda. Slowth membantu Anda beristirahat dari video dan cerita pendek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa ti distrae. Slowth ti aiuta a prenderti una pausa da brevi video e storie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気を散らすものを選択してください。 Slowth は、短いビデオやストーリーから休憩するのに役立ちます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "აირჩიე ის, რაც ყურადღებას გაფანტავს. Slowth დაგეხმარებათ დაისვენოთ მოკლე ვიდეოებისა და ისტორიებისგან."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сізді алаңдататын нәрсені таңдаңыз. Slowth қысқа бейнелер мен оқиғалардан үзіліс жасауға көмектеседі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주의를 산만하게 하는 것을 선택하세요. Slowth는 짧은 영상과 스토리에서 잠시 쉬어갈 수 있도록 도와줍니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сизди алаксыткан нерсени тандаңыз. Slowth кыска видеолордон жана окуялардан тыныгууга жардам берет."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasirinkite tai, kas blaško jūsų dėmesį. Slowth padeda pailsėti nuo trumpų vaizdo įrašų ir istorijų."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपले लक्ष विचलित करते ते निवडा. Slowth तुम्हाला लहान व्हिडिओ आणि कथांमधून विश्रांती घेण्यास मदत करते."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईलाई विचलित गर्ने कुरा छान्नुहोस्। Slowth ले तपाईंलाई छोटो भिडियो र कथाहरूबाट विश्राम लिन मद्दत गर्दछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat je afleidt. Slowth helpt je een pauze te nemen van korte video's en verhalen."
          }
        },
        "pa-Arab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوہ چیز چنو جہڑی تہانوں مشغول کردی اے۔ Slowth تہانوں مختصر ویڈیوز تے کہانیاں توں وقفہ لین چ مدد کردا اے۔"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose wetin dey distract you. Slowth dey help you rest from short videos and stories."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz to, co Cię rozprasza. Slowth pomoże Ci odpocząć od krótkich filmów i historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que distrai você. Slowth ajuda você a fazer uma pausa em vídeos e histórias curtas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que o distrai. Slowth ajuda-o a fazer uma pausa em vídeos e histórias curtas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți ceea ce vă distrage atenția. Slowth vă ajută să faceți o pauză de la videoclipuri și povești scurte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что вас отвлекает. Slowth поможет отдохнуть от коротких видео и историй."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj det som distraherar dig. Slowth hjälper dig att ta en paus från korta videor och berättelser."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chagua kile kinachokusumbua. Slowth hukusaidia kuchukua mapumziko kutoka kwa video na hadithi fupi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களை திசைதிருப்புவதைத் தேர்ந்தெடுங்கள். Slowth சிறிய வீடியோக்கள் மற்றும் கதைகளிலிருந்து ஓய்வு எடுக்க உதவுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మిమ్మల్ని కలవరపరిచే వాటిని ఎంచుకోండి. Slowth మీకు చిన్న వీడియోలు మరియు కథనాల నుండి విరామం తీసుకోవడంలో సహాయపడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่กวนใจคุณ Slowth ช่วยให้คุณหยุดพักจากวิดีโอและเรื่องราวสั้น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikkatinizi neyin dağıttığını seçin. Slowth kısa videolara ve hikayelere ara vermenize yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть те, що вас відволікає. Slowth допоможе вам відпочити від коротких відео та історій."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب کریں جو آپ کو پریشان کرتا ہے۔ Slowth مختصر ویڈیوز اور کہانیوں سے وقفہ لینے میں آپ کی مدد کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn những gì làm bạn mất tập trung. Slowth giúp bạn thư giãn sau những đoạn video và câu chuyện ngắn."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揀啲令你分心嘅嘢。 Slowth 幫你休息一下短片同故事。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
