        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निवडलेली सामग्री आढळल्यावर Slowth ला संपूर्ण ॲप ब्लॉक करण्याची अनुमती देते."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयन गरिएको सामग्री पत्ता लाग्दा Slowth लाई सम्पूर्ण एप ब्लक गर्न अनुमति दिन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee kan Slowth de hele app blokkeren wanneer geselecteerde inhoud wordt gedetecteerd."
          }
        },
        "pa-Arab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدوں منتخب کردہ مواد دا پتہ چلدا اے تے Slowth نو پوری ایپ نو بلاک کرن دی اجازت دیندا اے۔"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E dey let Slowth block di whole app when e find content wey you choose."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umożliwia Slowth blokowanie całej aplikacji po wykryciu wybranej zawartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Slowth bloqueie todo o aplicativo quando o conteúdo selecionado for detectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o Slowth bloqueie toda a aplicação quando o conteúdo selecionado for detetado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite lui Slowth să blocheze întreaga aplicație atunci când este detectat conținutul selectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет Slowth блокировать всё приложение при обнаружении выбранного контента."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåter Slowth att blockera hela appen när valt innehåll upptäcks."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huruhusu Slowth kuzuia programu nzima maudhui yaliyochaguliwa yanapogunduliwa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்ந்தெடுக்கப்பட்ட உள்ளடக்கம் கண்டறியப்படும்போது முழு பயன்பாட்டையும் தடுக்க Slowth ஐ அனுமதிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకున్న కంటెంట్ గుర్తించబడినప్పుడు మొత్తం యాప్‌ను బ్లాక్ చేయడానికి Slowthని అనుమతిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ Slowth บล็อกทั้งแอปเมื่อตรวจพบเนื้อหาที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen içerik algılandığında Slowth'nin tüm uygulamayı engellemesine izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє Slowth блокувати всю програму під час виявлення вибраного вмісту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب مواد کا پتہ چلنے پر Slowth کو پوری ایپ کو بلاک کرنے کی اجازت دیتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Slowth chặn toàn bộ ứng dụng khi phát hiện nội dung đã chọn."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當偵測到所選內容嗰陣，允許 Slowth 封鎖整個應用程式。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
