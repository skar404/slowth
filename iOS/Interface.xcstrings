        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para detectar vídeos curtos dentro de aplicativos, inicie a gravação da tela separadamente na guia Aplicativos. Permitir Tempo de Uso não inicia uma gravação."
