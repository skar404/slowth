        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesammelte Blätter"
          }
        }
      }
    },
    "Unused leaves are saved after each day as a reward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused leaves are saved after each day as a reward."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неиспользованные листочки сохраняются после каждого дня как награда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungenutzte Blätter werden nach jedem Tag als Belohnung gesammelt."
          }
        }
      }
    },
    "Slowth analyzes your screen, including other apps, on this device. Audio is ignored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth analyzes your screen, including other apps, on this device. Audio is ignored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth анализирует экран, включая другие приложения, на вашем устройстве. Звук не используется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowth analysiert deinen Bildschirm einschließlich anderer Apps auf diesem Gerät. Audio wird ignoriert."
          }
        }
      }
    },
