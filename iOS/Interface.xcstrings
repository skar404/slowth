    },
    "The timer continues. No extra leaf is used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer continues. No extra leaf is used."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймер продолжит отсчёт. Дополнительный листочек не расходуется."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer läuft weiter. Es wird kein zusätzliches Blatt verbraucht."
          }
        }
      }
    },
    "Could not switch the paused app. Check the current pause and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not switch the paused app. Check the current pause and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сменить приложение. Проверьте текущую паузу и попробуйте снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte nicht gewechselt werden. Prüfe die aktuelle Pause und versuche es erneut."
          }
        }
      }
    },
