    "Content blocking is in development. For now, only pause mode is available." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظر المحتوى قيد التطوير. في الوقت الحالي، يتوفر وضع الإيقاف المؤقت فقط."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حظر المحتوى قيد التطوير. في الوقت الحالي، يتوفر وضع الإيقاف المؤقت فقط."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блакаванне кантэнту знаходзіцца ў распрацоўцы. Пакуль што даступны толькі рэжым паўзы."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিষয়বস্তু ব্লকিং উন্নয়নশীল. আপাতত, শুধুমাত্র পজ মোড উপলব্ধ।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokování obsahu je ve vývoji. Prozatím je k dispozici pouze režim pozastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indholdsblokering er under udvikling. Indtil videre er kun pausetilstand tilgængelig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Inhaltssperre ist in Entwicklung. Derzeit ist nur der Pausenmodus verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content blocking is in development. For now, only pause mode is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de contenido está en desarrollo. Por ahora, sólo está disponible el modo pausa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pag-block ng nilalaman ay nasa pagbuo. Sa ngayon, pause mode lang ang available."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le blocage de contenu est en cours de développement. Pour l'instant, seul le mode pause est disponible."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toshe abun ciki yana ci gaba. A yanzu, yanayin dakatarwa kawai yana samuwa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חסימת תוכן נמצאת בפיתוח. לעת עתה, רק מצב השהייה זמין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री अवरोधन विकास में है. अभी के लिए, केवल पॉज़ मोड उपलब्ध है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tartalomblokkolás fejlesztés alatt áll. Egyelőre csak a szünet mód áll rendelkezésre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
