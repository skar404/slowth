    "You choose the apps and protection settings. Screen recording is a separate step that you start yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخترت التطبيقات وإعدادات الحماية. يعد تسجيل الشاشة خطوة منفصلة تبدأها بنفسك."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخترت التطبيقات وإعدادات الحماية. يعد تسجيل الشاشة خطوة منفصلة تبدأها بنفسك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выбіраеце праграмы і параметры абароны. Запіс экрана - гэта асобны крок, які вы пачынаеце самастойна."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অ্যাপ্লিকেশন এবং সুরক্ষা সেটিংস চয়ন করুন৷ স্ক্রীন রেকর্ডিং একটি পৃথক পদক্ষেপ যা আপনি নিজেই শুরু করেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberete si aplikace a nastavení ochrany. Nahrávání obrazovky je samostatný krok, který začnete sami."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vælger apps og beskyttelsesindstillinger. Skærmoptagelse er et separat trin, som du selv starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wählst die Apps und Schutzeinstellungen aus. Die Bildschirmaufnahme startest du selbst in einem separaten Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose the apps and protection settings. Screen recording is a separate step that you start yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges las aplicaciones y la configuración de protección. La grabación de pantalla es un paso independiente que usted mismo inicia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipiliin mo ang mga app at mga setting ng proteksyon. Ang pag-record ng screen ay isang hiwalay na hakbang na ikaw mismo ang magsisimula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisissez les applications et les paramètres de protection. L'enregistrement d'écran est une étape distincte que vous démarrez vous-même."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za ka zaɓi apps da saitunan kariya. Rikodin allo wani mataki ne daban wanda ka fara da kanka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה בוחר את האפליקציות ואת הגדרות ההגנה. הקלטת מסך היא שלב נפרד שאתה מתחיל בעצמך."
