    "Screen Time access was not granted. You can try again or continue without app protection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم منح الوصول إلى مدة استخدام الجهاز. يمكنك المحاولة مرة أخرى أو المتابعة بدون حماية التطبيق."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم منح الوصول إلى مدة استخدام الجهاز. يمكنك المحاولة مرة أخرى أو المتابعة بدون حماية التطبيق."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ да экраннага часу не быў прадастаўлены. Вы можаце паўтарыць спробу або працягнуць без абароны праграмы."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিন টাইম অ্যাক্সেস দেওয়া হয়নি। আপনি আবার চেষ্টা করতে পারেন বা অ্যাপ সুরক্ষা ছাড়াই চালিয়ে যেতে পারেন।"
