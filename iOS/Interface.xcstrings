    "Enable the Safari extension separately to hide distracting content on websites. Screen Time is not required for Safari." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتفعيل الامتداد Safari بشكل منفصل لإخفاء المحتوى المشتت للانتباه على مواقع الويب. مدة استخدام الجهاز غير مطلوب لـ Safari."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتفعيل الامتداد Safari بشكل منفصل لإخفاء المحتوى المشتت للانتباه على مواقع الويب. مدة استخدام الجهاز غير مطلوب لـ Safari."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уключыце пашырэнне Safari асобна, каб схаваць адцягваючы змесціва на вэб-сайтах. Час экрана не патрабуецца для Safari."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়েবসাইটগুলিতে বিভ্রান্তিকর বিষয়বস্তু লুকানোর জন্য আলাদাভাবে Safari এক্সটেনশন সক্রিয় করুন৷ Safari এর জন্য স্ক্রিন টাইম প্রয়োজন নেই।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samostatně povolte rozšíření Safari, abyste skryli rušivý obsah na webových stránkách. Čas obrazovky není pro Safari vyžadován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiver Safari-udvidelsen separat for at skjule distraherende indhold på websteder. Skærmtid er ikke påkrævet for Safari."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Safari-Erweiterung separat, um ablenkende Inhalte auf Websites auszublenden. Safari benötigt keine Bildschirmzeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable the Safari extension separately to hide distracting content on websites. Screen Time is not required for Safari."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite la extensión Safari por separado para ocultar contenido que distraiga en los sitios web. No se requiere Tiempo de uso para Safari."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paganahin ang Safari extension nang hiwalay upang itago ang nakakagambalang nilalaman sa mga website. Hindi kinakailangan ang Screen Time para sa Safari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l'extension Safari séparément pour masquer le contenu gênant sur les sites Web. Le temps d’écran n’est pas requis pour Safari."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunna tsawo na Safari daban don ɓoye abun ciki mai raba hankali akan gidajen yanar gizo. Ba a buƙatar lokacin allo don Safari."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר את התוסף Safari בנפרד כדי להסתיר תוכן מסיח את הדעת באתרי אינטרנט. זמן מסך אינו נדרש עבור Safari."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेबसाइटों पर ध्यान भटकाने वाली सामग्री को छिपाने के लिए Safari एक्सटेंशन को अलग से सक्षम करें। Safari के लिए स्क्रीन टाइम की आवश्यकता नहीं है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezze külön a Safari bővítményt, hogy elrejtse a zavaró tartalmat a webhelyeken. A Safari esetében nincs szükség képernyőidőre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Միացրեք Safari ընդլայնումը առանձին՝ կայքերում ուշադրությունը շեղող բովանդակությունը թաքցնելու համար: Էկրանի ժամանակ չի պահանջվում Safari-ի համար:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan ekstensi Safari secara terpisah untuk menyembunyikan konten yang mengganggu di situs web. Durasi Layar tidak diperlukan untuk Safari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita l'estensione Safari separatamente per nascondere contenuti che distraggono sui siti web. Il Tempo di utilizzo non è richiesto per Safari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 拡張機能を個別に有効にして、Web サイト上の邪魔なコンテンツを非表示にします。 Safari にはスクリーンタイムは必要ありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ცალ-ცალკე ჩართეთ Safari გაფართოება ვებსაიტებზე ყურადღების გამფანტველი შინაარსის დასამალად. ეკრანის დრო არ არის საჭირო Safari-სთვის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веб-сайттардағы алаңдататын мазмұнды жасыру үшін Safari кеңейтімін бөлек қосыңыз. Safari үшін экран уақыты талап етілмейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹사이트에서 방해가 되는 콘텐츠를 숨기려면 Safari 확장 프로그램을 별도로 활성화하세요. Safari에는 스크린 타임이 필요하지 않습니다."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вебсайттардагы алаксыткан мазмунду жашыруу үчүн Safari кеңейтүүсүн өзүнчө иштетиңиз. Safari үчүн экран убактысы талап кылынбайт."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atskirai įgalinkite plėtinį Safari, kad paslėptumėte dėmesį blaškantį turinį svetainėse. Safari ekrano laikas nereikalingas."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेबसाइटवर विचलित करणारी सामग्री लपवण्यासाठी स्वतंत्रपणे Safari विस्तार सक्षम करा. Safari साठी स्क्रीन टाइम आवश्यक नाही."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेबसाइटहरूमा ध्यान भंग गर्ने सामग्री लुकाउनको लागि अलग-अलग Safari विस्तार सक्षम गर्नुहोस्। Safari को लागि स्क्रिन टाइम आवश्यक छैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel de Safari-extensie afzonderlijk in om afleidende inhoud op websites te verbergen. Schermtijd is niet vereist voor Safari."
          }
        },
        "pa-Arab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویب سائٹاں تے مشغول کرن آلے مواد نو لُکان لئی Safari ایکسٹینشن نو الگ الگ فعال کرو۔ Safari لئی سکرین ٹائم دی لوڑ نئیں اے۔"
          }
        },
        "pcm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on di Safari extension separately to hide things wey dey distract you for websites. Safari no need Screen Time."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz oddzielnie rozszerzenie Safari, aby ukryć rozpraszające treści na stronach internetowych. Czas ekranu nie jest wymagany w przypadku Safari."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilite a extensão Safari separadamente para ocultar conteúdo que distrai em sites. O Tempo de Uso não é necessário para Safari."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active a extensão Safari separadamente para ocultar o conteúdo que distrai nos sites. O Tempo de ecrã não é necessário para Safari."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați extensia Safari separat pentru a ascunde conținutul care distrag atenția pe site-uri web. Timpul de ecran nu este necesar pentru Safari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите расширение Safari отдельно, чтобы скрывать отвлекающий контент на сайтах. Для Safari не требуется Экранное время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera tillägget Safari separat för att dölja distraherande innehåll på webbplatser. Skärmtid krävs inte för Safari."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Washa kiendelezi cha Safari kando ili kuficha maudhui yanayosumbua kwenye tovuti. Muda wa Skrini hauhitajiki kwa Safari."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வலைத்தளங்களில் கவனத்தை சிதறடிக்கும் உள்ளடக்கத்தை மறைக்க Safari நீட்டிப்பை தனித்தனியாக இயக்கவும். Safari க்கு திரை நேரம் தேவையில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వెబ్‌సైట్‌లలో అపసవ్య కంటెంట్‌ను దాచడానికి Safari పొడిగింపును విడిగా ప్రారంభించండి. Safari కోసం స్క్రీన్ సమయం అవసరం లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานส่วนขยาย Safari แยกกันเพื่อซ่อนเนื้อหาที่รบกวนสมาธิบนเว็บไซต์ ไม่จำเป็นต้องใช้เวลาหน้าจอสำหรับ Safari"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web sitelerindeki dikkat dağıtıcı içeriği gizlemek için Safari uzantısını ayrı olarak etkinleştirin. Safari için Ekran Süresi gerekli değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть розширення Safari окремо, щоб приховати відволікаючий вміст на веб-сайтах. Час екрану не потрібен для Safari."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویب سائٹس پر پریشان کن مواد کو چھپانے کے لیے Safari ایکسٹینشن کو الگ سے فعال کریں۔ Safari کے لیے اسکرین ٹائم درکار نہیں ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt riêng tiện ích mở rộng Safari để ẩn nội dung gây mất tập trung trên các trang web. Thời gian sử dụng màn hình không bắt buộc đối với Safari."
          }
        },
        "yue" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨啟用 Safari 擴充程式，嚟隱藏網站上面嘅分散注意力內容。 Safari 唔需要螢幕使用時間。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独启用 Safari 扩展以隐藏网站上分散注意力的内容。 Safari 不需要屏幕使用时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單獨啟用 Safari 擴充功能以隱藏網站上分散注意力的內容。 Safari 不需要螢幕使用時間。"
          }
        }
      }
    },
