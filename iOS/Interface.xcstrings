    "Unused leaves are saved after each day as a reward." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ الأوراق غير المستخدمة بعد كل يوم كمكافأة."
          }
        },
        "ar-EG" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ الأوراق غير المستخدمة بعد كل يوم كمكافأة."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нявыкарыстаныя лісце захоўваюцца пасля кожнага дня ў якасці ўзнагароды."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অব্যবহৃত পাতা প্রতি দিন পরে একটি পুরস্কার হিসাবে সংরক্ষণ করা হয়."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepoužité listy jsou po každém dni uloženy jako odměna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubrugte blade gemmes efter hver dag som belønning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungenutzte Blätter werden nach jedem Tag als Belohnung gesammelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unused leaves are saved after each day as a reward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las hojas no utilizadas se guardan después de cada día como recompensa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga hindi nagamit na dahon ay ini-save pagkatapos ng bawat araw bilang isang gantimpala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les feuilles inutilisées sont conservées chaque jour en guise de récompense."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ajiye ganyen da ba a yi amfani da su ba bayan kowace rana a matsayin lada."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עלים שאינם בשימוש נשמרים לאחר כל יום כפרס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अप्रयुक्त पत्तियों को प्रत्येक दिन के बाद पुरस्कार के रूप में सहेजा जाता है।"
