    "Applies to new pauses in apps and Safari.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new pauses in apps and Safari."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к новым паузам в приложениях и Safari."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Pausen in Apps und Safari."
          }
        }
      }
    },
    "Experimental: 3 pauses per day. Change their duration in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: 3 pauses per day. Change their duration in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эксперимент: 3 паузы в день. Длительность можно изменить в настройках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment: 3 Pausen pro Tag. Die Dauer lässt sich in den Einstellungen ändern."
          }
        }
      }
    },
    "Saved leaves": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved leaves"
