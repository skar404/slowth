        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Էկրանի ձայնագրումը թույլ է տալիս Slowth-ին ճանաչել կարճ տեսանյութեր և պատմություններ ձեր սարքում: Դուք ինքներդ սկսում եք այն:"
